+/**
+ * mtg-ai: a printing for each library card, which the server leaves out (names only): the same card seen elsewhere
+ * in the game (battlefield, graveyard, exile), else its number in the set the player's other cards come from
+ * (public/data/set-numbers.json: DSK and FDN, from engine/vocab). Without one the picture is looked up by name, one
+ * request per card, which Scryfall may refuse when a whole library asks at once.
+ */
+export type SetNumbers = Readonly<Record<string, Readonly<Record<string, string>>>>;
+
+export interface Printing {
+  expansionSetCode: string;
+  cardNumber: string;
+}
+
+export function libraryPrinting(name: string, seen: ReadonlyMap<string, Printing>, numbers: SetNumbers | null, set: string | null): Printing | null {
+  const known = seen.get(name);
+  if (known) return known;
+  const number = set ? numbers?.[set]?.[name] : undefined;
+  return set && number ? { expansionSetCode: set, cardNumber: number } : null;
+}
+
+/** The set most of these printings come from (the player's deck), if any. */
+export function mainSet(printings: Iterable<Printing>): string | null {
+  const counts = new Map<string, number>();
+  for (const p of printings) counts.set(p.expansionSetCode, (counts.get(p.expansionSetCode) ?? 0) + 1);
+  let best: string | null = null;
+  for (const [set, n] of counts) if (best === null || n > (counts.get(best) ?? 0)) best = set;
+  return best;
+}
+
+let numbersPromise: Promise<SetNumbers | null> | null = null;
+let numbers: SetNumbers | null = null;
+
+/** The set-number table, fetched once (null until it arrives, or if it can't be had). */
+export function setNumbers(): SetNumbers | null {
+  numbersPromise ??= fetch('/data/set-numbers.json')
+    .then((response) => (response.ok ? response.json() as Promise<SetNumbers> : null))
+    .catch(() => null)
+    .then((table) => (numbers = table));
+  return numbers;
+}
