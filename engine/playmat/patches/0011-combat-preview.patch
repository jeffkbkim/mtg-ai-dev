@@ -0,0 +1,110 @@
+/* mtg-ai: combat estimate: marks on the combatants, under the arrows; the panel sits above the decision corner */
+.layer {
+  position: absolute;
+  inset: 0;
+  z-index: var(--z-assign);
+  pointer-events: none;
+}
+
+.doomed {
+  position: absolute;
+  border-radius: 10px;
+  background: rgb(var(--oxblood-rgb) / 0.32);
+  box-shadow: inset 0 0 0 3px var(--oxblood-lit);
+}
+
+.mark {
+  position: absolute;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 10px 2px 6px;
+  transform: translate(-50%, -100%);
+  border-radius: var(--radius-chip);
+  font-family: var(--font-print);
+  font-size: 20px;
+  font-weight: 700;
+  letter-spacing: var(--tracking-print);
+  text-transform: uppercase;
+  white-space: nowrap;
+  box-shadow: var(--shadow-placed);
+}
+
+.top {
+  transform: translate(-50%, 0);
+}
+
+.dies {
+  background: var(--oxblood);
+  color: var(--oxblood-ink);
+}
+
+.survives {
+  background: rgb(var(--mat-rgb) / 0.85);
+  color: var(--sage);
+}
+
+.panel {
+  position: absolute;
+  /* left of the phase ladder, level with the top of the decision corner */
+  right: 200px;
+  bottom: 196px;
+  width: 400px;
+  padding: 10px 14px;
+  border-radius: 10px;
+  background: rgb(var(--mat-rgb) / 0.86);
+  box-shadow: inset 0 0 0 1px var(--ink-ghost), var(--shadow-placed);
+  color: var(--ink-soft);
+  font-size: 19px;
+  line-height: 1.3;
+}
+
+:global([data-layout='tall']) .panel {
+  right: 24px;
+  bottom: calc(340px + var(--hand-raise, 0px));
+}
+
+.title {
+  margin: 0 0 4px;
+  font-family: var(--font-print);
+  font-size: 20px;
+  font-weight: 700;
+  letter-spacing: var(--tracking-print);
+  text-transform: uppercase;
+  color: var(--ink-dim);
+}
+
+.rows {
+  margin: 0 0 6px;
+  padding: 0;
+  list-style: none;
+}
+
+.rows li + li {
+  margin-top: 3px;
+}
+
+.life {
+  margin: 0;
+  font-size: 24px;
+  font-weight: 700;
+  color: var(--ink-strong);
+}
+
+.gain {
+  margin: 2px 0 0;
+  color: var(--sage);
+}
+
+.warn {
+  margin: 4px 0 0;
+  color: var(--danger-text);
+  font-weight: 600;
+}
+
+.caveat {
+  margin: 6px 0 0;
+  font-size: 16px;
+  color: var(--ink-dim);
+  font-style: italic;
+}
diff --git a/Mage.Web.Client/src/app/match/CombatPreview.tsx b/Mage.Web.Client/src/app/match/CombatPreview.tsx
new file mode 100644
index 0000000000..4fb511b411
--- /dev/null
+++ b/Mage.Web.Client/src/app/match/CombatPreview.tsx
@@ -0,0 +1,108 @@
+import { Shield, Skull } from 'lucide-react';
+import { useMemo } from 'react';
+import { combatPreview, type CombatPreview as Preview, type Fighter, type PairPreview } from '../../core/game/combatPreview';
+import type { Interaction } from '../../core/game/interaction';
+import type { GameView } from '../../protocol/generated/views';
+import { useObjectBoxes } from './boardAnchors';
+import styles from './CombatPreview.module.css';
+
+/**
+ * mtg-ai: while you declare blockers, an estimate of how combat ends for the blocks as they stand (core/game/
+ * combatPreview.ts): each combatant marked dies or survives, and a small panel above the decision corner with the
+ * damage that gets through and your life after combat. While you declare attackers, the panel says what the attack
+ * deals if nothing blocks. Hidden at any other time.
+ */
+
+const MAX_ROWS = 6;
+
+function pt(fighter: Fighter): string {
+  return `${fighter.power}/${fighter.toughness - fighter.marked}`;
+}
+
+function names(fighters: readonly Fighter[]): string {
+  return fighters.map((fighter) => fighter.name).join(' + ');
+}
+
+function pairLine(pair: PairPreview, myId: string | undefined): string {
+  const { attacker, blockers, result } = pair;
+  const to = pair.defenderId === myId ? 'you' : pair.defenderName;
+  if (blockers.length === 0) return `${attacker.name} ${pt(attacker)} unblocked: ${result.toDefender} to ${to}`;
+  const dying = [...(result.attackerDies ? [attacker] : []), ...blockers.filter((blocker) => result.deadBlockers.includes(blocker.id))];
+  let outcome = dying.length === 0 ? 'no one dies'
+    : dying.length === blockers.length + 1 ? (blockers.length === 1 ? 'they trade' : 'all die')
+      : `${names(dying)} ${dying.length > 1 ? 'die' : 'dies'}`;
+  if (result.toDefender > 0) outcome += `, ${result.toDefender} tramples over to ${to}`;
+  return `${attacker.name} ${pt(attacker)} vs ${blockers.map((blocker) => `${blocker.name} ${pt(blocker)}`).join(' + ')}: ${outcome}`;
+}
+
+function lifeLine(preview: Preview, attacking: boolean): string[] {
+  return preview.defenders.map((defender) => {
+    const who = defender.isMe ? 'You' : defender.name;
+    if (!defender.isPlayer) return `${defender.damage} damage to ${defender.name}`;
+    const poison = defender.poison > 0 ? `, ${defender.poison} poison` : '';
+    if (defender.lifeAfter === null) return `${who} take${defender.isMe ? '' : 's'} ${defender.damage}${poison}`;
+    const goes = defender.isMe ? 'go' : 'goes';
+    const lethal = defender.lifeAfter <= 0 ? (defender.isMe ? ': lethal' : ': lethal!') : '';
+    return attacking && !defender.isMe
+      ? `If nothing blocks: ${defender.damage} damage, ${who} ${goes} to ${defender.lifeAfter}${poison}${lethal}`
+      : `${who} ${goes} to ${defender.lifeAfter}${poison}${lethal}`;
+  });
+}
+
+export function CombatPreview({ view, mode }: { view: GameView | null | undefined; mode: Interaction['mode'] }) {
+  const active = mode === 'declareBlockers' || mode === 'declareAttackers';
+  const preview = useMemo(() => (active ? combatPreview(view) : null), [active, view]);
+  const blocking = mode === 'declareBlockers';
+  // blocked attackers and their blockers: an unblocked attacker always survives combat, so it carries no mark
+  const fates = useMemo(() => new Map(blocking && preview
+    ? preview.pairs.filter((pair) => pair.blockers.length > 0)
+      .flatMap((pair) => [pair.attacker, ...pair.blockers].map((fighter) => [fighter.id, preview.fate.get(fighter.id)!] as const))
+    : []), [blocking, preview]);
+  const ids = useMemo(() => [...fates.keys()], [fates]);
+  const attackerIds = useMemo(() => new Set(preview?.pairs.map((pair) => pair.attacker.id)), [preview]);
+  const boxes = useObjectBoxes(ids);
+  if (!preview) return null;
+  const myId = view?.myPlayerId;
+  const rows = blocking ? preview.pairs.map((pair) => pairLine(pair, myId)) : [];
+  // the opponent's lifelink, said beside your life
+  const gains = [...preview.gains].filter(([id]) => blocking || id !== myId)
+    .map(([id, amount]) => `${id === myId ? 'You gain' : `${view?.players?.find((player) => player.playerId === id)?.name ?? 'They'} gains`} ${amount} (lifelink)`);
+
+  return (
+    <div className={styles.layer}>
+      {[...fates].map(([id, fate]) => {
+        const box = boxes.get(id);
+        if (!box) return null;
+        return (
+          <div key={id}>
+            {fate === 'dies' && <div className={styles.doomed} style={{ left: box.x, top: box.y, width: box.width, height: box.height }} />}
+            <span
+              // an attacker's mark on its top edge, clear of its blockers' marks
+              className={[styles.mark, fate === 'dies' ? styles.dies : styles.survives, attackerIds.has(id) ? styles.top : ''].join(' ')}
+              style={{ left: box.x + box.width / 2, top: attackerIds.has(id) ? box.y + 6 : box.y + box.height - 6 }}
+            >
+              {fate === 'dies' ? <Skull size={20} aria-hidden="true" /> : <Shield size={18} aria-hidden="true" />}
+              {fate === 'dies' ? 'Dies' : 'Survives'}
+            </span>
+          </div>
+        );
+      })}
+      <section className={styles.panel} aria-live="polite" aria-label="Combat estimate">
+        <h3 className={styles.title}>{blocking ? 'Combat estimate' : 'Attack estimate'}</h3>
+        {rows.length > 0 && (
+          <ul className={styles.rows}>
+            {rows.slice(0, MAX_ROWS).map((row, index) => <li key={index}>{row}</li>)}
+            {rows.length > MAX_ROWS && <li>and {rows.length - MAX_ROWS} more</li>}
+          </ul>
+        )}
+        {lifeLine(preview, !blocking).map((line, index) => <p key={index} className={styles.life}>{line}</p>)}
+        {gains.map((line, index) => <p key={index} className={styles.gain}>{line}</p>)}
+        {preview.notes.map((note, index) => <p key={index} className={styles.warn}>{note}</p>)}
+        <p className={styles.caveat}>
+          Estimate: ignores tricks and triggers.
+          {preview.assumedSplit && ' With several blockers, assumes the attacker kills as many as it can.'}
+        </p>
+      </section>
+    </div>
+  );
+}
