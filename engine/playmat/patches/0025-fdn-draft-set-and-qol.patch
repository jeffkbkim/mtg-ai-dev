@@ -43,3 +43,58 @@ export function isDskDraftDeck(deck: { format?: string | null; cards: readonly D
 export function isDskStarterFile(file: string): boolean {
   return file.startsWith('dsk-');
 }
+
+/**
+ * mtg-ai: the draft sets we have decks for: DSK (Duskmourn) and FDN (Foundations). A deck of one of them is in that
+ * set's "<SET> Draft (40)" list. Special Guests (SPG) ride along with either set; basics count for any.
+ */
+export const DRAFT_SETS = ['DSK', 'FDN'] as const;
+export type DraftSet = (typeof DRAFT_SETS)[number];
+const SPECIAL_GUESTS = 'SPG';
+
+export function draftLabel(set: DraftSet): string {
+  return `${set} Draft (${DSK_DRAFT_SIZE})`;
+}
+
+/** The one draft set every card is a printing of (basics and Special Guests aside), or null; an empty list is null. */
+export function draftSetOfCards(cards: readonly DeckCardInfo[]): DraftSet | null {
+  let found: DraftSet | null = null;
+  for (const card of cards) {
+    if (BASICS.has(card.cardName)) continue;
+    const code = (card.setCode ?? '').toUpperCase();
+    if (code === SPECIAL_GUESTS) continue;
+    if (!(DRAFT_SETS as readonly string[]).includes(code) || (found && found !== code)) return null;
+    found = code as DraftSet;
+  }
+  return found;
+}
+
+/** The draft set of a Freeform deck of 40+ main cards from one draft set, else null. */
+export function draftSetOfDeck(deck: { format?: string | null; cards: readonly DeckCardInfo[] }): DraftSet | null {
+  if (!playsAsFreeform(deck.format) || deck.cards.reduce((total, card) => total + card.amount, 0) < DSK_DRAFT_SIZE) return null;
+  return draftSetOfCards(deck.cards);
+}
+
+/** The builder's name for a Freeform deck of one draft set's cards so far; DSK for a new, empty deck. */
+export function builderDraftLabel(deck: { format?: string | null; cards: readonly DeckCardInfo[] }): string | null {
+  if (!playsAsFreeform(deck.format)) return null;
+  if (onlyDskCards(deck.cards)) return DSK_DRAFT_LABEL;
+  const set = draftSetOfCards(deck.cards);
+  return set ? draftLabel(set) : null;
+}
+
+/** The draft set of one of our starter files (dsk_starters.py: dsk-*.dck, fdn-*.dck), else null. */
+export function starterDraftSet(file: string): DraftSet | null {
+  return DRAFT_SETS.find((set) => file.startsWith(`${set.toLowerCase()}-`)) ?? null;
+}
+
+/** The draft set of a strengths.json entry (no file there, only its name: "fdn_08", "v2_03", "good_03", ...). */
+export function strengthDraftSet(entry: { file?: string; name?: string }): DraftSet | null {
+  if (entry.file) return starterDraftSet(entry.file);
+  return entry.name?.startsWith('fdn_') ? 'FDN' : null;
+}
+
+/** One of our good-pool starters (dsk-good-*, fdn-good-*; the unstarred ones are *-goodx-*). */
+export function isGoodStarterFile(file: string, set: DraftSet | null = null): boolean {
+  return (set ? [set] : DRAFT_SETS).some((s) => file.startsWith(`${s.toLowerCase()}-good-`));
+}
