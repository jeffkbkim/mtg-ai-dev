diff --git a/Mage.Web.Client/src/app/match/CardReveal.module.css b/Mage.Web.Client/src/app/match/CardReveal.module.css
new file mode 100644
index 0000000000..0ca49898b6
--- /dev/null
+++ b/Mage.Web.Client/src/app/match/CardReveal.module.css
@@ -0,0 +1,89 @@
+/* mtg-ai: a card shown large for a moment, then flown to where it went (CardReveal.tsx) */
+.layer {
+  position: absolute;
+  inset: 0;
+  z-index: var(--z-vfx);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 14px;
+  background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.38), rgb(0 0 0 / 0) 62%);
+  cursor: pointer;
+  animation: fade 160ms ease-out;
+}
+
+.leaving {
+  background: transparent;
+  transition: background 200ms;
+}
+
+.leaving .title,
+.leaving .caption,
+.leaving .more {
+  opacity: 0;
+  transition: opacity 120ms;
+}
+
+.title {
+  padding: 4px 16px;
+  border-radius: 999px;
+  background: rgb(var(--mat-rgb) / 0.9);
+  box-shadow: inset 0 0 0 1.5px var(--ink-faint);
+  color: var(--ink-strong);
+  font-family: var(--font-print);
+  font-size: 24px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.cards {
+  display: flex;
+  align-items: flex-start;
+  gap: 18px;
+}
+
+.slot {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+}
+
+.card {
+  width: 230px;
+  border-radius: 12px;
+  box-shadow: 0 18px 50px rgb(0 0 0 / 0.55);
+  animation: rise 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
+  animation-delay: calc(var(--i) * 45ms);
+}
+
+.caption {
+  color: var(--ink-strong);
+  font-size: 18px;
+  text-shadow: 0 1px 4px rgb(0 0 0 / 0.8);
+}
+
+.more {
+  align-self: center;
+  color: var(--ink-strong);
+  font-family: var(--font-print);
+  font-size: 30px;
+}
+
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(26px) scale(0.86);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+@keyframes fade {
+  from {
+    opacity: 0;
+  }
+}
diff --git a/Mage.Web.Client/src/app/match/CardReveal.tsx b/Mage.Web.Client/src/app/match/CardReveal.tsx
new file mode 100644
index 0000000000..6318e05bc8
--- /dev/null
+++ b/Mage.Web.Client/src/app/match/CardReveal.tsx
@@ -0,0 +1,199 @@
+import { useEffect, useRef, useState } from 'react';
+import { revealMoves, zoneMoves, zoneSnapshot, type ZoneMove, type ZoneSnapshot } from '../../core/game/zoneMoves';
+import type { GameView } from '../../protocol/generated/views';
+import { CardFace } from '../ui/CardFace';
+import { motionAllowed } from './flip';
+import { useStage } from './stageContext';
+import styles from './CardReveal.module.css';
+
+/**
+ * mtg-ai: a card that changes the board without passing through the stack shows large in the middle of the table
+ * for a moment, then flies to where it went: an opponent's land play, a token or card put onto the battlefield, a
+ * face-down card turned up, and any card put into a graveyard from play, a hand or a library (dies, sacrificed,
+ * discarded, milled). Spells were already shown on the stack. A click or any key skips it; with card motion off it
+ * doesn't play.
+ */
+
+/** How long a reveal holds before it flies; shorter while more are waiting. */
+const HOLD_MS = 650;
+const HOLD_BUSY_MS = 320;
+const FLY_MS = 380;
+/** At most this long for a card's picture to load before the hold starts anyway. */
+const IMAGE_WAIT_MS = 600;
+/** The most cards one reveal shows; the rest fly without being shown large. */
+const MAX_SHOWN = 6;
+
+interface Batch {
+  key: number;
+  moves: ZoneMove[];
+  names: Map<string, string>;
+  myPlayerId: string | null;
+}
+
+function caption(move: ZoneMove): string {
+  if (move.turnedUp) return 'turned face up';
+  if (move.to === 'battlefield') return (move.card.cardTypes ?? []).includes('LAND') ? 'land' : move.card.isToken ? 'token' : 'onto the battlefield';
+  if (move.from === 'battlefield') return (move.card.cardTypes ?? []).includes('CREATURE') ? 'dies' : 'to the graveyard';
+  if (move.from === 'hand') return 'discarded';
+  // a spell cast and resolved between two views never showed on the stack
+  if (move.from === 'unseen' && (move.card.cardTypes ?? []).some((type) => type === 'INSTANT' || type === 'SORCERY')) return 'cast';
+  if (move.from === 'exile') return 'from exile';
+  return 'to the graveyard';
+}
+
+function title(batch: Batch): string {
+  const owners = [...new Set(batch.moves.map((move) => move.playerId))];
+  const who = owners.length === 1 ? (owners[0] === batch.myPlayerId ? 'You' : batch.names.get(owners[0]) ?? 'Opponent') : 'Both players';
+  const entering = batch.moves.every((move) => move.to === 'battlefield');
+  if (entering) {
+    const lands = batch.moves.every((move) => (move.card.cardTypes ?? []).includes('LAND'));
+    return lands ? `${who} ${who === 'You' ? 'play' : 'plays'} a land` : `${who}: onto the battlefield`;
+  }
+  return batch.moves.every((move) => move.to === 'graveyard') ? `${who}: to the graveyard` : who;
+}
+
+/** Where a move's card ends up on the table: its permanent, or its owner's graveyard pile. */
+function targetOf(stage: HTMLElement | null, move: ZoneMove): Element | null {
+  if (!stage) return null;
+  if (move.to === 'battlefield') return stage.querySelector(`[data-object-id="${CSS.escape(move.id)}"]`);
+  return stage.querySelector(`[data-pile="graveyard:${CSS.escape(move.playerId)}"]`);
+}
+
+export function CardReveal({ view, myPlayerId }: { view: GameView | null; myPlayerId: string | null }) {
+  const stage = useStage();
+  const previous = useRef<ZoneSnapshot | null>(null);
+  const [queue, setQueue] = useState<Batch[]>([]);
+  const nextKey = useRef(0);
+
+  useEffect(() => {
+    if (!view) return;
+    const now = zoneSnapshot(view, myPlayerId);
+    const before = previous.current;
+    previous.current = now;
+    if (!before || before.places.size === 0 || !motionAllowed()) return;
+    const moves = revealMoves(zoneMoves(before, now), myPlayerId);
+    if (moves.length === 0) return;
+    const names = new Map((view.players ?? []).map((player) => [player.playerId ?? '', player.name ?? 'Opponent']));
+    const batch: Batch = { key: nextKey.current++, moves, names, myPlayerId };
+    // a long backlog (a board wipe and its triggers) keeps only the newest few
+    setQueue((current) => [...current, batch].slice(-4));
+  }, [view, myPlayerId]);
+
+  const current = queue[0];
+  const skip = () => setQueue([]);
+
+  useEffect(() => {
+    if (!current) return;
+    const onKey = () => skip();
+    window.addEventListener('keydown', onKey, true);
+    return () => window.removeEventListener('keydown', onKey, true);
+  }, [current]);
+
+  if (!current) return null;
+  return (
+    <RevealBatch
+      key={current.key}
+      batch={current}
+      busy={queue.length > 1}
+      stageElement={stage.element}
+      scale={stage.scale}
+      onDone={() => setQueue((list) => list.slice(1))}
+      onSkip={skip}
+    />
+  );
+}
+
+function RevealBatch({ batch, busy, stageElement, scale, onDone, onSkip }: {
+  batch: Batch;
+  busy: boolean;
+  stageElement: HTMLElement | null;
+  scale: number;
+  onDone(): void;
+  onSkip(): void;
+}) {
+  const shown = batch.moves.slice(0, MAX_SHOWN);
+  const cardRefs = useRef<(HTMLDivElement | null)[]>([]);
+  const layerRef = useRef<HTMLDivElement>(null);
+  const done = useRef(onDone);
+  done.current = onDone;
+
+  useEffect(() => {
+    // the permanents are already on the board: hidden until their card lands on them
+    const hidden: HTMLElement[] = [];
+    for (const move of shown) {
+      if (move.to !== 'battlefield') continue;
+      const element = targetOf(stageElement, move) as HTMLElement | null;
+      if (element) {
+        element.style.visibility = 'hidden';
+        hidden.push(element);
+      }
+    }
+    const restore = () => hidden.forEach((element) => (element.style.visibility = ''));
+    const holdMs = busy ? HOLD_BUSY_MS : HOLD_MS;
+    let hold: ReturnType<typeof setTimeout> | undefined;
+    let end: ReturnType<typeof setTimeout> | undefined;
+    // the hold counts from when the pictures are in (a card not seen before loads now), waiting at most a moment
+    const loaded = () => {
+      const images = [...(layerRef.current?.querySelectorAll('img') ?? [])];
+      return images.length > 0 && images.every((image) => image.complete && image.naturalWidth > 0);
+    };
+    const started = performance.now();
+    const run = () => {
+      hold = setTimeout(() => {
+        layerRef.current?.classList.add(styles.leaving);
+        shown.forEach((move, index) => {
+          const card = cardRefs.current[index];
+          const target = targetOf(stageElement, move);
+          if (!card) return;
+          const from = card.getBoundingClientRect();
+          const to = target?.getBoundingClientRect();
+          if (!to || to.width === 0) {
+            card.animate([{ opacity: 1 }, { opacity: 0 }], { duration: FLY_MS, fill: 'forwards' });
+            return;
+          }
+          const dx = (to.left + to.width / 2 - (from.left + from.width / 2)) / scale;
+          const dy = (to.top + to.height / 2 - (from.top + from.height / 2)) / scale;
+          const shrink = Math.max(0.2, Math.min(1, Math.max(to.width, to.height) / Math.max(from.width, from.height)));
+          card.animate(
+            [{ translate: '0 0', scale: '1', opacity: 1 }, { translate: `${dx}px ${dy}px`, scale: `${shrink}`, opacity: 0.9 }],
+            { duration: FLY_MS, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', fill: 'forwards' },
+          );
+        });
+      }, holdMs);
+      end = setTimeout(() => {
+        restore();
+        done.current();
+      }, holdMs + FLY_MS);
+    };
+    const wait = setInterval(() => {
+      if (!loaded() && performance.now() - started < IMAGE_WAIT_MS) return;
+      clearInterval(wait);
+      run();
+    }, 40);
+    return () => {
+      clearInterval(wait);
+      clearTimeout(hold);
+      clearTimeout(end);
+      restore();
+    };
+    // one batch, one run: the board updating underneath doesn't restart it
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  return (
+    <div ref={layerRef} className={styles.layer} onPointerDown={onSkip} role="status" aria-label={`${title(batch)}: ${batch.moves.map((move) => move.card.name).join(', ')}`}>
+      <div className={styles.title}>{title(batch)}</div>
+      <div className={styles.cards}>
+        {shown.map((move, index) => (
+          <div key={move.id} className={styles.slot}>
+            <div ref={(element) => { cardRefs.current[index] = element; }} className={styles.card} style={{ ['--i' as string]: index }}>
+              <CardFace card={move.card} size="normal" />
+            </div>
+            <span className={styles.caption}>{caption(move)}</span>
+          </div>
+        ))}
+        {batch.moves.length > MAX_SHOWN && <div className={styles.more}>+{batch.moves.length - MAX_SHOWN}</div>}
+      </div>
+    </div>
+  );
+}
