@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+import type { CardView, GameView } from '../../protocol/generated/views';
+import { activeConditions, conditionBoard } from './conditions';
+
+const grave = (...types: string[][]): Record<string, CardView> => Object.fromEntries(types.map((cardTypes, i) => [`g${i}`, { id: `g${i}`, cardTypes } as CardView]));
+const board = (graveyard: Record<string, CardView>, extra: Partial<GameView> = {}) => conditionBoard({ players: [{ playerId: 'me', graveyard }], activePlayerId: 'me', step: 'DECLARE_ATTACKERS', ...extra } as GameView);
+const delirious: CardView = { id: 'c', name: 'Fear of Exposure', rules: ['<i>Delirium</i> — As long as there are four or more card types among cards in your graveyard, it gets +2/+0.'] };
+
+describe('activeConditions', () => {
+  it('turns delirium on at four card types', () => {
+    expect(activeConditions(delirious, 'me', board(grave(['LAND'], ['CREATURE'], ['INSTANT'])))).toEqual([]);
+    const on = activeConditions(delirious, 'me', board(grave(['LAND'], ['CREATURE'], ['INSTANT'], ['ARTIFACT', 'CREATURE'])));
+    expect(on.map((c) => c.name)).toEqual(['Delirium']);
+    expect(on[0].detail).toContain('4 card types');
+  });
+
+  it('counts survival only while tapped on its controller\'s turn before the second main phase', () => {
+    const survivor = { id: 's', name: 'Survivor', rules: ['Survival — At the beginning of your second main phase, if this creature is tapped, draw a card.'], tapped: true } as CardView;
+    expect(activeConditions(survivor, 'me', board({})).map((c) => c.name)).toEqual(['Survival']);
+    expect(activeConditions(survivor, 'me', board({}, { step: 'POSTCOMBAT_MAIN' } as Partial<GameView>))).toEqual([]);
+    expect(activeConditions({ ...survivor, tapped: false } as CardView, 'me', board({}))).toEqual([]);
+  });
+});
diff --git a/Mage.Web.Client/src/core/game/conditions.ts b/Mage.Web.Client/src/core/game/conditions.ts
new file mode 100644
index 0000000000..0f9c3b3f51
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/conditions.ts
@@ -0,0 +1,67 @@
+import type { CardView, GameView, PermanentView } from '../../protocol/generated/views';
+import { roomDoors } from './cards';
+
+/**
+ * mtg-ai: a card's conditional ability that is on right now, Arena style: the card glows and names it. Read from the
+ * card's rules text and the public board (graveyards, tapped, whose turn and step), so it is a hint, not the rules
+ * engine's word: the engine still decides.
+ */
+export interface ActiveCondition {
+  name: string;
+  /** what makes it on, for the tooltip */
+  detail: string;
+}
+
+/** Card types that count for delirium. */
+const DELIRIUM_TYPES = ['ARTIFACT', 'BATTLE', 'CREATURE', 'ENCHANTMENT', 'INSTANT', 'KINDRED', 'TRIBAL', 'LAND', 'PLANESWALKER', 'SORCERY'];
+/** Survival checks at the beginning of your second main phase: until then, a tapped survivor is set to trigger. */
+const BEFORE_SECOND_MAIN = new Set(['PRECOMBAT_MAIN', 'BEGIN_COMBAT', 'DECLARE_ATTACKERS', 'DECLARE_BLOCKERS', 'FIRST_COMBAT_DAMAGE', 'COMBAT_DAMAGE', 'END_COMBAT']);
+
+export interface ConditionBoard {
+  /** per player: the card types in their graveyard (delirium), and how many cards it holds (threshold) */
+  graveyards: Map<string, { types: string[]; size: number }>;
+  activePlayerId: string | null;
+  step: string | null;
+  /** the viewer: the owner of the cards in their hand */
+  me: string | null;
+}
+
+export function conditionBoard(view: GameView | null | undefined): ConditionBoard {
+  const graveyards = new Map<string, { types: string[]; size: number }>();
+  for (const player of view?.players ?? []) {
+    const cards = Object.values(player.graveyard ?? {});
+    const types = new Set<string>();
+    for (const card of cards) for (const type of card.cardTypes ?? []) if (DELIRIUM_TYPES.includes(type)) types.add(String(type) === 'TRIBAL' ? 'KINDRED' : type);
+    graveyards.set(player.playerId ?? '', { types: [...types].sort(), size: cards.length });
+  }
+  return { graveyards, activePlayerId: view?.activePlayerId ?? null, step: view?.step ?? null, me: view?.myPlayerId ?? null };
+}
+
+function rulesText(card: CardView): string {
+  return (card.rules ?? []).join(' ').replace(/<[^>]*>/g, '');
+}
+
+const lower = (type: string) => type.toLowerCase();
+
+export function activeConditions(card: CardView | PermanentView, controllerId: string | null | undefined, board: ConditionBoard): ActiveCondition[] {
+  if (card.faceDown) return [];
+  const text = rulesText(card);
+  const found: ActiveCondition[] = [];
+  const owner = controllerId ?? board.me;
+  const graveyard = owner ? board.graveyards.get(owner) : undefined;
+  if (/\bDelirium\b/.test(text) && graveyard && graveyard.types.length >= 4) {
+    found.push({ name: 'Delirium', detail: `Delirium is on: ${graveyard.types.length} card types in the graveyard (${graveyard.types.map(lower).join(', ')})` });
+  }
+  if (/\bThreshold\b/.test(text) && graveyard && graveyard.size >= 7) {
+    found.push({ name: 'Threshold', detail: `Threshold is on: ${graveyard.size} cards in the graveyard` });
+  }
+  const permanent = card as PermanentView;
+  if (/\bSurvival\b/.test(text) && permanent.tapped && owner === board.activePlayerId && board.step && BEFORE_SECOND_MAIN.has(board.step)) {
+    found.push({ name: 'Survival', detail: 'Survival will trigger: tapped at the beginning of your second main phase' });
+  }
+  const doors = 'roomLeftDoor' in permanent || 'roomRightDoor' in permanent ? roomDoors(permanent) : null;
+  if (doors && doors.every((door) => door.unlocked)) {
+    found.push({ name: 'Unlocked', detail: 'Both doors are unlocked: this Room is fully unlocked' });
+  }
+  return found;
+}
diff --git a/Mage.Web.Client/src/core/game/gameLog.ts b/Mage.Web.Client/src/core/game/gameLog.ts
