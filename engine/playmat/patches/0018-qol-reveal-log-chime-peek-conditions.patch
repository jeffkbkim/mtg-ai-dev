@@ -203,6 +203,8 @@ const ICON_RULES: [RegExp, LogIcon][] = [
   [/\b(deals?|gets?|dealt) \d+ damage\b|\bdamage\b/i, 'damage'],
   [/\bdraws?\b/i, 'draw'],
   [/\bdiscards?\b/i, 'discard'],
+  // mtg-ai: milled (and other cards put from a library into a graveyard)
+  [/ from library into (their|its owner's) graveyard\b/i, 'discard'],
   [/\b(destroyed|dies|sacrificed|sacrifices|put into (a |their |its owner's )?graveyard)\b/i, 'destroy'],
   [/\bexiles?d?\b/i, 'exile'],
   [/\btrigger(s|ed)?\b/i, 'trigger'],
@@ -336,3 +338,17 @@ export function presenceChange(text: string): { name: string; online: boolean }
   const online = /^(.+?) has joined$/.exec(text);
   return online ? { name: online[1], online: true } : null;
 }
+
+/**
+ * mtg-ai: lines the compact log leaves out because another line already says it: a land "put from hand onto the
+ * Battlefield" after "plays", a spell "put from stack onto the Battlefield" after "casts", skipped steps, and your
+ * own "draws a card", which the client's "You drew …" line names.
+ */
+export function isLogNoise(entry: LogEntry, myName: string | null): boolean {
+  if (entry.tone !== 'game') return false;
+  const text = entry.text;
+  if (/ puts .+ from (hand|stack) onto the Battlefield$/.test(text)) return true;
+  if (/ skips (Untap|Upkeep|Draw) step$/.test(text)) return true;
+  if (myName && text.startsWith(`${myName} draws `) && /draws (a card|\d+ cards|two cards|three cards)$/.test(text)) return true;
+  return false;
+}
diff --git a/Mage.Web.Client/src/core/game/zoneMoves.test.ts b/Mage.Web.Client/src/core/game/zoneMoves.test.ts
new file mode 100644
index 0000000000..d9fd5423a9
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/zoneMoves.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from 'vitest';
+import type { CardView, GameView } from '../../protocol/generated/views';
+import { drawnCards, revealMoves, zoneMoves, zoneSnapshot } from './zoneMoves';
+
+const card = (id: string, name: string, extra: Partial<CardView> = {}): CardView => ({ id, name, ...extra });
+
+function view({ me = {}, opp = {}, hand = {}, stack = {} }: {
+  me?: { battlefield?: Record<string, CardView>; graveyard?: Record<string, CardView>; library?: number; hand?: number };
+  opp?: { battlefield?: Record<string, CardView>; graveyard?: Record<string, CardView>; library?: number; hand?: number };
+  hand?: Record<string, CardView>;
+  stack?: Record<string, CardView>;
+}): GameView {
+  return {
+    myHand: hand,
+    stack,
+    players: [
+      { playerId: 'me', battlefield: me.battlefield ?? {}, graveyard: me.graveyard ?? {}, libraryCount: me.library ?? 30, handCount: me.hand ?? 0 },
+      { playerId: 'opp', battlefield: opp.battlefield ?? {}, graveyard: opp.graveyard ?? {}, libraryCount: opp.library ?? 30, handCount: opp.hand ?? 5 },
+    ],
+  } as GameView;
+}
+
+const moves = (a: GameView, b: GameView) => {
+  const before = zoneSnapshot(a, 'me');
+  const now = zoneSnapshot(b, 'me');
+  return { before, now, moves: zoneMoves(before, now) };
+};
+
+describe('zoneMoves', () => {
+  it("reveals an opponent's land play but not their resolved spell", () => {
+    const forest = card('f1', 'Forest');
+    const bear = card('b1', 'Bear', { controllerId: 'opp' });
+    const { moves: land } = moves(view({}), view({ opp: { battlefield: { f1: forest }, hand: 4 } }));
+    expect(revealMoves(land, 'me').map((move) => move.card.name)).toEqual(['Forest']);
+    const { moves: spell } = moves(view({ stack: { s1: { ...bear, cardId: 'b1' } } }), view({ opp: { battlefield: { b1: bear } } }));
+    expect(revealMoves(spell, 'me')).toEqual([]);
+  });
+
+  it('reveals a face-down permanent turned face up, but not one entering face down', () => {
+    const down = card('m1', 'Manifest', { faceDown: true });
+    const up = card('m1', 'Hauntwoods Shrieker');
+    const { moves: enter } = moves(view({}), view({ opp: { battlefield: { m1: down } } }));
+    expect(revealMoves(enter, 'me')).toEqual([]);
+    const { moves: flip } = moves(view({ opp: { battlefield: { m1: down } } }), view({ opp: { battlefield: { m1: up } } }));
+    expect(revealMoves(flip, 'me').map((move) => [move.card.name, move.turnedUp])).toEqual([['Hauntwoods Shrieker', true]]);
+  });
+
+  it('reveals creatures dying on either side, not instants resolving or tokens', () => {
+    const bear = card('b1', 'Bear');
+    const shock = card('x1', 'Shock');
+    const token = card('t1', 'Glimmer', { isToken: true });
+    const { moves: died } = moves(
+      view({ me: { battlefield: { b1: bear } }, opp: { battlefield: { t1: token } }, stack: { s9: { ...shock, cardId: 'x1' } } }),
+      view({ me: { graveyard: { b1: bear, x1: shock } } }),
+    );
+    expect(revealMoves(died, 'me').map((move) => move.card.name)).toEqual(['Bear']);
+  });
+
+  it('names the cards I drew', () => {
+    const drawn = card('d1', 'Drawn');
+    const { moves: drew } = moves(view({}), view({ hand: { d1: drawn } }));
+    expect(drawnCards(drew, 'me').map((c) => c.name)).toEqual(['Drawn']);
+  });
+});
diff --git a/Mage.Web.Client/src/core/game/zoneMoves.ts b/Mage.Web.Client/src/core/game/zoneMoves.ts
new file mode 100644
index 0000000000..c56529e9a4
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/zoneMoves.ts
@@ -0,0 +1,99 @@
+import type { CardView, GameView } from '../../protocol/generated/views';
+
+/**
+ * mtg-ai: cards moving between zones, from the difference between two game views: for the log's "You drew" line (the
+ * server only says "draws a card") and for the reveal of cards that reach the battlefield or a graveyard without
+ * passing through the stack.
+ *
+ * Only what the viewer may see: their own hand, and public zones. A card that comes out of a zone the viewer can't
+ * see (a library, an opponent's hand) comes "from" `unseen`.
+ */
+
+export type Zone = 'hand' | 'stack' | 'battlefield' | 'graveyard' | 'exile' | 'unseen';
+
+export interface ZoneMove {
+  id: string;
+  card: CardView;
+  /** whose zone the card is in now (the controller on the battlefield, the owner elsewhere) */
+  playerId: string;
+  from: Zone;
+  to: Exclude<Zone, 'unseen' | 'stack'>;
+  /** a face-down permanent turned face up (from and to are both the battlefield) */
+  turnedUp?: boolean;
+}
+
+interface Place {
+  zone: Zone;
+  playerId: string;
+  card: CardView;
+}
+
+export interface ZoneSnapshot {
+  places: Map<string, Place>;
+}
+
+export function zoneSnapshot(view: GameView | null | undefined, myPlayerId: string | null): ZoneSnapshot {
+  const places = new Map<string, Place>();
+  if (!view) return { places };
+  const put = (id: string | undefined, zone: Zone, playerId: string, card: CardView) => {
+    if (id && !places.has(id)) places.set(id, { zone, playerId, card });
+  };
+  for (const [id, card] of Object.entries(view.stack ?? {})) {
+    const owner = card.controllerId ?? card.ownerId ?? '';
+    // a spell's stack id isn't its card's id: keep both, so the card is known to have come from the stack
+    put(id, 'stack', owner, card);
+    put(card.cardId, 'stack', owner, card);
+    put(card.id, 'stack', owner, card);
+  }
+  for (const player of view.players ?? []) {
+    const playerId = player.playerId ?? '';
+    for (const [id, card] of Object.entries(player.battlefield ?? {})) put(id, 'battlefield', playerId, card);
+    for (const [id, card] of Object.entries(player.graveyard ?? {})) put(id, 'graveyard', playerId, card);
+    for (const [id, card] of Object.entries(player.exile ?? {})) put(id, 'exile', playerId, card);
+  }
+  for (const zone of view.exiles ?? []) {
+    for (const [id, card] of Object.entries(zone ?? {})) put(id, 'exile', card.ownerId ?? '', card);
+  }
+  if (myPlayerId) {
+    for (const [id, card] of Object.entries(view.myHand ?? {})) put(id, 'hand', myPlayerId, card);
+  }
+  return { places };
+}
+
+/** The moves from one snapshot to the next. Tokens leaving play and cards going out of sight are not moves. */
+export function zoneMoves(before: ZoneSnapshot, now: ZoneSnapshot): ZoneMove[] {
+  const moves: ZoneMove[] = [];
+  for (const [id, place] of now.places) {
+    if (place.zone === 'stack' || place.zone === 'unseen') continue;
+    const was = before.places.get(id);
+    if (was?.zone === place.zone) {
+      if (place.zone === 'battlefield' && was.card.faceDown && !place.card.faceDown) {
+        moves.push({ id, card: place.card, playerId: place.playerId, from: 'battlefield', to: 'battlefield', turnedUp: true });
+      }
+      continue;
+    }
+    moves.push({ id, card: place.card, playerId: place.playerId, from: was?.zone ?? 'unseen', to: place.zone });
+  }
+  return moves;
+}
+
+/** Cards the viewer drew (or otherwise put into their hand from out of sight). */
+export function drawnCards(moves: readonly ZoneMove[], myPlayerId: string | null): CardView[] {
+  if (!myPlayerId) return [];
+  return moves.filter((move) => move.to === 'hand' && move.from === 'unseen' && move.playerId === myPlayerId).map((move) => move.card);
+}
+
+/**
+ * Cards worth showing large for a moment: an opponent's card reaching the battlefield without passing through the
+ * stack (a land, a token, a card put onto the battlefield, a face-down card turned up), and any card reaching a
+ * graveyard from the battlefield, a hand or a library (dies, sacrificed, discarded, milled). Spells resolving were
+ * already shown on the stack; face-down cards show nothing worth reading.
+ */
+export function revealMoves(moves: readonly ZoneMove[], myPlayerId: string | null): ZoneMove[] {
+  return moves.filter((move) => {
+    if (move.card.faceDown) return false;
+    if (move.to === 'battlefield') return move.playerId !== myPlayerId && (move.turnedUp || move.from !== 'stack');
+    if (move.to === 'graveyard') return move.from !== 'stack' && !move.card.isToken;
+    return false;
+  });
+}
