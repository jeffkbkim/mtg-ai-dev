+/** mtg-ai: untapped first, then tapped, each in arrival order. */
+export function splitOpenFirst(members: PermanentView[]): PermanentView[] {
+  return [...members.filter((member) => !member.tapped), ...members.filter((member) => member.tapped)];
+}
+
+/** mtg-ai: a stack's badge: "×4", or for a land pile with any tapped "3 / 4 open"; null for a single card. */
+export function stackBadge(group: PermanentGroup): string | null {
+  const total = group.members.length;
+  if (total < 2) return null;
+  const open = group.members.filter((member) => !member.tapped).length;
+  return isLand(group.lead) && open < total ? `${open} / ${total} open` : `×${total}`;
+}
