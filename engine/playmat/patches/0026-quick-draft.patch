+package mage.server.career;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import mage.cards.Card;
+import mage.cards.ExpansionSet;
+import mage.cards.Sets;
+import mage.cards.decks.DeckCardInfo;
+import mage.cards.decks.DeckCardLists;
+import org.apache.log4j.Logger;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.StandardOpenOption;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * mtg-ai: Quick Draft, like MTG Arena's. You and seven bots draft three packs of a set; each bot seat picks with its own
+ * "brain" (statistical-drafting, DraftFM, 17lands win rates or XMage's ratings) from the draft-brain service
+ * (play/draft_brain in mtg-ai, -Dmtgai.draftBrainPort, default 17190), and builds its deck there too. Then you play Bo1
+ * games against the bots' decks, piloted by the Claude AI or the Playmat AI, until seven wins or three losses.
+ *
+ * No Career profile, coins or collection: a run is a folder under the draft directory (-Dmtgai.draftDir, default
+ * ~/mtg-data/playmat-drafts), <date>/<run id>/, holding run.json (the whole run), picks.jsonl (every pick of every seat:
+ * the pack before the pick, the card taken, the seat's brain and its scores), decks.json (the eight decks) and
+ * games.jsonl (each game's opponent and result). active/<user> names a player's run in progress. When the brain service
+ * doesn't answer, a bot picks and builds like Career Limited's bots, and the pick log says so.
+ */
+public final class QuickDraft {
+
+    private static final Logger logger = Logger.getLogger(QuickDraft.class);
+    private static final Gson gson = new Gson();
+    private static final Gson pretty = new GsonBuilder().setPrettyPrinting().create();
+    public static final int WINS = 7;
+    public static final int LOSSES = 3;
+    public static final List<String> SETS = Arrays.asList("DSK", "FDN");
+    public static final String DEFAULT_BRAIN = "statdraft";
+
+    private static volatile QuickDraft instance;
+
+    private final Path root;
+    private final int brainPort;
+    /** quick draft tables in play: table id -> run, to count the result when the match ends */
+    private final Map<UUID, Seated> tables = new ConcurrentHashMap<>();
+
+    private static class Seated {
+        String user;
+        String runId;
+        int seat;
+    }
+
+    // ---- state
+
+    /** the whole run, kept as run.json */
+    static class Run {
+        String id;
+        String user;
+        String setCode;
+        String setName;
+        /** "draft", "build", "play", or how it ended: "won", "lost", "abandoned" */
+        String phase;
+        long started;
+        long ended;
+        String dir;
+        /** each bot seat's brain, seats 1-7 (index 0 is the player and unused) */
+        List<String> brains = new ArrayList<>();
+        /** who pilots the bots' decks: "claude" or "mad" (the Playmat AI) */
+        String pilot = "claude";
+        /** the Claude seat's model and effort, as the client encodes them (aiSetup.claudeSkill) */
+        int claudeSkill = 1;
+        int wins;
+        int losses;
+        List<CareerLimited.CareerPoolCard> pool = new ArrayList<>();
+        List<DeckCardInfo> deck;
+        CareerLimited.Draft draft;
+        /** the seat-0 pack at each pick of the current round, for what wheeled */
+        Map<Integer, List<String>> seen = new LinkedHashMap<>();
+        /** the player's pick at each pick of the current round */
+        Map<Integer, String> mine = new LinkedHashMap<>();
+        List<CareerLimited.PickRecord> picks = new ArrayList<>();
+        Map<String, Double> passed = new LinkedHashMap<>();
+        /** the bots' decks, seats 1-7 */
+        List<QuickDraftBot> opponents = new ArrayList<>();
+        List<QuickDraftGame> games = new ArrayList<>();
+        /** the table of the game being played, if any */
+        String tableId;
+    }
+
+    public static class QuickDraftBot {
+        public int seat;
+        public String name;
+        public String brain;
+        public String colors;
+        /** "brain" when the service built it, "fallback" when Career's builder did */
+        public String builtBy;
+        public List<CareerLimited.CareerPoolCard> cards = new ArrayList<>();
+    }
+
+    public static class QuickDraftGame {
+        public int number;
+        public String tableId;
+        public int seat;
+        public String opponent;
+        public String brain;
+        public String colors;
+        public String pilot;
+        public boolean won;
+        public int turns;
+        public long ended;
+    }
+
+    // ---- views
+
+    public static class QuickDraftRun extends CareerLimited.CareerLimitedRun {
+        public List<String> brains;
+        public String pilot;
+        public int claudeSkill;
+        /** cards in the pack now that were in it when it last came to you: they went all the way round */
+        public List<String> wheeled;
+        /** cards that were in the pack when it last came to you and were taken since (yours excepted) */
+        public List<String> takenSince;
+        public List<QuickDraftGame> games;
+        /** the next opponent: its seat, brain and colours */
+        public QuickDraftBot next;
+        public long started;
+    }
+
+    public static class QuickDraftBrain {
+        public String name;
+        public String label;
+    }
+
+    public static class QuickDraftState {
+        public QuickDraftRun run;
+        public List<QuickDraftRun> recent = new ArrayList<>();
+        public List<QuickDraftBrain> brains = new ArrayList<>();
+        public String defaultBrain = DEFAULT_BRAIN;
+        public List<String> sets = SETS;
+        /** whether the draft-brain service answered; without it every bot uses the fallback */
+        public boolean brainService;
+    }
+
+    public static class QuickDraftException extends Exception {
+        public QuickDraftException(String message) {
+            super(message);
+        }
+    }
+
+    private QuickDraft() {
+        String dir = System.getProperty("mtgai.draftDir");
+        root = dir != null && !dir.isEmpty() ? Paths.get(dir) : Paths.get(System.getProperty("user.home"), "mtg-data", "playmat-drafts");
+        brainPort = Integer.getInteger("mtgai.draftBrainPort", 17190);
+    }
+
+    public static QuickDraft get() {
+        QuickDraft current = instance;
+        if (current == null) {
+            synchronized (QuickDraft.class) {
+                current = instance;
+                if (current == null) {
+                    current = new QuickDraft();
+                    instance = current;
+                }
+            }
+        }
+        return current;
+    }
+
+    // ---- storage
+
+    private Path activeFile(String user) {
+        return root.resolve("active").resolve(safe(user));
+    }
+
+    private static String safe(String user) {
+        return user.replaceAll("[^A-Za-z0-9._-]", "_");
+    }
+
+    private synchronized Run active(String user) {
+        try {
+            Path file = activeFile(user);
+            if (!Files.exists(file)) {
+                return null;
+            }
+            Path dir = root.resolve(new String(Files.readAllBytes(file), StandardCharsets.UTF_8).trim());
+            Run run = gson.fromJson(new String(Files.readAllBytes(dir.resolve("run.json")), StandardCharsets.UTF_8), Run.class);
+            return run != null && isOpen(run) ? run : null;
+        } catch (IOException | RuntimeException e) {
+            logger.warn("Quick draft: can't read " + user + "'s run: " + e.getMessage());
+            return null;
+        }
+    }
+
+    private static boolean isOpen(Run run) {
+        return "draft".equals(run.phase) || "build".equals(run.phase) || "play".equals(run.phase);
+    }
+
+    private synchronized void save(Run run) {
+        try {
+            Path dir = root.resolve(run.dir);
+            Files.createDirectories(dir);
+            Path tmp = dir.resolve("run.json.tmp");
+            Files.write(tmp, pretty.toJson(run).getBytes(StandardCharsets.UTF_8));
+            Files.move(tmp, dir.resolve("run.json"), java.nio.file.StandardCopyOption.REPLACE_EXISTING, java.nio.file.StandardCopyOption.ATOMIC_MOVE);
+            Path active = activeFile(run.user);
+            Files.createDirectories(active.getParent());
+            if (isOpen(run)) {
+                Files.write(active, run.dir.getBytes(StandardCharsets.UTF_8));
+            } else {
+                Files.deleteIfExists(active);
+            }
+        } catch (IOException e) {
+            logger.error("Quick draft: can't save run " + run.id, e);
+        }
+    }
+
+    private void append(Run run, String file, Object line) {
+        try {
+            Path dir = root.resolve(run.dir);
+            Files.createDirectories(dir);
+            Files.write(dir.resolve(file), (gson.toJson(line) + "\n").getBytes(StandardCharsets.UTF_8),
+                    StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+        } catch (IOException e) {
+            logger.error("Quick draft: can't write " + file + " of run " + run.id, e);
+        }
+    }
+
+    private List<Run> recent(String user) {
+        List<Run> runs = new ArrayList<>();
+        try (java.util.stream.Stream<Path> dates = Files.exists(root) ? Files.list(root) : java.util.stream.Stream.empty()) {
+            List<Path> days = new ArrayList<>();
+            dates.filter(p -> p.getFileName().toString().matches("\\d{4}-\\d{2}-\\d{2}")).forEach(days::add);
+            days.sort(Collections.reverseOrder());
+            for (Path day : days) {
+                try (java.util.stream.Stream<Path> ids = Files.list(day)) {
+                    for (Path dir : (Iterable<Path>) ids::iterator) {
+                        Path file = dir.resolve("run.json");
+                        if (!Files.exists(file)) {
+                            continue;
+                        }
+                        Run run = gson.fromJson(new String(Files.readAllBytes(file), StandardCharsets.UTF_8), Run.class);
+                        if (run != null && user.equals(run.user) && !isOpen(run)) {
+                            runs.add(run);
+                        }
+                    }
+                }
+                if (runs.size() >= 10) {
+                    break;
+                }
+            }
+        } catch (IOException | RuntimeException e) {
+            logger.warn("Quick draft: can't list runs: " + e.getMessage());
+        }
+        runs.sort((a, b) -> Long.compare(b.started, a.started));
+        return runs.size() > 10 ? runs.subList(0, 10) : runs;
+    }
+
+    // ---- the brain service
+
+    /** one request to the brain service: the answer's JSON, or null when it isn't there or fails */
+    private String http(String method, String path, String body, int timeoutMs) {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL("http://127.0.0.1:" + brainPort + path).openConnection();
+            connection.setRequestMethod(method);
+            connection.setConnectTimeout(2000);
+            connection.setReadTimeout(timeoutMs);
+            if (body != null) {
+                connection.setDoOutput(true);
+                connection.setRequestProperty("Content-Type", "application/json");
+                try (OutputStream out = connection.getOutputStream()) {
+                    out.write(body.getBytes(StandardCharsets.UTF_8));
+                }
+            }
+            int status = connection.getResponseCode();
+            try (InputStream in = status == 200 ? connection.getInputStream() : connection.getErrorStream()) {
+                ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+                byte[] buffer = new byte[8192];
+                for (int n; in != null && (n = in.read(buffer)) > 0; ) {
+                    bytes.write(buffer, 0, n);
+                }
+                String text = new String(bytes.toByteArray(), StandardCharsets.UTF_8);
+                if (status != 200) {
+                    logger.warn("Quick draft: brain " + path + " answered " + status + ": " + text);
+                    return null;
+                }
+                return text;
+            }
+        } catch (IOException | RuntimeException e) {
+            logger.warn("Quick draft: brain service unreachable (" + path + "): " + e.getMessage());
+            return null;
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    private JsonObject callBrain(String path, JsonObject body) {
+        String text = http("POST", path, body.toString(), path.equals("/build") ? 10000 : 3000);
+        try {
+            return text == null ? null : new JsonParser().parse(text).getAsJsonObject();
+        } catch (RuntimeException e) {
+            logger.warn("Quick draft: brain " + path + " answered something unreadable: " + e.getMessage());
+            return null;
+        }
+    }
+
+    public List<QuickDraftBrain> brains() {
+        List<QuickDraftBrain> out = new ArrayList<>();
+        String text = http("GET", "/brains", null, 2000);
+        if (text == null) {
+            return out;
+        }
+        try {
+            for (JsonElement element : new JsonParser().parse(text).getAsJsonObject().getAsJsonArray("brains")) {
+                QuickDraftBrain brain = new QuickDraftBrain();
+                brain.name = element.getAsJsonObject().get("name").getAsString();
+                brain.label = element.getAsJsonObject().get("label").getAsString();
+                out.add(brain);
+            }
+        } catch (RuntimeException e) {
+            logger.warn("Quick draft: brain list unreadable: " + e.getMessage());
+        }
+        return out;
+    }
+
+    private static JsonArray names(List<CareerLimited.CareerPoolCard> cards) {
+        JsonArray array = new JsonArray();
+        for (CareerLimited.CareerPoolCard card : cards) {
+            array.add(card.name);
+        }
+        return array;
+    }
+
+    private static List<String> nameList(List<CareerLimited.CareerPoolCard> cards) {
+        List<String> list = new ArrayList<>();
+        for (CareerLimited.CareerPoolCard card : cards) {
+            list.add(card.name);
+        }
+        return list;
+    }
+
+    /** a bot's pick: the index into its pack, from its brain or, failing that, Career's bot */
+    private int botPick(Run run, int seat, List<CareerLimited.CareerPoolCard> pack, List<CareerLimited.CareerPoolCard> pool, Map<String, Object> log) {
+        String brain = run.brains.get(seat);
+        log.put("brain", brain);
+        if (!"xmage".equals(brain)) {
+            JsonObject body = new JsonObject();
+            body.addProperty("set", run.setCode);
+            body.addProperty("brain", brain);
+            body.add("pack", names(pack));
+            body.add("pool", names(pool));
+            body.addProperty("pack_number", run.draft.round - 1);
+            body.addProperty("pick_number", run.draft.pick - 1);
+            JsonObject answer = callBrain("/pick", body);
+            if (answer != null && answer.has("pick") && !answer.get("pick").isJsonNull()) {
+                String name = answer.get("pick").getAsString();
+                for (int i = 0; i < pack.size(); i++) {
+                    if (pack.get(i).name.equals(name)) {
+                        log.put("source", "brain");
+                        if (answer.has("scores")) {
+                            log.put("scores", gson.fromJson(answer.get("scores"), List.class));
+                        }
+                        return i;
+                    }
+                }
+            }
+            log.put("source", answer == null ? "fallback:unreachable" : "fallback:no-pick");
+        } else {
+            log.put("source", "xmage");
+        }
+        return CareerLimited.get().botPick(pack, pool);
+    }
+
+    private QuickDraftBot botDeck(Run run, int seat, List<CareerLimited.CareerPoolCard> pool) {
+        QuickDraftBot deck = new QuickDraftBot();
+        deck.seat = seat;
+        deck.brain = run.brains.get(seat);
+        deck.name = "Bot " + seat;
+        JsonObject body = new JsonObject();
+        body.addProperty("set", run.setCode);
+        body.add("pool", names(pool));
+        JsonObject answer = "xmage".equals(deck.brain) ? null : callBrain("/build", body);
+        if (answer != null && answer.has("main")) {
+            List<CareerLimited.CareerPoolCard> left = new ArrayList<>(pool);
+            for (JsonElement element : answer.getAsJsonArray("main")) {
+                String name = element.getAsString();
+                for (int i = 0; i < left.size(); i++) {
+                    if (left.get(i).name.equals(name)) {
+                        deck.cards.add(left.remove(i));
+                        break;
+                    }
+                }
+            }
+            for (Map.Entry<String, JsonElement> land : answer.getAsJsonObject("lands").entrySet()) {
+                char color = "Plains".equals(land.getKey()) ? 'W' : "Island".equals(land.getKey()) ? 'U' : "Swamp".equals(land.getKey()) ? 'B'
+                        : "Mountain".equals(land.getKey()) ? 'R' : 'G';
+                for (int n = 0; n < land.getValue().getAsInt(); n++) {
+                    deck.cards.add(CareerLimited.basic(color));
+                }
+            }
+            deck.colors = answer.has("colors") ? answer.get("colors").getAsString() : CareerLimited.mainColors(pool);
+            deck.builtBy = "brain";
+        }
+        if (deck.cards.size() < CareerLimited.DECK_SIZE) {
+            deck.cards = CareerLimited.build(pool);
+            deck.colors = CareerLimited.mainColors(pool);
+            deck.builtBy = "fallback";
+        }
+        return deck;
+    }
+
+    // ---- the run
+
+    public QuickDraftState state(String user) {
+        QuickDraftState state = new QuickDraftState();
+        state.brains = brains();
+        state.brainService = !state.brains.isEmpty();
+        Run run = active(user);
+        state.run = run == null ? null : view(run);
+        for (Run done : recent(user)) {
+            QuickDraftRun view = view(done);
+            view.pool = null;
+            view.deck = null;
+            view.picks = null;
+            state.recent.add(view);
+        }
+        return state;
+    }
+
+    public QuickDraftRun start(String user, String setCode, List<String> brains, String pilot, int claudeSkill) throws QuickDraftException {
+        if (active(user) != null) {
+            throw new QuickDraftException("You have a quick draft going already: finish or abandon it first.");
+        }
+        String code = setCode == null ? "" : setCode.toUpperCase();
+        ExpansionSet set = Sets.findSet(code);
+        if (!SETS.contains(code) || set == null) {
+            throw new QuickDraftException("Quick draft offers " + String.join(" and ", SETS) + ".");
+        }
+        Run run = new Run();
+        run.id = UUID.randomUUID().toString();
+        run.user = user;
+        run.setCode = code;
+        run.setName = set.getName();
+        run.started = System.currentTimeMillis();
+        run.dir = LocalDate.now() + "/" + run.id;
+        run.pilot = "mad".equals(pilot) ? "mad" : "claude";
+        run.claudeSkill = Math.max(1, claudeSkill);
+        run.brains.add("");
+        for (int seat = 1; seat < CareerLimited.SEATS; seat++) {
+            String brain = brains == null || brains.isEmpty() ? DEFAULT_BRAIN : brains.get(Math.min(seat - 1, brains.size() - 1));
+            run.brains.add(brain == null || brain.isEmpty() ? DEFAULT_BRAIN : brain);
+        }
+        run.draft = newDraft(code);
+        if (run.draft.packs.get(0).isEmpty()) {
+            throw new QuickDraftException(run.setName + " has no boosters on this server.");
+        }
+        run.phase = "draft";
+        noteSeen(run);
+        save(run);
+        logger.info("Quick draft: " + user + " started " + code + " (" + run.id + "), bots " + run.brains.subList(1, run.brains.size()) + ", pilot " + run.pilot);
+        return view(run);
+    }
+
+    private static CareerLimited.Draft newDraft(String setCode) {
+        CareerLimited.Draft draft = new CareerLimited.Draft();
+        for (int seat = 0; seat < CareerLimited.SEATS; seat++) {
+            draft.packs.add(booster(setCode));
+            draft.pools.add(new ArrayList<>());
+        }
+        return draft;
+    }
+
+    private static List<CareerLimited.CareerPoolCard> booster(String setCode) {
+        List<CareerLimited.CareerPoolCard> pack = new ArrayList<>();
+        ExpansionSet set = Sets.findSet(setCode);
+        if (set != null) {
+            for (Card card : set.createBooster()) {
+                pack.add(CareerLimited.poolCard(card));
+            }
+        }
+        return pack;
+    }
+
+    private static void noteSeen(Run run) {
+        if (run.draft != null) {
+            run.seen.put(run.draft.pick, nameList(run.draft.packs.get(0)));
+        }
+    }
+
+    public synchronized QuickDraftRun pick(String user, int index) throws QuickDraftException {
+        Run run = active(user);
+        if (run == null) {
+            throw new QuickDraftException("You have no quick draft going.");
+        }
+        if (!"draft".equals(run.phase) || run.draft == null) {
+            throw new QuickDraftException("The draft is over.");
+        }
+        CareerLimited.Draft draft = run.draft;
+        List<CareerLimited.CareerPoolCard> mine = draft.packs.get(0);
+        if (index < 0 || index >= mine.size()) {
+            throw new QuickDraftException("That card isn't in the pack.");
+        }
+        long now = System.currentTimeMillis();
+        CareerLimited.notePassed(run.passed, mine, draft.pick);
+        run.picks.add(CareerLimited.grade(mine, index, draft.pools.get(0), draft.round, draft.pick));
+        append(run, "picks.jsonl", pickLine(run, 0, "human:" + user, mine, index, draft.pools.get(0), null, now));
+        run.mine.put(draft.pick, mine.get(index).name);
+        draft.pools.get(0).add(mine.remove(index));
+        for (int seat = 1; seat < CareerLimited.SEATS; seat++) {
+            List<CareerLimited.CareerPoolCard> pack = draft.packs.get(seat);
+            if (pack.isEmpty()) {
+                continue;
+            }
+            Map<String, Object> log = new LinkedHashMap<>();
+            int taken = botPick(run, seat, pack, draft.pools.get(seat), log);
+            append(run, "picks.jsonl", pickLine(run, seat, "bot", pack, taken, draft.pools.get(seat), log, now));
+            draft.pools.get(seat).add(pack.remove(taken));
+        }
+        // packs pass left, right, left
+        Collections.rotate(draft.packs, draft.round % 2 == 1 ? 1 : -1);
+        draft.pick++;
+        if (draft.packs.get(0).isEmpty()) {
+            if (draft.round < CareerLimited.DRAFT_PACKS) {
+                draft.round++;
+                draft.pick = 1;
+                run.seen.clear();
+                run.mine.clear();
+                for (int seat = 0; seat < CareerLimited.SEATS; seat++) {
+                    draft.packs.set(seat, booster(run.setCode));
+                }
+            } else {
+                finishDraft(run);
+            }
+        }
+        if ("draft".equals(run.phase)) {
+            noteSeen(run);
+        }
+        save(run);
+        return view(run);
+    }
+
+    private Map<String, Object> pickLine(Run run, int seat, String who, List<CareerLimited.CareerPoolCard> pack, int index,
+                                         List<CareerLimited.CareerPoolCard> pool, Map<String, Object> bot, long now) {
+        Map<String, Object> line = new LinkedHashMap<>();
+        line.put("run", run.id);
+        line.put("set", run.setCode);
+        line.put("pack", run.draft.round);
+        line.put("pick", run.draft.pick);
+        line.put("seat", seat);
+        line.put("who", who);
+        List<String> printings = new ArrayList<>();
+        for (CareerLimited.CareerPoolCard card : pack) {
+            printings.add(card.setCode + ":" + card.cardNumber);
+        }
+        line.put("cards", nameList(pack));
+        line.put("printings", printings);
+        line.put("picked", pack.get(index).name);
+        line.put("pool", nameList(pool));
+        if (bot != null) {
+            line.putAll(bot);
+        }
+        line.put("ts", now);
+        return line;
+    }
+
+    private void finishDraft(Run run) {
+        run.pool = run.draft.pools.get(0);
+        Map<String, Object> decks = new LinkedHashMap<>();
+        for (int seat = 1; seat < CareerLimited.SEATS; seat++) {
+            QuickDraftBot deck = botDeck(run, seat, run.draft.pools.get(seat));
+            run.opponents.add(deck);
+            Map<String, Object> entry = new LinkedHashMap<>();
+            entry.put("brain", deck.brain);
+            entry.put("built_by", deck.builtBy);
+            entry.put("colors", deck.colors);
+            entry.put("deck", nameList(deck.cards));
+            entry.put("pool", nameList(run.draft.pools.get(seat)));
+            decks.put("seat" + seat, entry);
+        }
+        Map<String, Object> human = new LinkedHashMap<>();
+        human.put("who", "human:" + run.user);
+        human.put("pool", nameList(run.pool));
+        decks.put("seat0", human);
+        try {
+            Files.write(root.resolve(run.dir).resolve("decks.json"), pretty.toJson(decks).getBytes(StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            logger.error("Quick draft: can't write decks of run " + run.id, e);
+        }
+        run.draft = null;
+        run.seen.clear();
+        run.phase = "build";
+    }
+
+    public CareerLimited.CareerLimitedCoach coach(String user) throws QuickDraftException {
+        Run run = active(user);
+        if (run == null) {
+            throw new QuickDraftException("You have no quick draft going.");
+        }
+        if ("draft".equals(run.phase)) {
+            throw new QuickDraftException("Finish the draft first.");
+        }
+        return CareerLimited.coach(run.pool);
+    }
+
+    public synchronized QuickDraftRun submitDeck(String user, DeckCardLists deck) throws QuickDraftException {
+        Run run = active(user);
+        if (run == null) {
+            throw new QuickDraftException("You have no quick draft going.");
+        }
+        if ("draft".equals(run.phase)) {
+            throw new QuickDraftException("Finish the draft first.");
+        }
+        int size = deck.getCards().stream().mapToInt(DeckCardInfo::getAmount).sum();
+        if (size < CareerLimited.DECK_SIZE) {
+            throw new QuickDraftException("A limited deck needs at least " + CareerLimited.DECK_SIZE + " cards; this one has " + size + ".");
+        }
+        Map<String, Integer> available = new LinkedHashMap<>();
+        for (CareerLimited.CareerPoolCard card : run.pool) {
+            available.merge(card.name, 1, Integer::sum);
+        }
+        Map<String, Integer> used = new LinkedHashMap<>();
+        for (DeckCardInfo card : deck.getCards()) {
+            if (!CareerService.isBasic(card.getCardName())) {
+                used.merge(card.getCardName(), card.getAmount(), Integer::sum);
+            }
+        }
+        for (Map.Entry<String, Integer> entry : used.entrySet()) {
+            int have = available.getOrDefault(entry.getKey(), 0);
+            if (entry.getValue() > have) {
+                throw new QuickDraftException(entry.getKey() + ": " + entry.getValue() + " in the deck, " + have + " in your pool.");
+            }
+        }
+        run.deck = new ArrayList<>(deck.getCards());
+        run.phase = "play";
+        Map<String, Object> line = new LinkedHashMap<>();
+        line.put("event", "deck");
+        line.put("games_played", run.wins + run.losses);
+        List<String> cards = new ArrayList<>();
+        for (DeckCardInfo card : run.deck) {
+            for (int n = 0; n < card.getAmount(); n++) {
+                cards.add(card.getCardName());
+            }
+        }
+        line.put("deck", cards);
+        line.put("ts", System.currentTimeMillis());
+        append(run, "games.jsonl", line);
+        save(run);
+        return view(run);
+    }
+
+    public synchronized QuickDraftRun setPilot(String user, String pilot, int claudeSkill) throws QuickDraftException {
+        Run run = active(user);
+        if (run == null) {
+            throw new QuickDraftException("You have no quick draft going.");
+        }
+        run.pilot = "mad".equals(pilot) ? "mad" : "claude";
+        run.claudeSkill = Math.max(1, claudeSkill);
+        save(run);
+        return view(run);
+    }
+
+    public synchronized QuickDraftRun abandon(String user) throws QuickDraftException {
+        Run run = active(user);
+        if (run == null) {
+            throw new QuickDraftException("You have no quick draft going.");
+        }
+        run.phase = "abandoned";
+        run.ended = System.currentTimeMillis();
+        save(run);
+        return view(run);
+    }
+
+    /** What the next game needs. */
+    public static class Plan {
+        public String runId;
+        public int seat;
+        public String opponentName;
+        public String pilot;
+        public int claudeSkill;
+        public DeckCardLists playerDeck;
+        public DeckCardLists opponentDeck;
+    }
+
+    public Plan plan(String user) throws QuickDraftException {
+        Run run = active(user);
+        if (run == null) {
+            throw new QuickDraftException("You have no quick draft going.");
+        }
+        if (!"play".equals(run.phase) || run.deck == null) {
+            throw new QuickDraftException("Build your deck first.");
+        }
+        QuickDraftBot bot = nextOpponent(run);
+        Plan plan = new Plan();
+        plan.runId = run.id;
+        plan.seat = bot.seat;
+        plan.pilot = run.pilot;
+        plan.claudeSkill = run.claudeSkill;
+        plan.opponentName = ("claude".equals(run.pilot) ? "Claude" : "Bot") + " " + bot.seat + " " + (bot.colors == null ? "" : bot.colors);
+        plan.playerDeck = new DeckCardLists();
+        plan.playerDeck.setName(run.setCode + " quick draft");
+        for (DeckCardInfo card : run.deck) {
+            plan.playerDeck.getCards().add(CareerLimited.withPrinting(card));
+        }
+        plan.opponentDeck = new DeckCardLists();
+        plan.opponentDeck.setName("Bot " + bot.seat + " (" + bot.brain + ")");
+        Map<String, Integer> counts = new LinkedHashMap<>();
+        Map<String, CareerLimited.CareerPoolCard> byKey = new LinkedHashMap<>();
+        for (CareerLimited.CareerPoolCard card : bot.cards) {
+            String key = card.name + "|" + card.setCode + "|" + card.cardNumber;
+            counts.merge(key, 1, Integer::sum);
+            byKey.put(key, card);
+        }
+        for (Map.Entry<String, Integer> entry : counts.entrySet()) {
+            CareerLimited.CareerPoolCard card = byKey.get(entry.getKey());
+            plan.opponentDeck.getCards().add(CareerLimited.withPrinting(new DeckCardInfo(card.name, card.cardNumber, card.setCode, entry.getValue())));
+        }
+        return plan;
+    }
+
+    /** the pod in order, round and round: game n meets seat (n mod 7) + 1 */
+    private static QuickDraftBot nextOpponent(Run run) {
+        return run.opponents.get((run.wins + run.losses) % run.opponents.size());
+    }
+
+    public void register(UUID tableId, String user, String runId, int seat) {
+        Seated seated = new Seated();
+        seated.user = user;
+        seated.runId = runId;
+        seated.seat = seat;
+        tables.put(tableId, seated);
+        Run run = active(user);
+        if (run != null && run.id.equals(runId)) {
+            synchronized (this) {
+                run.tableId = tableId.toString();
+                save(run);
+            }
+        }
+    }
+
+    /**
+     * A quick draft table's link to its run ("user|run id|seat"), kept with the table's save so a game carried on at
+     * a new table (a take-back, a kept game resumed) still counts for the run; null for other tables.
+     */
+    public String linkOf(UUID tableId) {
+        Seated seated = tableId == null ? null : tables.get(tableId);
+        return seated == null ? null : seated.user + "|" + seated.runId + "|" + seated.seat;
+    }
+
+    /** the table no longer plays for its run (its game carries on at another table): its end counts for nothing */
+    public void forget(UUID tableId) {
+        if (tableId != null && tables.remove(tableId) != null) {
+            logger.info("Quick draft: table " + tableId + " carries on elsewhere; its end won't count");
+        }
+    }
+
+    /** a new table carries on a quick draft game (linkOf of the old one): its result counts for the run */
+    public void adopt(UUID tableId, String link) {
+        String[] parts = link == null ? new String[0] : link.split("\\|");
+        if (tableId == null || parts.length != 3) {
+            return;
+        }
+        try {
+            register(tableId, parts[0], parts[1], Integer.parseInt(parts[2]));
+            logger.info("Quick draft: table " + tableId + " carries on run " + parts[1] + "'s game");
+        } catch (NumberFormatException e) {
+            logger.warn("Quick draft: bad table link " + link);
+        }
+    }
+
+    public boolean isQuickDraftTable(UUID tableId) {
+        return tables.containsKey(tableId);
+    }
+
+    /** a quick draft match ended (TableController): count it, and end the run at seven wins or three losses */
+    public synchronized void matchEnded(UUID tableId, boolean won, int turns) {
+        Seated seated = tables.remove(tableId);
+        if (seated == null) {
+            return;
+        }
+        Run run = active(seated.user);
+        if (run == null || !run.id.equals(seated.runId) || !"play".equals(run.phase)) {
+            return;
+        }
+        QuickDraftBot bot = run.opponents.get(seated.seat - 1);
+        QuickDraftGame result = new QuickDraftGame();
+        result.number = run.wins + run.losses + 1;
+        result.tableId = tableId.toString();
+        result.seat = seated.seat;
+        result.opponent = bot.name;
+        result.brain = bot.brain;
+        result.colors = bot.colors;
+        result.pilot = run.pilot;
+        result.won = won;
+        result.turns = turns;
+        result.ended = System.currentTimeMillis();
+        run.games.add(result);
+        if (won) {
+            run.wins++;
+        } else {
+            run.losses++;
+        }
+        run.tableId = null;
+        Map<String, Object> line = new LinkedHashMap<>();
+        line.put("event", "game");
+        line.put("number", result.number);
+        line.put("tableId", result.tableId);
+        line.put("seat", result.seat);
+        line.put("opponent", result.opponent);
+        line.put("brain", result.brain);
+        line.put("colors", result.colors);
+        line.put("pilot", result.pilot);
+        line.put("won", result.won);
+        line.put("turns", result.turns);
+        line.put("ended", result.ended);
+        line.put("record", run.wins + "-" + run.losses);
+        append(run, "games.jsonl", line);
+        if (run.wins >= WINS || run.losses >= LOSSES) {
+            run.phase = run.wins >= WINS ? "won" : "lost";
+            run.ended = result.ended;
+        }
+        save(run);
+        logger.info("Quick draft: " + seated.user + (won ? " beat " : " lost to ") + bot.name + " (" + bot.brain + "), " + run.wins + "-" + run.losses);
+    }
+
+    private QuickDraftRun view(Run run) {
+        QuickDraftRun view = new QuickDraftRun();
+        view.id = run.id;
+        view.kind = CareerLimited.DRAFT;
+        view.shape = CareerLimited.ARENA;
+        view.maxWins = WINS;
+        view.maxLosses = LOSSES;
+        view.setCode = run.setCode;
+        view.setName = run.setName;
+        view.phase = run.phase;
+        view.state = isOpen(run) ? "active" : run.phase;
+        view.wins = run.wins;
+        view.losses = run.losses;
+        view.pool = run.pool;
+        view.deck = run.deck;
+        view.picks = run.picks;
+        view.signals = CareerLimited.signals(run.passed);
+        view.brains = run.brains.subList(1, run.brains.size());
+        view.pilot = run.pilot;
+        view.claudeSkill = run.claudeSkill;
+        view.games = run.games;
+        view.started = run.started;
+        if (run.draft != null && "draft".equals(run.phase)) {
+            view.pack = run.draft.packs.get(0);
+            view.pool = run.draft.pools.get(0);
+            view.round = run.draft.round;
+            view.pick = run.draft.pick;
+            List<String> before = run.seen.get(run.draft.pick - CareerLimited.SEATS);
+            if (before != null) {
+                List<String> now = nameList(view.pack);
+                view.wheeled = new ArrayList<>();
+                view.takenSince = new ArrayList<>();
+                List<String> left = new ArrayList<>(now);
+                for (String name : before) {
+                    if (left.remove(name)) {
+                        view.wheeled.add(name);
+                    } else {
+                        view.takenSince.add(name);
+                    }
+                }
+                // your own pick from it is not news
+                view.takenSince.remove(run.mine.get(run.draft.pick - CareerLimited.SEATS));
+            }
+        }
+        if ("play".equals(run.phase) && !run.opponents.isEmpty()) {
+            QuickDraftBot next = nextOpponent(run);
+            QuickDraftBot summary = new QuickDraftBot();
+            summary.seat = next.seat;
+            summary.name = next.name;
+            summary.brain = next.brain;
+            summary.colors = next.colors;
+            summary.builtBy = next.builtBy;
+            view.next = summary;
+        }
+        return view;
+    }
+
+}
