+import { useQuery } from '@tanstack/react-query';
+import type { QuickDraftRun, QuickDraftState } from '../../protocol/generated/views';
+import { warmMatch } from '../career/careerData';
+import { api } from '../connection';
+import { queryClient } from '../queries';
+import { useEvents } from '../stores/events';
+import { usePlay } from '../stores/play';
+
+/** mtg-ai: Quick Draft's server state (QuickDraftApi): the run in progress, recent runs and the bot brains on offer. */
+
+const KEY = ['quickDraft'] as const;
+
+export function useQuickDraft() {
+  return useQuery({ queryKey: KEY, queryFn: () => api.quickDraft(), staleTime: 0 });
+}
+
+function setRun(run: QuickDraftRun): void {
+  queryClient.setQueryData<QuickDraftState>(KEY, (state) => ({ ...(state ?? {}), run: run.state === 'active' ? run : undefined }));
+  if (run.state !== 'active') void queryClient.invalidateQueries({ queryKey: KEY });
+}
+
+export async function startQuickDraft(setCode: string, brains: string[], pilot: string, claudeSkill: number): Promise<void> {
+  setRun(await api.quickDraftStart(setCode, brains, pilot, claudeSkill));
+}
+
+export async function pickQuickDraft(index: number): Promise<QuickDraftRun> {
+  const run = await api.quickDraftPick(index);
+  setRun(run);
+  return run;
+}
+
+export async function submitQuickDraftDeck(deck: Parameters<typeof api.quickDraftDeck>[0]): Promise<void> {
+  setRun(await api.quickDraftDeck(deck));
+}
+
+export async function setQuickDraftPilot(pilot: string, claudeSkill: number): Promise<void> {
+  setRun(await api.quickDraftPilot(pilot, claudeSkill));
+}
+
+export async function abandonQuickDraft(): Promise<void> {
+  setRun(await api.quickDraftAbandon());
+}
+
+/** The run's next game: the server sets the table up; the game opens like any other and leaving it comes back here. */
+export async function playQuickDraft(): Promise<void> {
+  useEvents.setState({ currentTournamentId: null });
+  usePlay.setState({ phase: 'waitingForGame', error: null, deckId: null, returnPath: '/quickdraft' });
+  try {
+    const match = await api.quickDraftPlay();
+    warmMatch(match);
+    usePlay.setState({ tableId: match?.tableId ?? null, returnPath: '/quickdraft' });
+  } catch (error) {
+    usePlay.setState({ phase: 'idle', tableId: null });
+    throw error;
+  } finally {
+    // the result is counted when the match ends; come back to a fresh record
+    void queryClient.invalidateQueries({ queryKey: KEY });
+  }
+}
