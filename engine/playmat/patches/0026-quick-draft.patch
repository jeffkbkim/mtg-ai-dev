@@ -0,0 +1,74 @@
+import { useEffect, useRef, useState, type MouseEvent as ReactMouseEvent, type PointerEvent as ReactPointerEvent } from 'react';
+
+/**
+ * mtg-ai: a card shown large while the pointer is over its tile or list row (Quick Draft), beside it and never over
+ * the deck list. A Room, printed sideways, is turned upright (CardZoom.tsx). On a touch screen a long press shows it
+ * and the next tap anywhere closes it.
+ */
+
+export interface ZoomCardInfo {
+  name?: string;
+  setCode?: string;
+  cardNumber?: string;
+}
+
+export interface Shown {
+  card: ZoomCardInfo;
+  left: number;
+  right: number;
+  top: number;
+}
+
+const LONG_PRESS_MS = 450;
+
+/** Zoom state and the handlers to spread on each hoverable element. */
+export function useCardZoom() {
+  const [shown, setShown] = useState<Shown | null>(null);
+  const press = useRef<ReturnType<typeof setTimeout> | null>(null);
+  // a long press shows the card: the click that ends it must not also add the card to the deck
+  const swallowClick = useRef(false);
+
+  useEffect(() => {
+    if (!shown) return;
+    // a touch-opened zoom closes on the next tap; a mouse one when the pointer leaves
+    const close = () => setShown(null);
+    window.addEventListener('pointerdown', close, true);
+    return () => window.removeEventListener('pointerdown', close, true);
+  }, [shown]);
+
