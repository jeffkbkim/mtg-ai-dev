index 0000000000..b2f7422e77
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/pool.ts
@@ -0,0 +1,120 @@
+import type { CareerPoolCard } from '../../protocol/generated/views';
+import type { RoomDoors } from './rooms';
+
+/**
+ * mtg-ai: Quick Draft's picks laid out in columns, like Arena's pool: by mana value (0 to 6+), lands, and a Sideboard
+ * column for what's left out of the deck. The player rearranges them by dragging; the layout is kept in this browser
+ * per run (by each pick's place in the pool, which never changes), from the first pick to the deck builder.
+ */
+
+export const COLOR_ORDER = 'WUBRG';
+export const SIDEBOARD = 'Sideboard';
+export const COLUMN_LABELS = ['0', '1', '2', '3', '4', '5', '6+', 'Lands', SIDEBOARD];
+export const BASIC_NAMES = ['plains', 'island', 'swamp', 'mountain', 'forest'];
+
+export interface Column {
+  label: string;
+  /** places in the pool, top of the stack first */
+  items: number[];
+}
+
+export const lower = (card: CareerPoolCard) => (card.name ?? '').toLowerCase();
+
+export function colorRank(card: CareerPoolCard): number {
+  const colors = card.colors ?? '';
+  if (colors.length === 0) return 6;
+  if (colors.length > 1) return 5;
+  return COLOR_ORDER.indexOf(colors);
+}
+
+export function layoutKey(runId: string): string {
+  return `playmat.quickDraft.layout.${runId}`;
+}
+
+type Doors = ReadonlyMap<string, RoomDoors> | undefined;
+
+/** the mana value a card is sorted and counted at: a Room's cheaper door (rooms.ts), else its own */
+export function sortValue(card: CareerPoolCard, doors?: Doors): number {
+  return doors?.get(lower(card))?.cheap ?? card.manaValue ?? 0;
+}
+
+function valueColumn(value: number): string {
+  return COLUMN_LABELS[Math.min(6, Math.max(0, value))];
+}
+
+/** the column a card starts in: its mana value (a Room's cheaper door), lands last */
+export function columnOf(card: CareerPoolCard, doors?: Doors): string {
+  return card.land ? 'Lands' : valueColumn(sortValue(card, doors));
+}
+
+/**
+ * Rooms that sit in the column of their combined mana value, where the first version of this screen put them, moved
+ * to their cheaper door's column: the layout to save once, or null when there's nothing to move.
+ */
+export function roomsResorted(pool: readonly CareerPoolCard[], columns: readonly Column[], doors: Doors): Column[] | null {
+  if (!doors?.size) return null;
+  let next: Column[] | null = null;
+  for (const column of columns) {
+    for (const at of column.items) {
+      const card = pool[at];
+      const room = doors.get(lower(card));
+      if (!room || card.land) continue;
+      const combined = valueColumn(card.manaValue ?? 0);
+      const cheap = valueColumn(room.cheap);
+      if (column.label === combined && cheap !== combined) {
+        next = placeIn(next ?? columns, at, cheap, (next ?? columns).find((candidate) => candidate.label === cheap)!.items.length);
+      }
+    }
+  }
+  return next;
+}
+
+/** The pool in columns: where the player put each card, the rest in their mana value's column in colour order. */
+export function arrange(pool: readonly CareerPoolCard[], arranged: Record<string, number[]>, doors?: Doors): Column[] {
+  const placed = new Set<number>();
+  const columns: Record<string, number[]> = Object.fromEntries(COLUMN_LABELS.map((label) => [label, []]));
+  for (const [label, items] of Object.entries(arranged)) {
+    if (!columns[label] || !Array.isArray(items)) continue;
+    for (const at of items) {
+      if (Number.isInteger(at) && at >= 0 && at < pool.length && !placed.has(at)) {
+        columns[label].push(at);
+        placed.add(at);
+      }
+    }
+  }
+  const fresh = pool.map((_, at) => at).filter((at) => !placed.has(at))
+    .sort((a, b) => colorRank(pool[a]) - colorRank(pool[b]) || (pool[a].name ?? '').localeCompare(pool[b].name ?? ''));
+  for (const at of fresh) columns[columnOf(pool[at], doors)].push(at);
+  return COLUMN_LABELS.map((label) => ({ label, items: columns[label] }));
+}
+
+/** the columns with one card moved to a place in another (or the same) column */
+export function placeIn(columns: readonly Column[], at: number, label: string, position: number): Column[] {
+  const next = columns.map((column) => ({ label: column.label, items: column.items.filter((item) => item !== at) }));
+  const target = next.find((column) => column.label === label);
+  if (!target) return next;
+  target.items.splice(Math.max(0, Math.min(position, target.items.length)), 0, at);
+  return next;
+}
+
+/** a Room (two doors on one card) is printed sideways */
+export function isRoomCard(card: { name?: string; setCode?: string }): boolean {
+  return (card.name ?? '').includes(' // ') && card.setCode === 'DSK';
+}
+
+/** the deck's numbers, as Arena shows them: spells by mana value, colours, creatures and lands */
+export function deckStats(cards: readonly CareerPoolCard[], basics = 0, doors?: Doors) {
+  const spells = cards.filter((card) => !card.land);
+  const curve = [0, 0, 0, 0, 0, 0, 0];
+  for (const card of spells) curve[Math.min(6, Math.max(0, sortValue(card, doors)))]++;
+  const colors = COLOR_ORDER.split('').map((color) => ({ color, count: spells.filter((card) => (card.colors ?? '').includes(color)).length }))
+    .filter((entry) => entry.count > 0);
+  return {
+    curve,
+    colors,
+    spells: spells.length,
+    creatures: spells.filter((card) => card.creature).length,
+    lands: cards.length - spells.length + basics,
+    average: spells.length ? spells.reduce((sum, card) => sum + sortValue(card, doors), 0) / spells.length : 0,
+  };
+}
