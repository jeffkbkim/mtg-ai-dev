+      event.preventDefault();
+    },
+    onContextMenu: (event: ReactMouseEvent) => {
+      if (swallowClick.current) event.preventDefault(); // no copy/share menu over the long press
+    },
+  });
+
+  return { shown, handlers, hide: () => setShown(null) };
+}
