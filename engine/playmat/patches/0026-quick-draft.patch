diff --git a/Mage.Server/src/main/java/mage/server/websocket/api/QuickDraftApi.java b/Mage.Server/src/main/java/mage/server/websocket/api/QuickDraftApi.java
new file mode 100644
index 0000000000..5922b8e674
--- /dev/null
+++ b/Mage.Server/src/main/java/mage/server/websocket/api/QuickDraftApi.java
@@ -0,0 +1,129 @@
+package mage.server.websocket.api;
+
+import mage.cards.decks.DeckCardLists;
+import mage.players.PlayerType;
+import mage.server.career.CareerLimited;
+import mage.server.career.QuickDraft;
+import mage.server.websocket.rpc.RpcCall;
+import mage.server.websocket.rpc.RpcException;
+import mage.server.websocket.rpc.RpcMethod;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import static mage.server.websocket.rpc.RpcParam.Type.ARRAY;
+import static mage.server.websocket.rpc.RpcParam.Type.INT;
+import static mage.server.websocket.rpc.RpcParam.Type.STRING;
+import static mage.server.websocket.rpc.RpcParam.object;
+import static mage.server.websocket.rpc.RpcParam.of;
+import static mage.server.websocket.rpc.RpcParam.optional;
+
+/**
+ * mtg-ai: Quick Draft (QuickDraft.java): draft a set against seven bots with swappable pick brains, build, then play
+ * Bo1 games against the bots' decks until seven wins or three losses. Open to any signed-in player; no Career needed.
+ */
+final class QuickDraftApi {
+
+    private QuickDraftApi() {
+    }
+
+    interface Work<T> {
+        T run() throws QuickDraft.QuickDraftException;
+    }
+
+    private static <T> T refusing(Work<T> work) throws RpcException {
+        try {
+            return work.run();
+        } catch (QuickDraft.QuickDraftException e) {
+            throw RpcException.invalidParams(e.getMessage());
+        }
+    }
+
+    static List<RpcMethod> methods(ApiContext ctx) {
+        return Arrays.asList(
+                RpcMethod.named("quickDraft")
+                        .returns("QuickDraftState")
+                        .doc("Quick draft: the run in progress, recent runs, the bot brains on offer and whether the brain service is up.")
+                        .handler(call -> QuickDraft.get().state(CareerApi.user(ctx, call))),
+                RpcMethod.named("quickDraftStart")
+                        .params(of("setCode", STRING), optional("brains", ARRAY).typed("string[]"), optional("pilot", STRING), optional("claudeSkill", INT))
+                        .returns("QuickDraftRun")
+                        .doc("Start a quick draft of a set (DSK or FDN) with seven bots. Brains: one per bot seat (or one for all), "
+                                + "from quickDraft's list; missing seats take the default. Pilot: who plays the bots' decks, "
+                                + "claude (the Claude AI, with claudeSkill as the opponent picker encodes it) or mad (the Playmat AI).")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            List<String> brains = new ArrayList<>();
+                            if (call.has(1)) {
+                                for (com.google.gson.JsonElement brain : call.jsonArray(1)) {
+                                    brains.add(brain.getAsString());
+                                }
+                            }
+                            String pilot = call.has(2) ? call.string(2) : "claude";
+                            int skill = call.has(3) ? call.integer(3) : 1;
+                            String setCode = call.string(0);
+                            return refusing(() -> QuickDraft.get().start(user, setCode, brains, pilot, skill));
+                        }),
+                RpcMethod.named("quickDraftPick")
+                        .params(of("index", INT))
+                        .returns("QuickDraftRun")
+                        .doc("Take the card at this position of the pack in front of you; the bots take theirs and the packs pass.")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            int index = call.integer(0);
+                            return refusing(() -> QuickDraft.get().pick(user, index));
+                        }),
+                RpcMethod.named("quickDraftCoach")
+                        .returns("CareerLimitedCoach")
+                        .doc("Every colour pair of the drafted pool ranked, each with a 40-card build to start from.")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            return refusing(() -> QuickDraft.get().coach(user));
+                        }),
+                RpcMethod.named("quickDraftDeck")
+                        .params(object("deck", "DeckCardLists"))
+                        .returns("QuickDraftRun")
+                        .doc("Submit the run's deck: at least 40 cards from the pool, plus any basic lands.")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            DeckCardLists deck = call.object(0, DeckCardLists.class);
+                            return refusing(() -> QuickDraft.get().submitDeck(user, deck));
+                        }),
+                RpcMethod.named("quickDraftPilot")
+                        .params(of("pilot", STRING), optional("claudeSkill", INT))
+                        .returns("QuickDraftRun")
+                        .doc("Change who plays the bots' decks from the next game on: claude or mad.")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            String pilot = call.string(0);
+                            int skill = call.has(1) ? call.integer(1) : 1;
+                            return refusing(() -> QuickDraft.get().setPilot(user, pilot, skill));
+                        }),
+                RpcMethod.named("quickDraftPlay")
+                        .returns("CareerMatch")
+                        .doc("Play the run's next game, Bo1, against the next bot's deck.")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            QuickDraft.Plan plan = refusing(() -> QuickDraft.get().plan(user));
+                            boolean claude = "claude".equals(plan.pilot);
+                            String tableId = CareerApi.startMatch(ctx, call, user, plan.opponentName, "Limited", plan.playerDeck,
+                                    claude ? PlayerType.COMPUTER_CLAUDE : PlayerType.COMPUTER_MAD,
+                                    claude ? plan.claudeSkill : CareerLimited.OPPONENT_SKILL, plan.opponentDeck,
+                                    id -> QuickDraft.get().register(id, user, plan.runId, plan.seat));
+                            CareerApi.CareerMatch match = new CareerApi.CareerMatch();
+                            match.tableId = tableId;
+                            match.opponentId = "quickdraft:" + plan.runId;
+                            match.warm = CareerApi.printings(plan.opponentDeck);
+                            return match;
+                        }),
+                RpcMethod.named("quickDraftAbandon")
+                        .returns("QuickDraftRun")
+                        .doc("Give up the run in progress.")
+                        .handler(call -> {
+                            String user = CareerApi.user(ctx, call);
+                            return refusing(() -> QuickDraft.get().abandon(user));
+                        })
+        );
+    }
+}
