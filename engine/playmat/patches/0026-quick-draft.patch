+import { useQuery } from '@tanstack/react-query';
+import type { QuickDraftRun, QuickDraftState } from '../../protocol/generated/views';
+import { warmMatch } from '../career/careerData';
+import { api } from '../connection';
+import { queryClient } from '../queries';
+import { useEvents } from '../stores/events';
+import { usePlay } from '../stores/play';
+
+/** mtg-ai: Quick Draft's server state (QuickDraftApi): the run in progress, recent runs and the bot brains on offer. */
+
+const KEY = ['quickDraft'] as const;
+
+export function useQuickDraft() {
+  return useQuery({ queryKey: KEY, queryFn: () => api.quickDraft(), staleTime: 0 });
+}
+
+function setRun(run: QuickDraftRun): void {
+  queryClient.setQueryData<QuickDraftState>(KEY, (state) => ({ ...(state ?? {}), run: run.state === 'active' ? run : undefined }));
+  if (run.state !== 'active') void queryClient.invalidateQueries({ queryKey: KEY });
+}
+
+export async function startQuickDraft(setCode: string, brains: string[], pilot: string, claudeSkill: number): Promise<void> {
+  setRun(await api.quickDraftStart(setCode, brains, pilot, claudeSkill));
+}
+
+export async function pickQuickDraft(index: number): Promise<QuickDraftRun> {
+  const run = await api.quickDraftPick(index);
+  setRun(run);
+  return run;
+}
+
+export async function submitQuickDraftDeck(deck: Parameters<typeof api.quickDraftDeck>[0]): Promise<void> {
+  setRun(await api.quickDraftDeck(deck));
+}
+
+export async function setQuickDraftPilot(pilot: string, claudeSkill: number): Promise<void> {
+  setRun(await api.quickDraftPilot(pilot, claudeSkill));
+}
+
+export async function abandonQuickDraft(): Promise<void> {
+  setRun(await api.quickDraftAbandon());
+}
+
+/** The run's next game: the server sets the table up; the game opens like any other and leaving it comes back here. */
+export async function playQuickDraft(): Promise<void> {
+  useEvents.setState({ currentTournamentId: null });
+  usePlay.setState({ phase: 'waitingForGame', error: null, deckId: null, returnPath: '/quickdraft' });
+  try {
+    const match = await api.quickDraftPlay();
+    warmMatch(match);
+    usePlay.setState({ tableId: match?.tableId ?? null, returnPath: '/quickdraft' });
+  } catch (error) {
+    usePlay.setState({ phase: 'idle', tableId: null });
+    throw error;
+  } finally {
+    // the result is counted when the match ends; come back to a fresh record
+    void queryClient.invalidateQueries({ queryKey: KEY });
+  }
+}
diff --git a/Mage.Web.Client/src/app/quickdraft/rooms.ts b/Mage.Web.Client/src/app/quickdraft/rooms.ts
new file mode 100644
index 0000000000..f4c3f7aa06
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/rooms.ts
@@ -0,0 +1,63 @@
+import { useMemo } from 'react';
+import type { CardView, CareerPoolCard } from '../../protocol/generated/views';
+import type { DeckCardInfo } from '../../core/decks/types';
+import { useCardInfo } from '../decks/cardInfo';
+import { entryKey } from '../decks/deckModel';
+import { isRoomCard, lower } from './pool';
+
+/**
+ * mtg-ai: a Room's two doors and their costs, from the card database (the pool only has the Room's combined mana
+ * value). A Room is cast one door at a time, so Quick Draft sorts and counts it at its cheaper door.
+ */
+
+export interface Door {
+  name: string;
+  /** "{4}{U}" */
+  cost: string;
+  manaValue: number;
+}
+
+export interface RoomDoors {
+  left: Door;
+  right: Door;
+  /** the cheaper door's mana value */
+  cheap: number;
+}
+
+/** {4}{U} -> 5; {X} counts 0, a hybrid or Phyrexian symbol 1 */
+export function manaValueOf(cost: string): number {
+  let value = 0;
+  for (const [, symbol] of cost.matchAll(/\{([^}]+)\}/g)) {
+    if (/^\d+$/.test(symbol)) value += Number(symbol);
+    else if (symbol.toUpperCase() !== 'X') value += 1;
+  }
+  return value;
+}
+
+function costOf(view: CardView, side: 'left' | 'right'): string {
+  const listed = side === 'left' ? view.manaCostLeftStr : view.manaCostRightStr;
+  if (listed?.length) return listed.join('');
+  return (side === 'left' ? view.leftSplitCostsStr : view.rightSplitCostsStr) ?? '';
+}
+
+/** each Room in the pool (by lower-case name) with its doors, once the card database has answered */
+export function useRoomDoors(pool: readonly CareerPoolCard[]): ReadonlyMap<string, RoomDoors> {
+  const rooms = useMemo(() => pool.filter(isRoomCard), [pool]);
+  const entries = useMemo<DeckCardInfo[]>(() => rooms.map((card) => ({ cardName: card.name ?? '', setCode: card.setCode ?? '', cardNumber: card.cardNumber ?? '', amount: 1 })), [rooms]);
+  const info = useCardInfo(entries);
+  return useMemo(() => {
+    const doors = new Map<string, RoomDoors>();
+    for (const card of rooms) {
+      const view = info.get(entryKey({ cardName: card.name ?? '', setCode: card.setCode, cardNumber: card.cardNumber }));
+      if (!view) continue;
+      const [leftName, rightName] = (card.name ?? '').split(' // ');
+      const left = { name: view.leftSplitName ?? leftName, cost: costOf(view, 'left'), manaValue: 0 };
+      const right = { name: view.rightSplitName ?? rightName, cost: costOf(view, 'right'), manaValue: 0 };
+      if (!left.cost || !right.cost) continue;
+      left.manaValue = manaValueOf(left.cost);
+      right.manaValue = manaValueOf(right.cost);
+      doors.set(lower(card), { left, right, cheap: Math.min(left.manaValue, right.manaValue) });
+    }
+    return doors;
+  }, [rooms, info]);
+}
diff --git a/Mage.Web.Client/src/app/quickdraft/zoom.ts b/Mage.Web.Client/src/app/quickdraft/zoom.ts
