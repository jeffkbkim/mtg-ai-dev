+
+.pass {
+  margin: 0;
+  color: var(--ink-dim);
+  font-size: var(--text-sm);
+  text-align: center;
+}
+
+.wheelNote {
+  position: relative;
+  margin: 0 auto var(--space-3);
+  max-width: 900px;
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+  text-align: center;
+}
+
+
+.colorCounts {
+  display: inline-flex;
+  gap: var(--space-3);
+  margin-left: var(--space-4);
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+}
+
+.nextOpponent {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: var(--space-3) var(--space-4);
+  border-radius: var(--radius-control);
+  background: rgb(var(--mat-rgb) / 0.6);
+  box-shadow: inset 0 0 0 1.5px var(--ink-faint);
+}
+
+.nextOpponent b {
+  font-family: var(--font-print);
+  font-size: var(--text-xl);
+}
+
+.games {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: var(--space-3) 0 0;
+  padding: 0;
+  list-style: none;
+  color: var(--ink-soft);
+  font-size: var(--text-sm);
+}
+
+.games li {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+}
+
+.won,
+.lost {
+  display: grid;
+  place-items: center;
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  font-size: var(--text-sm);
+}
+
+.won {
+  background: var(--sage);
+  color: var(--mat-900);
+}
+
+.lost {
+  background: var(--oxblood);
+  color: var(--ink-strong);
+}
+
+@media (max-width: 800px) {
+  /* doubled class: wins over events/Draft.module.css whatever order the sheets load in */
+  .screen.screen {
+    position: fixed;
+    overflow: auto;
+    grid-template-columns: 1fr;
+    grid-template-rows: auto auto auto auto;
+    grid-template-areas: 'top' 'pack' 'lists' 'picks';
+  }
+
+  /* rows as tall as their content: the screen scrolls instead of squeezing them */
+  .screen.screen {
+    align-content: start;
+  }
+
+  .packArea,
+  .builderPool,
+  .lists,
+  .picks {
+    min-height: auto;
+  }
+
+  .packArea {
+    display: block;
+  }
+
+  .booster {
+    overflow: visible;
+  }
+
+  .lists {
+    position: static;
+    height: auto;
+    padding: 0 var(--space-4) var(--space-3);
+  }
+
+  .list ul {
+    max-height: 40vh;
+  }
+
+  .zoom {
+    display: none;
+  }
+}
+
+@media (max-width: 700px) {
+  .top {
+    grid-template-columns: 1fr auto;
+    padding: var(--space-3) var(--space-4);
+  }
+
+  .top h1 {
+    font-size: var(--text-2xl);
+  }
+
+  .booster {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 10px;
+    max-width: none;
+  }
+
+  .action {
+    max-width: none;
+  }
+
+  .choice {
+    min-width: 0;
+    flex: 1;
+  }
+
+  .pass {
+    display: none;
+  }
+}
diff --git a/Mage.Web.Client/src/app/quickdraft/QuickDraftScreen.tsx b/Mage.Web.Client/src/app/quickdraft/QuickDraftScreen.tsx
new file mode 100644
index 0000000000..e508deab1b
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/QuickDraftScreen.tsx
@@ -0,0 +1,555 @@
+import { Bot, Layers, LogOut, Swords, Timer } from 'lucide-react';
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import type { CareerPoolCard, QuickDraftBrain, QuickDraftRun, QuickDraftState } from '../../protocol/generated/views';
+import { registerMessages } from '../i18n';
+import careerMessages from '../i18n/en/career';
+import { CLAUDE_EFFORTS, CLAUDE_MODELS, claudeSkill } from '../screens/aiSetup';
+import type { ClaudeEffort, ClaudeModel } from '../stores/play';
+import { usePlay } from '../stores/play';
+import { readJson, writeJson } from '../stores/persist';
+import { notify } from '../stores/toasts';
+import { Button } from '../ui/Button';
+import { CardFace } from '../ui/CardFace';
+import { isEditableEventTarget } from '../ui/keys';
+import {
+  abandonQuickDraft, pickQuickDraft, playQuickDraft, setQuickDraftPilot, startQuickDraft, useQuickDraft,
+} from './quickDraftData';
+import draft from '../events/Draft.module.css';
+import modes from '../career/CareerModes.module.css';
+import { CardZoom } from './CardZoom';
+import { CardList, ManaCurve, PoolBoard } from './PoolBoard';
+import { QuickBuilder } from './QuickBuilder';
+import { SIDEBOARD, arrange, roomsResorted, columnOf, deckStats, isRoomCard, layoutKey, lower, placeIn, type Column } from './pool';
+import { useCardFilter } from './filter';
+import { useRoomDoors } from './rooms';
+import { useCardZoom } from './zoom';
+import styles from './QuickDraft.module.css';
+
+/**
+ * mtg-ai: Quick Draft, like Arena's. Pick a set, the seven bots' brains and who plays their decks; draft three packs;
+ * build 40 cards (a suggested build and lands are one click); then play Bo1 games against the bots' decks, one after
+ * another, until seven wins or three losses. Every pick of every seat is recorded on the server for training data.
+ */
+
+// the builder and the draft review are Career's and speak its messages
+registerMessages(careerMessages);
+
+const SET_NAMES: Record<string, string> = { DSK: 'Duskmourn: House of Horror', FDN: 'Foundations' };
+const PREFS = 'playmat.quickDraft.prefs';
+
+interface Prefs {
+  set: string;
+  brain: string;
+  perSeat: string[] | null;
+  pilot: 'claude' | 'mad';
+  model: ClaudeModel;
+  effort: ClaudeEffort;
+  timer: boolean;
+}
+
+const DEFAULT_PREFS: Prefs = { set: 'DSK', brain: 'statdraft', perSeat: null, pilot: 'claude', model: 'claude-opus-5-5', effort: 'high', timer: false };
+
+function message(reason: unknown): string {
+  return reason instanceof Error ? reason.message : String(reason);
+}
+
+function brainLabel(brains: QuickDraftBrain[] | undefined, name: string | undefined): string {
+  return brains?.find((brain) => brain.name === name)?.label ?? name ?? '?';
+}
+
+function pilotLabel(run: QuickDraftRun): string {
+  if (run.pilot !== 'claude') return 'Playmat AI';
+  const skill = Math.max(1, run.claudeSkill ?? 1) - 1;
+  const model = CLAUDE_MODELS[Math.floor(skill / 3)]?.value === 'claude-sonnet-5-5' ? 'Sonnet' : 'Opus';
+  return `Claude ${model} · ${CLAUDE_EFFORTS[skill % 3]?.value ?? 'low'}`;
+}
+
+function Mana({ colors }: { colors: string | undefined }) {
+  return <>{[...(colors ?? '')].map((color) => <i key={color} className={`ms ms-cost ms-${color.toLowerCase()}`} aria-hidden="true" />)}</>;
+}
+
+export function QuickDraftScreen() {
+  const state = useQuickDraft();
+  if (state.isPending) return <p className={modes.note}>Loading Quick Draft…</p>;
+  if (state.isError) return <p className={modes.error}>Quick Draft can't be reached: {message(state.error)}</p>;
+  const data = state.data ?? {};
+  const run = data.run;
+  if (run?.phase === 'draft') return <Drafting run={run} brains={data.brains} />;
+  return (
+    <div className={modes.page}>
+      <div className={modes.scroll}>
+        <header className={modes.modeHead}>
+          <h1 className={styles.heading}>Quick Draft</h1>
+          <p className={modes.lead}>Draft against seven bots, build 40 cards, then play until 7 wins or 3 losses.</p>
+        </header>
+        {run ? <Run run={run} brains={data.brains} /> : <Start data={data} />}
+        <Recent runs={data.recent ?? []} brains={data.brains} />
+      </div>
+    </div>
+  );
+}
+
+// ---- start
+
+function Start({ data }: { data: QuickDraftState }) {
+  const [prefs, setPrefs] = useState<Prefs>(() => ({ ...DEFAULT_PREFS, ...readJson<Partial<Prefs>>(PREFS, {}) }));
+  const [busy, setBusy] = useState(false);
+  const brains = data.brains ?? [];
+  const sets = data.sets ?? ['DSK', 'FDN'];
+  const update = (patch: Partial<Prefs>) => setPrefs((current) => {
+    const next = { ...current, ...patch };
+    writeJson(PREFS, next);
+    return next;
+  });
+  const seatBrains = prefs.perSeat ?? Array.from({ length: 7 }, () => prefs.brain);
+
+  async function start() {
+    setBusy(true);
+    try {
+      await startQuickDraft(prefs.set, seatBrains, prefs.pilot, claudeSkill(prefs.model, prefs.effort));
+    } catch (reason) {
+      notify("Couldn't start the draft", message(reason), 'error');
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section className={modes.panel} aria-labelledby="qd-start">
+      <h2 id="qd-start" className={modes.panelTitle}>New draft</h2>
+      {!data.brainService && (
+        <p className={modes.warn} role="alert">The draft-brain service isn't answering: every bot will pick with XMage's ratings.</p>
+      )}
+      <div className={styles.form}>
+        <fieldset className={styles.field}>
+          <legend>Set</legend>
+          <div className={styles.choices}>
+            {sets.map((code) => (
+              <button key={code} type="button" className={[styles.choice, prefs.set === code ? styles.choiceOn : ''].join(' ')} aria-pressed={prefs.set === code} onClick={() => update({ set: code })}>
+                <b>{code}</b>
+                <span>{SET_NAMES[code] ?? code}</span>
+              </button>
+            ))}
+          </div>
+        </fieldset>
+
+        <fieldset className={styles.field}>
+          <legend><Bot size={15} aria-hidden="true" /> The bots' brain</legend>
+          <div className={styles.row}>
+            <select value={prefs.perSeat ? '' : prefs.brain} onChange={(event) => update({ brain: event.target.value, perSeat: null })} aria-label="Brain for every bot">
+              {prefs.perSeat && <option value="">Per seat</option>}
+              {brains.map((brain) => <option key={brain.name} value={brain.name}>{brain.label}</option>)}
+            </select>
+            <label className={styles.check}>
+              <input type="checkbox" checked={!!prefs.perSeat} onChange={(event) => update({ perSeat: event.target.checked ? seatBrains : null })} />
+              Choose per seat
+            </label>
+          </div>
+          {prefs.perSeat && (
+            <ol className={styles.seatBrains}>
+              {prefs.perSeat.map((brain, index) => (
+                <li key={index}>
+                  <span>Bot {index + 1}</span>
+                  <select value={brain} aria-label={`Brain for bot ${index + 1}`} onChange={(event) => update({ perSeat: prefs.perSeat!.map((b, i) => (i === index ? event.target.value : b)) })}>
+                    {brains.map((option) => <option key={option.name} value={option.name}>{option.label}</option>)}
+                  </select>
+                </li>
+              ))}
+            </ol>
+          )}
+        </fieldset>
+
+        <fieldset className={styles.field}>
+          <legend><Swords size={15} aria-hidden="true" /> Who plays the bots' decks</legend>
+          <div className={styles.row}>
+            <select value={prefs.pilot} onChange={(event) => update({ pilot: event.target.value as Prefs['pilot'] })} aria-label="Opponent">
+              <option value="claude">Claude AI</option>
+              <option value="mad">Playmat AI</option>
+            </select>
+            {prefs.pilot === 'claude' && (
+              <>
+                <select value={prefs.model} onChange={(event) => update({ model: event.target.value as ClaudeModel })} aria-label="Claude model">
+                  <option value="claude-opus-5-5">Opus 5.5</option>
+                  <option value="claude-sonnet-5-5">Sonnet 5.5</option>
+                </select>
+                <select value={prefs.effort} onChange={(event) => update({ effort: event.target.value as ClaudeEffort })} aria-label="Claude effort">
+                  <option value="low">Low</option>
+                  <option value="medium">Medium</option>
+                  <option value="high">High</option>
+                </select>
+              </>
+            )}
+          </div>
+        </fieldset>
+
+        <fieldset className={styles.field}>
+          <legend><Timer size={15} aria-hidden="true" /> Pick timer</legend>
+          <label className={styles.check}>
+            <input type="checkbox" checked={prefs.timer} onChange={(event) => update({ timer: event.target.checked })} />
+            Timed picks, shorter as the pack empties (a pick you don't make takes the card you chose, else the first)
+          </label>
+        </fieldset>
+      </div>
+      <div className={modes.actions}>
+        <Button variant="decision" size="lg" icon={<Layers size={18} />} busy={busy} onClick={() => void start()}>Start draft</Button>
+      </div>
+    </section>
+  );
+}
+
+// ---- drafting
+
+function pickSeconds(cardsLeft: number): number {
+  return 15 + 4 * cardsLeft;
+}
+
+function faceProps(card: CareerPoolCard) {
+  return { name: card.name, setCode: card.setCode, cardNumber: card.cardNumber };
+}
+
+function Drafting({ run, brains }: { run: QuickDraftRun; brains: QuickDraftBrain[] | undefined }) {
+  const pack = run.pack ?? [];
+  const pool = useMemo(() => run.pool ?? [], [run.pool]);
+  const [selected, setSelected] = useState<number | null>(null);
+  const [busy, setBusy] = useState(false);
+  const zoom = useCardZoom();
+  const filter = useCardFilter(pool);
+  const doors = useRoomDoors(pool);
+  const [arranged, setArranged] = useState<Record<string, number[]>>(() => readJson(layoutKey(run.id ?? ''), {}));
+  const timed = readJson<Partial<Prefs>>(PREFS, {}).timer === true;
+  const packKey = `${run.round}-${run.pick}`;
+  const [shownKey, setShownKey] = useState(packKey);
+  if (shownKey !== packKey) {
+    setShownKey(packKey);
+    setSelected(null);
+  }
+  const columns = useMemo(() => arrange(pool, arranged, doors), [pool, arranged, doors]);
+  const sideSet = useMemo(() => new Set(columns.find((column) => column.label === SIDEBOARD)?.items ?? []), [columns]);
+  const deck = useMemo(() => pool.filter((_, at) => !sideSet.has(at)), [pool, sideSet]);
+  const sideboard = useMemo(() => pool.filter((_, at) => sideSet.has(at)), [pool, sideSet]);
+  const passLeft = (run.round ?? 1) % 2 === 1;
+  const boosterRef = useRef<HTMLDivElement>(null);
+  const listsRef = useRef<HTMLElement>(null);
+  const grid = useCardGrid(boosterRef, pack.length);
+  const stats = deckStats(deck, 0, doors);
+
+  function save(next: Column[]) {
+    const stored = Object.fromEntries(next.map((column) => [column.label, column.items]));
+    writeJson(layoutKey(run.id ?? ''), stored);
+    setArranged(stored);
+  }
+
+  // Rooms the first version sorted at their combined mana value move to their cheaper door's column, once
+  useEffect(() => {
+    const flag = `${layoutKey(run.id ?? '')}.rooms`;
+    if (!doors.size || readJson<boolean>(flag, false)) return;
+    const next = readJson<unknown>(layoutKey(run.id ?? ''), null) ? roomsResorted(pool, columns, doors) : null;
+    if (next) save(next);
+    writeJson(flag, true);
+    // runs when the doors arrive; save and columns are this render's
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [doors]);
+
+  /** one copy of a card (from a list row) to the deck or the sideboard */
+  function moveCopy(card: CareerPoolCard, toSide: boolean) {
+    zoom.hide(); // the row under the pointer moves to the other list without a mouseleave
+    const at = pool.findIndex((candidate, index) => lower(candidate) === lower(card) && sideSet.has(index) !== toSide);
+    if (at < 0) return;
+    const label = toSide ? SIDEBOARD : columnOf(pool[at], doors);
+    save(placeIn(columns, at, label, columns.find((column) => column.label === label)!.items.length));
+  }
+
+  const hover = (card: CareerPoolCard) => zoom.handlers(faceProps(card));
+  // the pack's cards are already large: only a Room (printed sideways) gets a zoom, turned upright
+  const packZoom = (card: CareerPoolCard) => (isRoomCard(card) ? hover(card) : {});
+
+  async function confirm(index: number | null) {
+    if (index === null || busy) return;
+    setBusy(true);
+    zoom.hide();
+    try {
+      await pickQuickDraft(index);
+    } catch (reason) {
+      notify("Couldn't pick that card", message(reason), 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (isEditableEventTarget(event.target)) return;
+      if ((event.code === 'Space' || event.key === 'Enter') && selected !== null) {
+        event.preventDefault();
+        void confirm(selected);
+      }
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  });
+
+  // over the whole page, like an event draft: the app shell's layout would otherwise hold the fixed screen
+  return createPortal(
+    <div className={[draft.screen, styles.immersive, styles.screen].join(' ')}>
+      <header className={[draft.top, styles.top].join(' ')}>
+        <div className={draft.where}>
+          <span className={draft.set}>{run.setName} · Quick Draft</span>
+          <h1 className={draft.title}>Pack {run.round} <span>· Pick {run.pick}</span></h1>
+        </div>
+        <p className={styles.pass}>Passing {passLeft ? 'left ←' : 'right →'} · bots: {[...new Set(run.brains ?? [])].map((name) => brainLabel(brains, name)).join(', ')}</p>
+        <div className={draft.topRight}>
+          {timed && <PickClock key={packKey} seconds={pickSeconds(pack.length)} onExpire={() => void confirm(selected ?? 0)} />}
+          <AbandonButton />
+        </div>
+      </header>
+
+      <main className={[draft.pack, styles.packArea].join(' ')} aria-label="Booster">
+        {(run.takenSince?.length ?? 0) > 0 && (
+          <p className={styles.wheelNote}>
+            This pack came back around. Taken since you saw it: {run.takenSince!.join(', ')}.
+          </p>
+        )}
+        <div ref={boosterRef} className={styles.booster} style={grid} role="listbox" aria-label={`Pick a card, ${pack.length} left in the pack`}>
+          {pack.map((card, index) => (
+            <button
+              key={`${packKey}-${index}`}
+              type="button"
+              role="option"
+              aria-selected={selected === index}
+              aria-label={card.name}
+              className={[draft.card, styles.packCard, selected === index ? draft.cardSelected : ''].join(' ')}
+              style={{ animationDelay: `${index * 25}ms` }}
+              disabled={busy}
+              onClick={() => setSelected(index)}
+              onDoubleClick={() => void confirm(index)}
+              {...packZoom(card)}
+            >
+              <CardFace card={faceProps(card)} size="large" />
+            </button>
+          ))}
+        </div>
+        <div className={styles.action}>
+          <p className={draft.hint}>{selected !== null ? 'Double-click or press Space to pick' : 'Choose a card'}</p>
+          <Button variant="decision" size="xl" busy={busy} disabled={selected === null} onClick={() => void confirm(selected)}>Pick</Button>
+        </div>
+      </main>
+
+      <aside ref={listsRef} className={styles.lists} aria-label="Your deck and sideboard">
+        <ManaCurve stats={stats} />
+        <CardList title="Deck" cards={deck} hint={`${stats.spells} spells · ${stats.lands} lands`} action="−" actionLabel="Move to sideboard" onMove={(card) => moveCopy(card, true)} hover={hover} filter={filter} doors={doors} />
+        <CardList title="Sideboard" cards={sideboard} hint={sideboard.length === 1 ? '1 card' : `${sideboard.length} cards`} action="+" actionLabel="Add to deck" onMove={(card) => moveCopy(card, false)} hover={hover} filter={filter} doors={doors} dim />
+      </aside>
+
+      <PoolBoard
+        pool={pool}
+        columns={columns}
+        onPlace={(at, label, position) => save(placeIn(columns, at, label, position))}
+        hover={hover}
+        filter={filter}
+        doors={doors}
+        head={<h2 className={draft.picksLabel}>Your picks <span>{pool.length}</span></h2>}
+      />
+
+      <CardZoom shown={zoom.shown} bound={listsRef.current?.getBoundingClientRect().left} />
+    </div>,
+    document.body,
+  );
+}
+
+const GAP = 14;
+const MAX_CARD = 330;
+
+/** The pack's grid: large cards sized by the width (the screen scrolls for a second row), a full pack in two rows. */
+function useCardGrid(ref: { current: HTMLDivElement | null }, count: number) {
+  const [width, setWidth] = useState(1200);
+  useLayoutEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    const measure = () => setWidth(element.clientWidth);
+    measure();
+    const observer = new ResizeObserver(measure);
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [ref]);
+  return useMemo(() => {
+    const n = Math.max(1, count);
+    const narrow = width < 640;
+    const cols = narrow ? 3 : Math.min(n, Math.max(5, Math.min(8, Math.ceil(n / 2))));
+    const card = Math.min(narrow ? 400 : MAX_CARD, (width - (cols - 1) * GAP) / cols);
+    return { gridTemplateColumns: `repeat(${cols}, ${Math.max(60, Math.floor(card))}px)` };
+  }, [width, count]);
+}
+
+
+function PickClock({ seconds, onExpire }: { seconds: number; onExpire(): void }) {
+  const [deadline] = useState(() => Date.now() + seconds * 1000);
+  const [now, setNow] = useState(Date.now());
+  const left = Math.max(0, deadline - now);
+  useEffect(() => {
+    const timer = setInterval(() => setNow(Date.now()), 250);
+    return () => clearInterval(timer);
+  }, []);
+  const expired = left <= 0;
+  useEffect(() => {
+    if (expired) onExpire();
+    // fires once, when time runs out
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [expired]);
+  const shown = Math.ceil(left / 1000);
+  return (
+    <div className={[draft.clock, shown <= 10 ? draft.clockLow : ''].join(' ')} role="timer" aria-label={`${shown} seconds left to pick`}>
+      <Timer size={16} aria-hidden="true" />
+      <span>{shown}</span>
+    </div>
+  );
+}
+
+function AbandonButton() {
+  const [confirming, setConfirming] = useState(false);
+  async function abandon() {
+    try {
+      await abandonQuickDraft();
+    } catch (reason) {
+      notify("Couldn't give up the run", message(reason), 'error');
+    } finally {
+      setConfirming(false);
+    }
+  }
+  return confirming ? (
+    <span className={modes.confirm} role="group" aria-label="Give up the run">
+      <span className={modes.warn}>Give up this run?</span>
+      <Button variant="danger" size="sm" onClick={() => void abandon()}>Give up</Button>
+      <Button variant="quiet" size="sm" onClick={() => setConfirming(false)}>Keep it</Button>
+    </span>
+  ) : (
+    <Button variant="quiet" size="sm" icon={<LogOut size={16} />} onClick={() => setConfirming(true)}>Give up</Button>
+  );
+}
+
+// ---- building and playing
+
+function Run({ run, brains }: { run: QuickDraftRun; brains: QuickDraftBrain[] | undefined }) {
+  const [editing, setEditing] = useState(false);
+  if (run.phase === 'build' || editing) {
+    return <QuickBuilder key={run.id} run={run} onDone={() => setEditing(false)} onCancel={run.phase === 'play' ? () => setEditing(false) : undefined} />;
+  }
+  return <Games run={run} brains={brains} onEdit={() => setEditing(true)} />;
+}
+
+function Record({ wins, losses }: { wins: number; losses: number }) {
+  return (
+    <div className={modes.record} role="img" aria-label={`${wins} wins, ${losses} losses of 7 wins or 3 losses`}>
+      <span className={modes.pips} aria-hidden="true">
+        {Array.from({ length: 7 }, (_, index) => <i key={index} className={index < wins ? modes.pipWin : modes.pip}>{index < wins ? 'W' : ''}</i>)}
+      </span>
+      <span className={modes.pips} aria-hidden="true">
+        {Array.from({ length: 3 }, (_, index) => <i key={index} className={index < losses ? modes.pipLoss : modes.pip}>{index < losses ? 'L' : ''}</i>)}
+      </span>
+      <span aria-hidden="true">{wins}–{losses}</span>
+    </div>
+  );
+}
+
+function Games({ run, brains, onEdit }: { run: QuickDraftRun; brains: QuickDraftBrain[] | undefined; onEdit(): void }) {
+  const playing = usePlay((play) => play.phase !== 'idle');
+  const [starting, setStarting] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const wins = run.wins ?? 0;
+  const losses = run.losses ?? 0;
+  const next = run.next;
+  const deckSize = (run.deck ?? []).reduce((sum, card) => sum + (card.amount ?? 0), 0);
+
+  async function play() {
+    setStarting(true);
+    setError(null);
+    try {
+      await playQuickDraft();
+    } catch (reason) {
+      setError(message(reason));
+      setStarting(false);
+    }
+  }
+
+  async function changePilot(value: string) {
+    try {
+      const [pilot, model, effort] = value.split('|');
+      await setQuickDraftPilot(pilot, pilot === 'claude' ? claudeSkill(model as ClaudeModel, effort as ClaudeEffort) : 1);
+    } catch (reason) {
+      notify("Couldn't change the opponent", message(reason), 'error');
+    }
+  }
+
+  const skill = Math.max(1, run.claudeSkill ?? 1) - 1;
+  const pilotValue = run.pilot === 'claude' ? `claude|${CLAUDE_MODELS[Math.floor(skill / 3)]?.value}|${CLAUDE_EFFORTS[skill % 3]?.value}` : 'mad|';
+
+  return (
+    <section className={modes.panel} aria-labelledby="qd-games">
+      <h2 id="qd-games" className={modes.panelTitle}>{run.setName} · Game {wins + losses + 1}</h2>
+      <Record wins={wins} losses={losses} />
+      {next && (
+        <div className={styles.nextOpponent}>
+          <span className={modes.small}>Next opponent</span>
+          <b>Bot {next.seat} <Mana colors={next.colors} /></b>
+          <span className={modes.small}>drafted by {brainLabel(brains, next.brain)}{next.builtBy === 'fallback' ? ' (deck by the fallback builder)' : ''} · played by {pilotLabel(run)}</span>
+        </div>
+      )}
+      <div className={styles.row}>
+        <label className={modes.small} htmlFor="qd-pilot">Opponent AI</label>
+        <select id="qd-pilot" value={pilotValue} onChange={(event) => void changePilot(event.target.value)}>
+          {CLAUDE_MODELS.flatMap((model) => CLAUDE_EFFORTS.map((effort) => (
+            <option key={`${model.value}-${effort.value}`} value={`claude|${model.value}|${effort.value}`}>
+              Claude {model.value === 'claude-opus-5-5' ? 'Opus' : 'Sonnet'} · {effort.value}
+            </option>
+          )))}
+          <option value="mad|">Playmat AI</option>
+        </select>
+      </div>
+      <p className={modes.small}>Your deck: {deckSize} cards.</p>
+      {error && <p className={modes.error} role="alert">Couldn't start the game: {error}</p>}
+      <div className={modes.actions}>
+        <Button variant="decision" size="lg" icon={<Swords size={18} />} busy={starting} disabled={playing} onClick={() => void play()}>
+          {starting ? 'Starting…' : 'Play'}
+        </Button>
+        <Button variant="print" size="sm" icon={<Layers size={16} />} onClick={onEdit}>Edit deck</Button>
+        <AbandonButton />
+      </div>
+      <GameList run={run} brains={brains} />
+    </section>
+  );
+}
+
+function GameList({ run, brains }: { run: QuickDraftRun; brains: QuickDraftBrain[] | undefined }) {
+  const games = run.games ?? [];
+  if (games.length === 0) return null;
+  return (
+    <ol className={styles.games}>
+      {games.map((game) => (
+        <li key={game.number}>
+          <b className={game.won ? styles.won : styles.lost}>{game.won ? 'W' : 'L'}</b>
+          <span>Game {game.number} vs Bot {game.seat} <Mana colors={game.colors} /> · {brainLabel(brains, game.brain)} · {game.pilot === 'claude' ? 'Claude' : 'Playmat AI'} · turn {game.turns}</span>
+        </li>
+      ))}
+    </ol>
+  );
+}
+
+const END: Record<string, string> = { won: 'Finished: 7 wins', lost: 'Finished', abandoned: 'Given up' };
+
+function Recent({ runs, brains }: { runs: QuickDraftRun[]; brains: QuickDraftBrain[] | undefined }) {
+  if (runs.length === 0) return null;
+  return (
+    <section className={modes.card} aria-labelledby="qd-recent">
+      <h2 id="qd-recent" className={modes.cardLabel}>Recent drafts</h2>
+      <ul className={modes.recentRuns}>
+        {runs.map((run) => (
+          <li key={run.id}>
+            <span>
+              {run.setCode} · {run.wins ?? 0}–{run.losses ?? 0} · {END[run.phase ?? ''] ?? run.phase} · bots: {[...new Set(run.brains ?? [])].map((name) => brainLabel(brains, name)).join(', ')}
+              {run.started ? ` · ${new Date(run.started).toLocaleDateString()}` : ''}
+            </span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
diff --git a/Mage.Web.Client/src/app/quickdraft/filter.ts b/Mage.Web.Client/src/app/quickdraft/filter.ts
new file mode 100644
index 0000000000..65dd6762d3
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/filter.ts
@@ -0,0 +1,86 @@
+import { useMemo, useState } from 'react';
+import type { CareerPoolCard } from '../../protocol/generated/views';
+import type { DeckCardInfo } from '../../core/decks/types';
+import { useCardInfo } from '../decks/cardInfo';
+import { entryKey } from '../decks/deckModel';
+import { readJson, writeJson } from '../stores/persist';
+import { isRoomCard } from './pool';
+
+/**
+ * mtg-ai: Quick Draft's card filter: tick card types and colours; cards that match none of the ticked boxes of a
+ * group are greyed out, or hidden. Nothing ticked: everything shows. The types come from the card database (the pool
+ * only says creature or land). Remembered in this browser.
+ */
+
+export const TYPE_BOXES = ['Creature', 'Enchantment', 'Room', 'Instant', 'Sorcery', 'Artifact', 'Land'] as const;
+export const COLOR_BOXES = ['W', 'U', 'B', 'R', 'G', 'C', 'M'] as const;
+export type TypeBox = (typeof TYPE_BOXES)[number];
+export type ColorBox = (typeof COLOR_BOXES)[number];
+
+export interface FilterState {
+  types: TypeBox[];
+  colors: ColorBox[];
+  hide: boolean;
+}
+
+const KEY = 'playmat.quickDraft.filter';
+const EMPTY: FilterState = { types: [], colors: [], hide: false };
+
+export function useCardFilter(pool: readonly CareerPoolCard[]) {
+  const [state, setState] = useState<FilterState>(() => ({ ...EMPTY, ...readJson<Partial<FilterState>>(KEY, {}) }));
+  const entries = useMemo<DeckCardInfo[]>(() => pool.map((card) => ({ cardName: card.name ?? '', setCode: card.setCode ?? '', cardNumber: card.cardNumber ?? '', amount: 1 })), [pool]);
+  const info = useCardInfo(entries);
+
+  const update = (next: FilterState) => {
+    writeJson(KEY, next);
+    setState(next);
+  };
+
+  /** the card's type boxes: from the card database, else what the pool knows */
+  const typesOf = (card: CareerPoolCard): Set<TypeBox> => {
+    const view = info.get(entryKey({ cardName: card.name ?? '', setCode: card.setCode, cardNumber: card.cardNumber }));
+    const types = new Set<TypeBox>();
+    for (const type of view?.cardTypes ?? []) {
+      const named = (type.charAt(0) + type.slice(1).toLowerCase()) as TypeBox;
+      if ((TYPE_BOXES as readonly string[]).includes(named)) types.add(named);
+    }
+    if (card.creature) types.add('Creature');
+    if (card.land) types.add('Land');
+    if (isRoomCard(card)) {
+      types.add('Room');
+      types.add('Enchantment');
+    }
+    return types;
+  };
+
+  const colorsOf = (card: CareerPoolCard): ColorBox[] => {
+    const colors = card.colors ?? '';
+    if (colors.length === 0) return ['C'];
+    return colors.length > 1 ? ['M', ...(colors.split('') as ColorBox[])] : [colors as ColorBox];
+  };
+
+  const active = state.types.length > 0 || state.colors.length > 0;
+  const matches = (card: CareerPoolCard): boolean => {
+    if (state.types.length > 0) {
+      const types = typesOf(card);
+      if (!state.types.some((type) => types.has(type))) return false;
+    }
+    if (state.colors.length > 0) {
+      const colors = colorsOf(card);
+      if (!state.colors.some((color) => colors.includes(color))) return false;
+    }
+    return true;
+  };
+
+  return {
+    state,
+    active,
+    matches,
+    toggleType: (type: TypeBox) => update({ ...state, types: state.types.includes(type) ? state.types.filter((t) => t !== type) : [...state.types, type] }),
+    toggleColor: (color: ColorBox) => update({ ...state, colors: state.colors.includes(color) ? state.colors.filter((c) => c !== color) : [...state.colors, color] }),
+    setHide: (hide: boolean) => update({ ...state, hide }),
+    clear: () => update({ ...EMPTY, hide: state.hide }),
+  };
+}
+
+export type CardFilter = ReturnType<typeof useCardFilter>;
