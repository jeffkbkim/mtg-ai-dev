diff --git a/Mage.Web.Client/src/app/quickdraft/CardZoom.tsx b/Mage.Web.Client/src/app/quickdraft/CardZoom.tsx
new file mode 100644
index 0000000000..b5351828ea
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/CardZoom.tsx
@@ -0,0 +1,28 @@
+import { createPortal } from 'react-dom';
+import { CardFace } from '../ui/CardFace';
+import { isRoomCard } from './pool';
+import type { Shown } from './zoom';
+import styles from './QuickDraft.module.css';
+
+const RATIO = 1.396; // height / width
+
+/** The zoom itself; `bound` is an x it must not cross (the deck list's left edge), or the window's width. */
+export function CardZoom({ shown, bound }: { shown: Shown | null; bound?: number }) {
+  if (!shown) return null;
+  const room = isRoomCard(shown.card);
+  const portrait = Math.min(340, window.innerWidth * 0.42);
+  const boxW = room ? portrait * RATIO : portrait;
+  const boxH = room ? portrait : portrait * RATIO;
+  // over the list itself (a hovered row), the bound is the window; elsewhere the list's left edge
+  const limit = (bound !== undefined && shown.right <= bound ? bound : window.innerWidth) - 8;
+  const left = shown.right + 12 + boxW <= limit ? shown.right + 12 : Math.max(8, shown.left - boxW - 12);
+  const top = Math.max(8, Math.min(shown.top, window.innerHeight - boxH - 8));
+  return createPortal(
+    <div className={[styles.zoom, styles.zoomTop].join(' ')} style={{ left, top, width: boxW, height: boxH }} aria-hidden="true">
+      <div className={room ? styles.zoomTurned : undefined} style={room ? { width: boxH, left: (boxW - boxH) / 2, top: (boxH - boxW) / 2 } : undefined}>
+        <CardFace card={shown.card} size="large" />
+      </div>
+    </div>,
+    document.body,
+  );
+}
diff --git a/Mage.Web.Client/src/app/quickdraft/PoolBoard.tsx b/Mage.Web.Client/src/app/quickdraft/PoolBoard.tsx
new file mode 100644
index 0000000000..7bc15ac442
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/PoolBoard.tsx
@@ -0,0 +1,274 @@
+import { useMemo, useRef, useState, type PointerEvent as ReactPointerEvent, type ReactNode } from 'react';
+import type { CareerPoolCard } from '../../protocol/generated/views';
+import { CardFace } from '../ui/CardFace';
+import { COLOR_BOXES, TYPE_BOXES, type CardFilter } from './filter';
+import { SIDEBOARD, colorRank, lower, sortValue, type Column } from './pool';
+import type { RoomDoors } from './rooms';
+import draft from '../events/Draft.module.css';
+import styles from './QuickDraft.module.css';
+
+/**
+ * mtg-ai: the pool in columns (pool.ts), like Arena's: drag a card with the pointer (mouse, pen or finger; Safari
+ * can't drag buttons the HTML way) to another place in its column, to another column, or into the Sideboard column.
+ * Every column always shows, so nothing moves under a dragged card. A tap or click does nothing to the deck.
+ */
+
+interface Drag {
+  at: number;
+  x: number;
+  y: number;
+  startX: number;
+  startY: number;
+  moved: boolean;
+}
+
+type Hover = (card: CareerPoolCard) => object;
+
+export function PoolBoard({ pool, columns, onPlace, hover, head, hint, filter, doors }: {
+  pool: readonly CareerPoolCard[];
+  columns: readonly Column[];
+  onPlace(at: number, label: string, position: number): void;
+  hover: Hover;
+  head?: ReactNode;
+  hint?: string;
+  /** cards not matching are greyed out, or left out of the stacks (filter.ts) */
+  filter?: CardFilter;
+  /** Rooms' doors (rooms.ts): both costs show on the card */
+  doors?: ReadonlyMap<string, RoomDoors>;
+}) {
+  const hidden = (at: number) => !!filter?.active && filter.state.hide && !filter.matches(pool[at]);
+  const shownOf = (column: Column) => column.items.filter((at) => !hidden(at));
+  const [drag, setDrag] = useState<Drag | null>(null);
+  const dragRef = useRef<Drag | null>(null);
+
+  /** the column under the pointer and the place in its stack */
+  function dropTarget(x: number, y: number): { label: string; position: number } | null {
+    const element = document.elementFromPoint(x, y)?.closest('[data-column]') as HTMLElement | null;
+    if (!element) return null;
+    const stack = element.querySelector('[data-stack]') as HTMLElement | null;
+    const step = (stack?.firstElementChild as HTMLElement | null)?.offsetWidth ?? 90;
+    const top = stack?.getBoundingClientRect().top ?? element.getBoundingClientRect().top;
+    return { label: element.dataset.column!, position: Math.max(0, Math.round((y - top) / (step * 0.3))) };
+  }
+
+  function onPointerDown(event: ReactPointerEvent, at: number) {
+    if (event.button !== 0) return;
+    const start = { at, x: event.clientX, y: event.clientY, startX: event.clientX, startY: event.clientY, moved: false };
+    dragRef.current = start;
+    setDrag(start);
+    const onMove = (move: PointerEvent) => {
+      const current = dragRef.current;
+      if (!current) return;
+      const moved = current.moved || Math.hypot(move.clientX - current.startX, move.clientY - current.startY) > 6;
+      dragRef.current = { ...current, x: move.clientX, y: move.clientY, moved };
+      if (moved) setDrag(dragRef.current);
+    };
+    const onUp = (up: PointerEvent) => {
+      window.removeEventListener('pointermove', onMove);
+      window.removeEventListener('pointerup', onUp);
+      window.removeEventListener('pointercancel', onUp);
+      const current = dragRef.current;
+      dragRef.current = null;
+      setDrag(null);
+      if (!current?.moved) return;
+      const target = dropTarget(up.clientX, up.clientY);
+      if (!target) return;
+      // the place among the cards shown (some may be hidden by the filter) -> the place in the column
+      const column = columns.find((candidate) => candidate.label === target.label);
+      const shown = column ? shownOf(column).filter((item) => item !== current.at) : [];
+      const before = shown[target.position];
+      const items = column ? column.items.filter((item) => item !== current.at) : [];
+      onPlace(current.at, target.label, before === undefined ? items.length : items.indexOf(before));
+    };
+    window.addEventListener('pointermove', onMove);
+    window.addEventListener('pointerup', onUp);
+    window.addEventListener('pointercancel', onUp);
+  }
+
+  const moving = drag?.moved ? drag : null;
+  const over = moving ? dropTarget(moving.x, moving.y)?.label : null;
+
+  return (
+    <section className={[draft.picks, styles.picks, moving ? styles.dragging : ''].join(' ')} aria-label={`Your pool, ${pool.length} cards`}>
+      <div className={styles.picksHead}>
+        {head}
+        <small className={styles.picksHint}>{hint ?? 'drag cards to arrange them, or into Sideboard to leave them out of the deck'}</small>
+      </div>
+      {filter && <FilterBar filter={filter} />}
+      <div className={[draft.columns, styles.columns].join(' ')}>
+        {columns.map((column) => (
+          <div
+            key={column.label}
+            data-column={column.label}
+            className={[draft.column, styles.column, column.items.length === 0 && column.label !== SIDEBOARD ? styles.emptyColumn : '',
+              column.label === SIDEBOARD ? styles.sideColumn : '', moving ? styles.dropTarget : '', over === column.label ? styles.dropOver : ''].join(' ')}
+          >
+            <span className={draft.columnLabel}>{column.label} <small>({column.items.length})</small></span>
+            <div data-stack className={draft.columnCards} style={{ height: `calc(var(--pick-w) * (1.4 + 0.3 * ${Math.max(0, shownOf(column).length - 1)}))` }}>
+              {shownOf(column).map((at, index) => {
+                const card = pool[at];
+                const dim = !!filter?.active && !filter.matches(card);
+                return (
+                  <div
+                    key={at}
+                    role="button"
+                    tabIndex={0}
+                    className={[draft.picked, styles.picked, column.label === SIDEBOARD ? styles.inSide : '', dim ? styles.filteredOut : '', moving?.at === at ? styles.dragged : ''].join(' ')}
+                    style={{ top: `calc(var(--pick-w) * ${0.3 * index})`, zIndex: index }}
+                    aria-label={`${card.name}, ${column.label === SIDEBOARD ? 'sideboard' : 'deck'}; drag to move`}
+                    {...(moving ? {} : hover(card))}
+                    onPointerDown={(event) => {
+                      // the zoom's long press (touch) and the drag both start here
+                      (hover(card) as { onPointerDown?(e: ReactPointerEvent): void }).onPointerDown?.(event);
+                      onPointerDown(event, at);
+                    }}
+                  >
+                    <CardFace card={{ name: card.name, setCode: card.setCode, cardNumber: card.cardNumber }} size="normal" />
+                    {doors?.get(lower(card)) && <DoorCosts room={doors.get(lower(card))!} className={styles.doorTag} />}
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+        ))}
+      </div>
+      {moving && (
+        <div className={styles.ghost} style={{ left: moving.x - 45, top: moving.y - 20 }} aria-hidden="true">
+          <CardFace card={{ name: pool[moving.at].name, setCode: pool[moving.at].setCode, cardNumber: pool[moving.at].cardNumber }} size="normal" />
+        </div>
+      )}
+    </section>
+  );
+}
+
+/** Spells by mana value as bars, then colours, creatures and lands (pool.ts deckStats). */
+export function ManaCurve({ stats }: { stats: { curve: number[]; colors: { color: string; count: number }[]; spells: number; creatures: number; lands: number; average: number } }) {
+  const tallest = Math.max(1, ...stats.curve);
+  return (
+    <div className={styles.curveBox} aria-label="Mana curve of the deck">
+      <div className={styles.curve} role="img" aria-label={stats.curve.map((n, index) => `${index === 6 ? '6+' : index}: ${n}`).join(', ')}>
+        {stats.curve.map((n, index) => (
+          <span key={index}>
+            <b>{n || ''}</b>
+            <i style={{ height: `${(n / tallest) * 100}%` }} />
+            <small>{index === 6 ? '6+' : index}</small>
+          </span>
+        ))}
+      </div>
+      <p className={styles.curveFacts}>
+        {stats.colors.map(({ color, count }) => (
+          <span key={color}><i className={`ms ms-cost ms-${color.toLowerCase()}`} aria-hidden="true" /> {count}</span>
+        ))}
+        <span>{stats.creatures} creatures</span>
+        <span>{stats.spells - stats.creatures} other spells</span>
+        <span>{stats.lands} lands</span>
+        {stats.spells > 0 && <span>avg {stats.average.toFixed(1)}</span>}
+      </p>
+    </div>
+  );
+}
+
+const COLOR_NAMES: Record<string, string> = { W: 'White', U: 'Blue', B: 'Black', R: 'Red', G: 'Green', C: 'Colourless', M: 'Multicolour' };
+
+/** Tick boxes for card types and colours, grey out or hide what doesn't match, and Clear. */
+export function FilterBar({ filter }: { filter: CardFilter }) {
+  return (
+    <div className={styles.filterBar} role="group" aria-label="Filter the pool">
+      {TYPE_BOXES.map((type) => (
+        <label key={type} className={[styles.filterBox, filter.state.types.includes(type) ? styles.filterOn : ''].join(' ')}>
+          <input type="checkbox" checked={filter.state.types.includes(type)} onChange={() => filter.toggleType(type)} />
+          {type}
+        </label>
+      ))}
+      <span className={styles.filterGap} aria-hidden="true" />
+      {COLOR_BOXES.map((color) => (
+        <label key={color} className={[styles.filterBox, filter.state.colors.includes(color) ? styles.filterOn : ''].join(' ')} title={COLOR_NAMES[color]}>
+          <input type="checkbox" checked={filter.state.colors.includes(color)} onChange={() => filter.toggleColor(color)} aria-label={COLOR_NAMES[color]} />
+          {color === 'C' || color === 'M' ? <span className={styles.filterLetter}>{color === 'C' ? '◇' : 'Multi'}</span> : <i className={`ms ms-cost ms-${color.toLowerCase()}`} aria-hidden="true" />}
+        </label>
+      ))}
+      <span className={styles.filterGap} aria-hidden="true" />
+      <label className={styles.filterBox}>
+        <input type="checkbox" checked={filter.state.hide} onChange={(event) => filter.setHide(event.target.checked)} />
+        Hide others
+      </label>
+      {filter.active && <button type="button" className={styles.suggest} onClick={filter.clear}>Clear</button>}
+    </div>
+  );
+}
+
+/** "{U}" -> mana symbols */
+export function ManaCost({ cost }: { cost: string }) {
+  return (
+    <span className={styles.manaCost} aria-label={cost}>
+      {[...cost.matchAll(/\{([^}]+)\}/g)].map(([, symbol], index) => (
+        <i key={index} className={`ms ms-cost ms-${symbol.toLowerCase().replace('/', '')}`} aria-hidden="true" />
+      ))}
+    </span>
+  );
+}
+
+/** a Room's two door costs: "{U} / {4}{U}" */
+export function DoorCosts({ room, className }: { room: RoomDoors; className?: string }) {
+  return (
+    <span className={[styles.doorCosts, className ?? ''].join(' ')} title={`${room.left.name} ${room.left.cost} / ${room.right.name} ${room.right.cost}`}>
+      <ManaCost cost={room.left.cost} /><span className={styles.doorSlash}>/</span><ManaCost cost={room.right.cost} />
+    </span>
+  );
+}
+
+function Mana({ colors }: { colors: string | undefined }) {
+  return <>{[...(colors ?? '')].map((color) => <i key={color} className={`ms ms-cost ms-${color.toLowerCase()}`} aria-hidden="true" />)}</>;
+}
+
+/** A deck or sideboard list, like Arena's: how many, the name, mana value and colours, and a button to move one copy;
+ * hovering a row shows the card. */
+export function CardList({ title, cards, hint, action, actionLabel, onMove, hover, dim, filter, doors }: {
+  title: string;
+  cards: CareerPoolCard[];
+  hint: string;
+  action: string;
+  actionLabel: string;
+  onMove(card: CareerPoolCard): void;
+  hover(card: CareerPoolCard): object;
+  dim?: boolean;
+  filter?: CardFilter;
+  doors?: ReadonlyMap<string, RoomDoors>;
+}) {
+  const rows = useMemo(() => {
+    const byName = new Map<string, { card: CareerPoolCard; count: number }>();
+    for (const card of cards) {
+      const row = byName.get(lower(card));
+      if (row) row.count++;
+      else byName.set(lower(card), { card, count: 1 });
+    }
+    return [...byName.values()].sort((a, b) => Number(!!a.card.land) - Number(!!b.card.land)
+      || sortValue(a.card, doors) - sortValue(b.card, doors) || colorRank(a.card) - colorRank(b.card) || (a.card.name ?? '').localeCompare(b.card.name ?? ''));
+  }, [cards, doors]);
+  return (
+    <section className={[styles.list, dim ? styles.listDim : ''].join(' ')} aria-label={title}>
+      <header className={styles.listHead}>
+        <h2>{title} <span>{cards.length}</span></h2>
+        <small>{hint}</small>
+      </header>
+      <ul>
+        {rows.filter(({ card }) => !(filter?.active && filter.state.hide && !filter.matches(card))).map(({ card, count }) => (
+          <li key={lower(card)} className={[styles.row, filter?.active && !filter.matches(card) ? styles.filteredOut : ''].join(' ')} {...hover(card)}>
+            <span className={styles.rowCount}>{count}×</span>
+            <span className={styles.rowName}>{card.name}</span>
+            <span className={styles.rowCost}>
+              {doors?.get(lower(card)) ? <DoorCosts room={doors.get(lower(card))!} /> : (
+                <>
+                  {!card.land && <b>{card.manaValue ?? 0}</b>}
+                  <Mana colors={card.colors} />
+                </>
+              )}
+            </span>
+            <button type="button" className={styles.rowMove} title={actionLabel} aria-label={`${actionLabel}: ${card.name}`} onClick={() => onMove(card)}>{action}</button>
+          </li>
+        ))}
+        {rows.length === 0 && <li className={styles.empty}>{dim ? 'Drag cards here from your picks, or press − in the deck list.' : 'Your picks go here.'}</li>}
+      </ul>
+    </section>
+  );
+}
diff --git a/Mage.Web.Client/src/app/quickdraft/QuickBuilder.tsx b/Mage.Web.Client/src/app/quickdraft/QuickBuilder.tsx
new file mode 100644
index 0000000000..2dd4581a95
--- /dev/null
+++ b/Mage.Web.Client/src/app/quickdraft/QuickBuilder.tsx
@@ -0,0 +1,196 @@
+import { Minus, Plus, WandSparkles } from 'lucide-react';
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import type { CareerPoolCard, QuickDraftRun } from '../../protocol/generated/views';
+import { BASIC_LANDS, buildDeck, emptyBasics, poolEntries, suggestBasics, type BasicLand, type LimitedBuild } from '../career/careerModesModel';
+import { readJson, writeJson } from '../stores/persist';
+import { notify } from '../stores/toasts';
+import { Button } from '../ui/Button';
+import { CardZoom } from './CardZoom';
+import { CardList, ManaCurve, PoolBoard } from './PoolBoard';
+import { BASIC_NAMES, SIDEBOARD, arrange, roomsResorted, columnOf, deckStats, layoutKey, lower, placeIn, type Column } from './pool';
+import { submitQuickDraftDeck } from './quickDraftData';
+import { useCardFilter } from './filter';
+import { useRoomDoors } from './rooms';
+import { useCardZoom } from './zoom';
+import draft from '../events/Draft.module.css';
+import styles from './QuickDraft.module.css';
+
+/**
+ * mtg-ai: Quick Draft's deck builder, laid out like the pick screen and Arena's: the pool in mana-value columns (the
+ * arrangement and Sideboard column carry over from the draft), dragged to arrange and to move cards in and out of the
+ * deck; on the right the mana curve, the deck and sideboard lists, basic lands and the button that saves the deck.
+ * Hovering a card or a row shows it large.
+ */
+
+const SYMBOL: Record<BasicLand, string> = { Plains: 'w', Island: 'u', Swamp: 'b', Mountain: 'r', Forest: 'g' };
+const DECK_MIN = 40;
+
+function basicsKey(runId: string): string {
+  return `playmat.quickDraft.basics.${runId}`;
+}
+
+/** a saved deck (editing after games) as columns: what isn't in it goes to the Sideboard column */
+function fromDeck(pool: readonly CareerPoolCard[], run: QuickDraftRun): Record<string, number[]> {
+  const left = new Map<string, number>();
+  for (const card of run.deck ?? []) left.set((card.cardName ?? '').toLowerCase(), (left.get((card.cardName ?? '').toLowerCase()) ?? 0) + (card.amount ?? 0));
+  const columns: Record<string, number[]> = {};
+  pool.forEach((card, at) => {
+    const n = left.get(lower(card)) ?? 0;
+    const label = n > 0 || (card.land && BASIC_NAMES.includes(lower(card))) ? columnOf(card) : SIDEBOARD;
+    if (n > 0) left.set(lower(card), n - 1);
+    (columns[label] ??= []).push(at);
+  });
+  return columns;
+}
+
+function basicsFromDeck(run: QuickDraftRun): Record<BasicLand, number> {
+  const basics = emptyBasics();
+  for (const card of run.deck ?? []) {
+    const land = BASIC_LANDS.find((name) => name.toLowerCase() === (card.cardName ?? '').toLowerCase());
+    if (land) basics[land] += card.amount ?? 0;
+  }
+  return basics;
+}
+
+export function QuickBuilder({ run, onDone, onCancel }: { run: QuickDraftRun; onDone(): void; onCancel?: () => void }) {
+  const pool = useMemo(() => run.pool ?? [], [run.pool]);
+  const id = run.id ?? '';
+  const [arranged, setArranged] = useState<Record<string, number[]>>(() => {
+    const saved = readJson<Record<string, number[]> | null>(layoutKey(id), null);
+    return saved ?? (run.deck?.length ? fromDeck(pool, run) : {});
+  });
+  const [basics, setBasics] = useState<Record<BasicLand, number>>(() => readJson(basicsKey(id), run.deck?.length ? basicsFromDeck(run) : emptyBasics()));
+  const [busy, setBusy] = useState(false);
+  const zoom = useCardZoom();
+  const filter = useCardFilter(pool);
+  const doors = useRoomDoors(pool);
+  const listsRef = useRef<HTMLElement>(null);
+
+  const columns = useMemo(() => arrange(pool, arranged, doors), [pool, arranged, doors]);
+  const sideSet = useMemo(() => new Set(columns.find((column) => column.label === SIDEBOARD)?.items ?? []), [columns]);
+  const deck = useMemo(() => pool.filter((_, at) => !sideSet.has(at)), [pool, sideSet]);
+  const sideboard = useMemo(() => pool.filter((_, at) => sideSet.has(at)), [pool, sideSet]);
+  // basic lands drafted from packs are free anyway: the steppers below are the deck's basics
+  const deckCards = useMemo(() => deck.filter((card) => !(card.land && BASIC_NAMES.includes(lower(card)))), [deck]);
+  const basicCount = Object.values(basics).reduce((sum, n) => sum + n, 0);
+  const stats = deckStats(deckCards, basicCount, doors);
+  const size = deckCards.length + basicCount;
+
+  function save(next: Column[]) {
+    const stored = Object.fromEntries(next.map((column) => [column.label, column.items]));
+    writeJson(layoutKey(id), stored);
+    setArranged(stored);
+  }
+
+  // Rooms the first version sorted at their combined mana value move to their cheaper door's column, once
+  useEffect(() => {
+    const flag = `${layoutKey(id)}.rooms`;
+    if (!doors.size || readJson<boolean>(flag, false)) return;
+    const next = readJson<unknown>(layoutKey(id), null) ? roomsResorted(pool, columns, doors) : null;
+    if (next) save(next);
+    writeJson(flag, true);
+    // runs when the doors arrive; save and columns are this render's
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [doors]);
+
+  function setBasic(land: BasicLand, delta: number) {
+    setBasics((current) => {
+      const next = { ...current, [land]: Math.max(0, current[land] + delta) };
+      writeJson(basicsKey(id), next);
+      return next;
+    });
+  }
+
+  function moveCopy(card: CareerPoolCard, toSide: boolean) {
+    zoom.hide(); // the row under the pointer moves to the other list without a mouseleave
+    const at = pool.findIndex((candidate, index) => lower(candidate) === lower(card) && sideSet.has(index) !== toSide);
+    if (at < 0) return;
+    const label = toSide ? SIDEBOARD : columnOf(pool[at], doors);
+    save(placeIn(columns, at, label, columns.find((column) => column.label === label)!.items.length));
+  }
+
+  function build(): LimitedBuild {
+    const picks: Record<string, number> = {};
+    for (const card of deckCards) picks[lower(card)] = (picks[lower(card)] ?? 0) + 1;
+    return { picks, basics };
+  }
+
+  async function submit() {
+    setBusy(true);
+    try {
+      await submitQuickDraftDeck(buildDeck(build(), poolEntries(pool), `${run.setCode ?? ''} quick draft`.trim()));
+      notify('Deck saved', `${size} cards`);
+      onDone();
+    } catch (reason) {
+      notify("The deck wasn't accepted", reason instanceof Error ? reason.message : String(reason), 'error');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const hover = (card: CareerPoolCard) => zoom.handlers({ name: card.name, setCode: card.setCode, cardNumber: card.cardNumber });
+
+  return createPortal(
+    <div className={[draft.screen, styles.immersive, styles.screen, styles.builderScreen].join(' ')}>
+      <header className={[draft.top, styles.top].join(' ')}>
+        <div className={draft.where}>
+          <span className={draft.set}>{run.setName} · Quick Draft</span>
+          <h1 className={draft.title}>Build your deck <span>· {size} / {DECK_MIN}</span></h1>
+        </div>
+        <p className={styles.pass}>Drag cards into Sideboard to leave them out; add basic lands on the right.</p>
+        <div className={draft.topRight}>
+          {onCancel && <Button variant="quiet" size="sm" onClick={onCancel}>Keep the saved deck</Button>}
+        </div>
+      </header>
+
+      <div className={styles.builderPool}>
+        <PoolBoard
+          pool={pool}
+          columns={columns}
+          onPlace={(at, label, position) => save(placeIn(columns, at, label, position))}
+          hover={hover}
+          filter={filter}
+          doors={doors}
+          head={<h2 className={draft.picksLabel}>Your pool <span>{pool.length}</span></h2>}
+        />
+      </div>
+
+      <aside ref={listsRef} className={styles.lists} aria-label="Your deck">
+        <ManaCurve stats={stats} />
+        <CardList title="Deck" cards={deckCards} hint={`${size} / ${DECK_MIN} with basics`} action="−" actionLabel="Move to sideboard" onMove={(card) => moveCopy(card, true)} hover={hover} filter={filter} doors={doors} />
+        <section className={styles.basics} aria-label="Basic lands">
+          <header className={styles.listHead}>
+            <h2>Basic lands <span>{basicCount}</span></h2>
+            <button type="button" className={styles.suggest} onClick={() => {
+              const next = suggestBasics(build(), poolEntries(pool));
+              writeJson(basicsKey(id), next);
+              setBasics(next);
+            }}>
+              <WandSparkles size={14} aria-hidden="true" /> Suggest
+            </button>
+          </header>
+          <ul>
+            {BASIC_LANDS.map((land) => (
+              <li key={land} className={styles.row}>
+                <i className={`ms ms-cost ms-${SYMBOL[land]}`} aria-hidden="true" />
+                <span className={styles.rowName}>{land}</span>
+                <button type="button" className={styles.rowMove} aria-label={`One less ${land}`} disabled={basics[land] === 0} onClick={() => setBasic(land, -1)}><Minus size={13} /></button>
+                <b className={styles.basicCount}>{basics[land]}</b>
+                <button type="button" className={styles.rowMove} aria-label={`One more ${land}`} onClick={() => setBasic(land, 1)}><Plus size={13} /></button>
+              </li>
+            ))}
+          </ul>
+        </section>
+        <CardList title="Sideboard" cards={sideboard} hint={sideboard.length === 1 ? '1 card' : `${sideboard.length} cards`} action="+" actionLabel="Add to deck" onMove={(card) => moveCopy(card, false)} hover={hover} filter={filter} doors={doors} dim />
+        <div className={styles.saveRow}>
+          {size < DECK_MIN && <span className={styles.short}>{DECK_MIN - size} more to 40</span>}
+          <Button variant="decision" busy={busy} disabled={size < DECK_MIN} onClick={() => void submit()}>Use this deck</Button>
+        </div>
+      </aside>
+
+      <CardZoom shown={zoom.shown} bound={listsRef.current?.getBoundingClientRect().left} />
+    </div>,
+    document.body,
+  );
+}
