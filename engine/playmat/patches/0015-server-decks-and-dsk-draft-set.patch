--- /dev/null
+++ b/Mage.Server/src/test/java/mage/server/decks/SharedDeckFolderTest.java
@@ -0,0 +1,154 @@
+package mage.server.decks;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/** mtg-ai: the shared deck folder of a server without accounts. */
+public class SharedDeckFolderTest {
+
+    @TempDir
+    Path dir;
+
+    private SharedDeckFolder folder;
+
+    @BeforeEach
+    void setUp() {
+        folder = new SharedDeckFolder(dir, (name) -> {
+            switch (name) {
+                case "Plains":
+                case "Island":
+                    return new SharedDeckFolder.CardFacts("", true);
+                case "Fear of Isolation":
+                    return new SharedDeckFolder.CardFacts("U", false);
+                case "Splash Card":
+                    return new SharedDeckFolder.CardFacts("B", false);
+                default:
+                    return new SharedDeckFolder.CardFacts("W", false);
+            }
+        });
+    }
+
+    /** A 40-card DSK deck: 17 basics, 20 white cards, 3 blue ones (a splash by count). */
+    private static String dskDeck(String name, int whites) {
+        return "{\"name\":\"" + name + "\",\"format\":\"Constructed - Freeform\",\"cards\":["
+                + "{\"cardName\":\"Plains\",\"setCode\":\"DSK\",\"cardNumber\":\"272\",\"amount\":17},"
+                + "{\"cardName\":\"Toby, Beastie Befriender\",\"setCode\":\"DSK\",\"cardNumber\":\"35\",\"amount\":" + whites + "},"
+                + "{\"cardName\":\"Fear of Isolation\",\"setCode\":\"DSK\",\"cardNumber\":\"58\",\"amount\":3}],"
+                + "\"sideboard\":[{\"cardName\":\"Splash Card\",\"setCode\":\"DSK\",\"cardNumber\":\"1\",\"amount\":1}],\"updatedAt\":100}";
+    }
+
+    @Test
+    void storesEveryDeckAsFilesAndSharesThem() throws Exception {
+        assertThat(folder.put("d-1", "Mine", 100, dskDeck("Mine", 20)).stored).isTrue();
+        String dck = new String(Files.readAllBytes(dir.resolve("d-1.dck")), StandardCharsets.UTF_8);
+        assertThat(dck).startsWith("NAME:Mine\n").contains("17 [DSK:272] Plains\n").contains("SB: 1 [DSK:1] Splash Card\n");
+        assertThat(dir.resolve("d-1.json")).exists();
+        assertThat(dir.resolve("index.json")).exists();
+
+        // another folder object on the same files (another browser, a restarted server) sees the same deck
+        SharedDeckFolder again = new SharedDeckFolder(dir, (name) -> null);
+        List<DeckSyncEntry> list = again.list(200);
+        assertThat(list).hasSize(1);
+        assertThat(list.get(0).data).as("the list leaves data out").isNull();
+        assertThat(list.get(0).dskDraft).isTrue();
+        Map<String, Integer> main = new TreeMap<>();
+        main.put("Plains", 17);
+        main.put("Toby, Beastie Befriender", 20);
+        main.put("Fear of Isolation", 3);
+        assertThat(list.get(0).sig).isEqualTo(SharedDeckFolder.sig(main));
+        assertThat(again.get("d-1").data).contains("Toby");
+    }
+
+    @Test
+    void signsAsTheWebClient() {
+        // deckSig([{cardName: 'Island', amount: 40}]) in core/decks/deckStrength.ts
+        Map<String, Integer> islands = new TreeMap<>();
+        islands.put("Island", 40);
+        assertThat(SharedDeckFolder.sig(islands)).isEqualTo(fnv("40 Island"));
+    }
+
+    private static String fnv(String text) {
+        long hash = 0x811c9dc5L;
+        for (char c : text.toCharArray()) {
+            hash = ((hash ^ c) * 0x01000193L) & 0xffffffffL;
+        }
+        return String.format("%08x", hash);
+    }
+
+    @Test
+    void backsUpAFileBeforeOverwritingIt() throws Exception {
+        folder.put("d-1", "First", 100, dskDeck("First", 20));
+        folder.put("d-1", "Second", 200, dskDeck("Second", 20));
+        String backup = new String(Files.readAllBytes(dir.resolve("backup/d-1.dck")), StandardCharsets.UTF_8);
+        assertThat(backup).startsWith("NAME:First");
+        assertThat(dir.resolve("backup/" + LocalDate.now() + "/d-1.json")).exists();
+        assertThat(dir.resolve("backup/index.json")).exists();
+    }
+
+    @Test
+    void theNewerChangeWinsAndDeletionsMoveFilesAside() {
+        folder.put("d-1", "New", 300, dskDeck("New", 20));
+        DeckStore.DeckPutResult stale = folder.put("d-1", "Old", 200, dskDeck("Old", 20));
+        assertThat(stale.stored).isFalse();
+        assertThat(stale.updatedAt).isEqualTo(300);
+        assertThat(folder.delete("d-1", 250).stored).as("a change newer than the deletion stays").isFalse();
+
+        assertThat(folder.delete("d-1", 400).stored).isTrue();
+        assertThat(folder.get("d-1")).isNull();
+        assertThat(dir.resolve("d-1.dck")).doesNotExist();
+        assertThat(dir.resolve("deleted/400-d-1.dck")).exists();
+        DeckSyncEntry tombstone = folder.list(500).get(0);
+        assertThat(tombstone.deleted).isTrue();
+        assertThat(folder.list(400 + DeckStore.TOMBSTONE_MILLIS + 1)).as("old tombstones are dropped").isEmpty();
+    }
+
+    @Test
+    void refusesBadDecks() {
+        assertThatThrownBy(() -> folder.put("../x", "Bad", 1, dskDeck("Bad", 20))).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> folder.put("d-1", "Bad", 1, "not json")).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> folder.put("d-1", "Bad", 1, "{\"name\":\"x\"}")).isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void listsDskDecksForTheReviewAndKeepsTheirRatings() throws Exception {
+        folder.put("d-1", "Mine", 100, dskDeck("Mine", 20));
+        folder.put("d-2", "Short", 100, dskDeck("Short", 5)); // 25 cards: not a DSK Draft deck
+        JsonObject manifest = JsonParser.parseString(new String(Files.readAllBytes(dir.resolve("manifest.json")), StandardCharsets.UTF_8)).getAsJsonObject();
+        assertThat(manifest.getAsJsonArray("decks")).hasSize(1);
+        JsonObject d = manifest.getAsJsonArray("decks").get(0).getAsJsonObject();
+        assertThat(d.get("file").getAsString()).isEqualTo("d-1.dck");
+        assertThat(d.get("main_colors").getAsString()).isEqualTo("W");
+        assertThat(d.get("splash_colors").getAsString()).isEqualTo("U");
+        assertThat(d.getAsJsonObject("deck").get("Plains").getAsInt()).isEqualTo(17);
+        assertThat(d.has("rank") && d.has("user_win_rate_bucket")).as("review_decks.py reads them (null)").isTrue();
+
+        // play/review_decks.py rates it
+        d.add("review", JsonParser.parseString("{\"rating\": 4, \"archetype\": \"W aggro\"}"));
+        d.addProperty("tier", 1);
+        Files.write(dir.resolve("manifest.json"), manifest.toString().getBytes(StandardCharsets.UTF_8));
+        DeckSyncEntry rated = folder.list(200).stream().filter((e) -> e.id.equals("d-1")).findFirst().get();
+        assertThat(rated.strength.rating).isEqualTo(4);
+        assertThat(rated.strength.tier).isEqualTo(1);
+        assertThat(rated.strength.colors).isEqualTo("W");
+
+        // the review stays while the cards are the same (a rename), and goes when they change
+        folder.put("d-1", "Renamed", 200, dskDeck("Renamed", 20));
+        assertThat(folder.list(300).stream().filter((e) -> e.id.equals("d-1")).findFirst().get().strength.rating).isEqualTo(4);
+        folder.put("d-1", "Changed", 300, dskDeck("Changed", 21));
+        assertThat(folder.list(400).stream().filter((e) -> e.id.equals("d-1")).findFirst().get().strength).isNull();
+    }
+}
