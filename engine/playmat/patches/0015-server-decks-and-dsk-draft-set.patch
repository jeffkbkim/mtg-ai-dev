+import { describe, expect, it } from 'vitest';
+import { builderDskLabel, isDskDraftDeck, isDskStarterFile, playsAsFreeform } from './dskDraft';
+
+const dsk = (n: number, extra: { cardName: string; setCode?: string; amount: number }[] = []) => [
+  { cardName: 'Plains', setCode: 'M21', cardNumber: '260', amount: 17 },
+  { cardName: 'Fear of Isolation', setCode: 'DSK', cardNumber: '58', amount: n - 17 },
+  ...extra,
+];
+
+describe('DSK Draft (40) (mtg-ai)', () => {
+  it('takes a Freeform deck of 40+ DSK cards (basic lands from any set)', () => {
+    expect(isDskDraftDeck({ format: 'Constructed - Freeform', cards: dsk(40) })).toBe(true);
+    expect(isDskDraftDeck({ cards: dsk(41) })).toBe(true);
+    expect(isDskDraftDeck({ format: 'Constructed - Freeform', cards: [...dsk(40)].map((c) => ({ ...c, setCode: c.setCode?.toLowerCase() })) })).toBe(true);
+  });
+
+  it('leaves out short decks, other sets, unknown printings and other formats', () => {
+    expect(isDskDraftDeck({ format: 'Constructed - Freeform', cards: dsk(39) })).toBe(false);
+    expect(isDskDraftDeck({ cards: dsk(40, [{ cardName: 'Lightning Bolt', setCode: 'M10', amount: 1 }]) })).toBe(false);
+    expect(isDskDraftDeck({ cards: dsk(40, [{ cardName: 'Unknown Printing', amount: 1 }]) })).toBe(false);
+    expect(isDskDraftDeck({ format: 'Constructed - Standard', cards: dsk(40) })).toBe(false);
+    expect(isDskDraftDeck({ format: 'Variant Magic - Freeform Commander', cards: dsk(40) })).toBe(false);
+    expect(playsAsFreeform('Limited')).toBe(false);
+  });
+
+  it('names a new or growing DSK deck in the builder, and nothing else', () => {
+    expect(builderDskLabel({ format: 'Constructed - Freeform', cards: [] })).toBe('DSK Draft (40)');
+    expect(builderDskLabel({ format: 'Constructed - Freeform', cards: dsk(23) })).toBe('DSK Draft (40)');
+    expect(builderDskLabel({ format: 'Constructed - Freeform', cards: dsk(40, [{ cardName: 'Lightning Bolt', setCode: 'M10', amount: 1 }]) })).toBeNull();
+    expect(builderDskLabel({ format: 'Constructed - Modern', cards: [] })).toBeNull();
+  });
+
+  it('knows our starter files', () => {
+    expect(isDskStarterFile('dsk-good-08.dck')).toBe(true);
+    expect(isDskStarterFile('red.dck')).toBe(false);
+  });
+});
