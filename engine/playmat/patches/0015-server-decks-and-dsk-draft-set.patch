+package mage.server.websocket.api;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/** mtg-ai: the shared deck folder answers this computer and the home network only. */
+public class SharedDecksAccessTest {
+
+    @Test
+    void onlyTheHomeNetwork() {
+        assertThat(AccountApi.lanAddress("127.0.0.1")).isTrue();
+        assertThat(AccountApi.lanAddress("192.168.1.82")).isTrue();
+        assertThat(AccountApi.lanAddress("10.0.0.5")).isTrue();
+        assertThat(AccountApi.lanAddress("169.254.10.1")).isTrue();
+        assertThat(AccountApi.lanAddress("::1")).isTrue();
+        assertThat(AccountApi.lanAddress("fd12:3456::1")).isTrue();
+        assertThat(AccountApi.lanAddress("8.8.8.8")).isFalse();
+        assertThat(AccountApi.lanAddress("2001:4860:4860::8888")).isFalse();
+        assertThat(AccountApi.lanAddress("")).isFalse();
+        assertThat(AccountApi.lanAddress(null)).isFalse();
+    }
+}
