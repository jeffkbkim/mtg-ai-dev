+// mtg-ai: "DSK Draft" or "All" over the deck lists (Home and Decks; stores/decks.ts, inDeckSet)
+import { useT } from '../i18n';
+import { useDeckSet, useDecks, type DeckSet } from '../stores/decks';
+import styles from './DeckSetTabs.module.css';
+
+const SETS: { id: DeckSet; key: 'decks.set.dsk' | 'decks.set.all' }[] = [
+  { id: 'dsk', key: 'decks.set.dsk' },
+  { id: 'all', key: 'decks.set.all' },
+];
+
+/** Shown only while there are DSK decks (our dsk-* starters, or a saved DSK deck). */
+export function DeckSetTabs() {
+  const t = useT();
+  const shown = useDecks((state) => state.starters.some((starter) => starter.file.startsWith('dsk-')) || state.saved.some((deck) => deck.dskDraft));
+  const { set, choose } = useDeckSet();
+  if (!shown) return null;
+  return (
+    <span className={styles.tabs} role="radiogroup" aria-label={t('decks.set.label')} title={t('decks.set.detail')}>
+      {SETS.map((item) => (
+        <button
+          key={item.id}
+          type="button"
+          role="radio"
+          aria-checked={set === item.id}
+          className={[styles.tab, set === item.id ? styles.on : ''].join(' ')}
+          onClick={() => choose(item.id)}
+        >
+          {t(item.key)}
+        </button>
+      ))}
+    </span>
+  );
+}
