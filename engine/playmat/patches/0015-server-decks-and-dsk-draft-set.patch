+package mage.server.decks;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.apache.log4j.Logger;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.StandardCopyOption;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.function.Function;
+import java.util.regex.Pattern;
+
+/**
+ * mtg-ai: one shared set of web client decks for a server without accounts (Playmat on the Mac mini: anyone on the
+ * home network signs in with any name). The decks live as plain files in one folder (system property
+ * {@code mtgai.myDecksDir}, default ~/mtg-data/my-decks), so every browser sees the same decks:
+ * <ul>
+ * <li>{@code <id>.dck}: the deck as XMage deck text (NAME:, "N [SET:NUM] Name", "SB: ..."), for people and scripts;</li>
+ * <li>{@code <id>.json}: the web client's own deck (layouts, sideboard plans, change time), what the client syncs;</li>
+ * <li>{@code index.json}: every deck's id, name, change time and card signatures, deletions too (tombstones, 90 days);</li>
+ * <li>{@code manifest.json}: the 40-card DSK decks in play/review_decks.py's pool format ({"decks": [{file, deck,
+ * main_colors, splash_colors, ...}]}); the review, tier and stats that script adds are kept while a deck's cards stay
+ * the same, and are what the AI deck matcher reads (with {@code strengths.json} [{sig, strength}], when present, on top);</li>
+ * <li>{@code backup/<file>}: the previous version of every file this class overwrote, and {@code backup/<date>/<file>}
+ * the first version it replaced that day; {@code deleted/}: deleted decks' files (nothing is removed for good).</li>
+ * </ul>
+ * The sync protocol is the account deck sync's (DeckStore): the newer change wins; deletions travel as tombstones.
+ */
+public final class SharedDeckFolder {
+
+    private static final Logger logger = Logger.getLogger(SharedDeckFolder.class);
+
+    public static final String DIR_PROP = "mtgai.myDecksDir";
+    private static final Pattern DECK_ID = Pattern.compile("[A-Za-z0-9_:.-]{1,64}");
+    private static final Set<String> BASICS = new HashSet<>(Arrays.asList(
+            "Plains", "Island", "Swamp", "Mountain", "Forest", "Wastes", "Snow-Covered Plains", "Snow-Covered Island",
+            "Snow-Covered Swamp", "Snow-Covered Mountain", "Snow-Covered Forest")); // as core/decks/dskDraft.ts
+    private static final String WUBRG = "WUBRG";
+    /** review fields play/review_decks.py writes into a manifest entry; kept while the deck's cards don't change */
+    private static final List<String> REVIEW_FIELDS = Arrays.asList("review", "tier", "stats", "deck_score");
+
+    private static volatile SharedDeckFolder instance;
+
+    private final Path dir;
+    /** a card's colors ("WU", "" for colorless) and whether it is a land, by name; null when it isn't known */
+    private final Function<String, CardFacts> cards;
+    private final Gson gson = new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().serializeNulls().create(); // nulls: review_decks.py reads rank, user_win_rate_bucket
+
+    /** What the folder needs to know about a card to describe a deck for the deck review. */
+    public static class CardFacts {
+        public final String colors;
+        public final boolean land;
+
+        public CardFacts(String colors, boolean land) {
+            this.colors = colors;
+            this.land = land;
+        }
+    }
+
+    public SharedDeckFolder(Path dir, Function<String, CardFacts> cards) {
+        this.dir = dir;
+        this.cards = cards;
+    }
+
+    public static SharedDeckFolder get() {
+        SharedDeckFolder current = instance;
+        if (current == null) {
+            synchronized (SharedDeckFolder.class) {
+                current = instance;
+                if (current == null) {
+                    String configured = System.getProperty(DIR_PROP, "").trim();
+                    Path path = configured.isEmpty()
+                            ? Paths.get(System.getProperty("user.home"), "mtg-data", "my-decks")
+                            : Paths.get(configured);
+                    current = new SharedDeckFolder(path, SharedDeckFolder::repositoryFacts);
+                    instance = current;
+                    logger.info("mtg-ai: shared decks in " + path.toAbsolutePath());
+                }
+            }
+        }
+        return current;
+    }
+
+    public Path dir() {
+        return dir;
+    }
+
+    private static CardFacts repositoryFacts(String name) {
+        try {
+            mage.cards.repository.CardInfo info = mage.cards.repository.CardRepository.instance.findCard(name);
+            if (info == null) {
+                return null;
+            }
+            mage.ObjectColor color = info.getColor();
+            StringBuilder colors = new StringBuilder();
+            if (color.isWhite()) colors.append('W');
+            if (color.isBlue()) colors.append('U');
+            if (color.isBlack()) colors.append('B');
+            if (color.isRed()) colors.append('R');
+            if (color.isGreen()) colors.append('G');
+            return new CardFacts(colors.toString(), info.getTypes().contains(mage.constants.CardType.LAND));
+        } catch (RuntimeException | LinkageError e) {
+            return null;
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // the sync protocol
+
+    /** Every deck without its data, tombstones included (old ones dropped), each rated deck with its strength. */
+    public synchronized List<DeckSyncEntry> list(long now) {
+        Map<String, IndexEntry> index = readIndex();
+        boolean pruned = index.values().removeIf((entry) -> entry.deleted && entry.updatedAt < now - DeckStore.TOMBSTONE_MILLIS);
+        if (pruned) {
+            writeIndex(index);
+        }
+        Map<String, DeckSyncEntry.Strength> ratings = ratings();
+        List<DeckSyncEntry> entries = new ArrayList<>();
+        for (Map.Entry<String, IndexEntry> e : index.entrySet()) {
+            DeckSyncEntry entry = e.getValue().toSync(e.getKey());
+            entry.strength = entry.deleted || entry.sig == null ? null : ratings.get(entry.sig);
+            entries.add(entry);
+        }
+        return entries;
+    }
+
+    /** The deck with its data, or null when there is none (or it was deleted). */
+    public synchronized DeckSyncEntry get(String deckId) {
+        IndexEntry entry = readIndex().get(checkId(deckId));
+        if (entry == null || entry.deleted) {
+            return null;
+        }
+        DeckSyncEntry out = entry.toSync(deckId);
+        Path file = dir.resolve(stem(deckId) + ".json");
+        out.data = Files.exists(file) ? read(file) : null;
+        return out.data == null ? null : out;
+    }
+
+    public synchronized DeckStore.DeckPutResult put(String deckId, String name, long updatedAt, String data) {
+        checkId(deckId);
+        if (data == null || data.isEmpty()) {
+            throw new IllegalArgumentException("The deck is empty");
+        }
+        if (data.length() > DeckStore.MAX_DECK_CHARS) {
+            throw new IllegalArgumentException("The deck is too large to store (" + data.length() / 1024 + " KB)");
+        }
+        JsonObject deck;
+        try {
+            deck = JsonParser.parseString(data).getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IllegalArgumentException("The deck is not a web client deck");
+        }
+        if (!deck.has("cards") || !deck.get("cards").isJsonArray()) {
+            throw new IllegalArgumentException("The deck has no card list");
+        }
+        Map<String, IndexEntry> index = readIndex();
+        IndexEntry existing = index.get(deckId);
+        if (existing != null && existing.updatedAt > updatedAt) {
+            return new DeckStore.DeckPutResult(false, existing.updatedAt);
+        }
+        if (existing == null || existing.deleted) {
+            long live = index.values().stream().filter((entry) -> !entry.deleted).count();
+            if (live >= DeckStore.MAX_DECKS) {
+                throw new IllegalArgumentException("The shared deck folder holds up to " + DeckStore.MAX_DECKS + " decks");
+            }
+        }
+        IndexEntry entry = new IndexEntry();
+        entry.name = name == null ? "" : name.length() > 200 ? name.substring(0, 200) : name;
+        entry.updatedAt = updatedAt;
+        entry.deleted = false;
+        Map<String, Integer> main = counts(deck.get("cards"));
+        entry.sig = sig(main);
+        entry.sideboardSig = sig(counts(deck.get("sideboard")));
+        entry.dskDraft = dskDraft(deck, main);
+        entry.file = stem(deckId) + ".dck";
+        write(dir.resolve(stem(deckId) + ".json"), data);
+        write(dir.resolve(entry.file), dckText(entry.name, deck));
+        index.put(deckId, entry);
+        writeIndex(index);
+        writeManifest(index);
+        return new DeckStore.DeckPutResult(true, updatedAt);
+    }
+
+    /** Deletes a deck (its files move to deleted/), unless the folder has a version newer than the deletion. */
+    public synchronized DeckStore.DeckPutResult delete(String deckId, long deletedAt) {
+        checkId(deckId);
+        Map<String, IndexEntry> index = readIndex();
+        IndexEntry existing = index.get(deckId);
+        if (existing != null && existing.updatedAt > deletedAt) {
+            return new DeckStore.DeckPutResult(false, existing.updatedAt);
+        }
+        for (String name : new String[]{stem(deckId) + ".json", stem(deckId) + ".dck"}) {
+            Path file = dir.resolve(name);
+            if (Files.exists(file)) {
+                try {
+                    Path deleted = dir.resolve("deleted");
+                    Files.createDirectories(deleted);
+                    Files.move(file, deleted.resolve(deletedAt + "-" + name), StandardCopyOption.REPLACE_EXISTING);
+                } catch (IOException e) {
+                    throw new IllegalStateException("Couldn't move the deleted deck aside: " + e.getMessage(), e);
+                }
+            }
+        }
+        IndexEntry entry = new IndexEntry();
+        entry.name = existing == null ? "" : existing.name;
+        entry.updatedAt = deletedAt;
+        entry.deleted = true;
+        index.put(deckId, entry);
+        writeIndex(index);
+        writeManifest(index);
+        return new DeckStore.DeckPutResult(true, deletedAt);
+    }
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // the deck review's view of the folder
+
+    /** Rated decks by their main cards' signature: manifest.json reviews, then strengths.json on top. */
+    Map<String, DeckSyncEntry.Strength> ratings() {
+        Map<String, DeckSyncEntry.Strength> out = new LinkedHashMap<>();
+        JsonObject manifest = readJsonObject(dir.resolve("manifest.json"));
+        if (manifest != null && manifest.has("decks") && manifest.get("decks").isJsonArray()) {
+            for (JsonElement element : manifest.getAsJsonArray("decks")) {
+                if (!element.isJsonObject()) continue;
+                JsonObject d = element.getAsJsonObject();
+                JsonObject review = d.has("review") && d.get("review").isJsonObject() ? d.getAsJsonObject("review") : null;
+                if (review == null || !review.has("rating") || !d.has("sig")) continue;
+                DeckSyncEntry.Strength s = new DeckSyncEntry.Strength();
+                s.tier = d.has("tier") && d.get("tier").isJsonPrimitive() ? d.get("tier").getAsInt() : 1;
+                s.rating = review.get("rating").getAsInt();
+                s.colors = d.has("main_colors") ? d.get("main_colors").getAsString() : "";
+                out.put(d.get("sig").getAsString(), s);
+            }
+        }
+        Path strengths = dir.resolve("strengths.json");
+        if (Files.exists(strengths)) {
+            try {
+                for (JsonElement element : JsonParser.parseString(read(strengths)).getAsJsonArray()) {
+                    JsonObject e = element.getAsJsonObject();
+                    if (!e.has("sig") || !e.has("strength")) continue;
+                    out.put(e.get("sig").getAsString(), gson.fromJson(e.get("strength"), DeckSyncEntry.Strength.class));
+                }
+            } catch (RuntimeException e) {
+                logger.warn("mtg-ai: " + strengths + " can't be read: " + e.getMessage());
+            }
+        }
+        return out;
+    }
+
+    /** manifest.json: the DSK decks for the deck review; a review already there stays while the cards are the same. */
+    private void writeManifest(Map<String, IndexEntry> index) {
+        Path path = dir.resolve("manifest.json");
+        JsonObject old = readJsonObject(path);
+        Map<String, JsonObject> before = new LinkedHashMap<>();
+        if (old != null && old.has("decks") && old.get("decks").isJsonArray()) {
+            for (JsonElement element : old.getAsJsonArray("decks")) {
+                if (element.isJsonObject() && element.getAsJsonObject().has("file")) {
+                    before.put(element.getAsJsonObject().get("file").getAsString(), element.getAsJsonObject());
+                }
+            }
+        }
+        JsonObject manifest = old != null ? old : new JsonObject();
+        manifest.addProperty("source", "Playmat's shared decks (mage.server.decks.SharedDeckFolder): 40-card DSK decks, "
+                + "main_colors and splash_colors inferred from card colors (4+ nonland cards of a color: main)");
+        JsonArray decks = new JsonArray();
+        for (Map.Entry<String, IndexEntry> e : index.entrySet()) {
+            IndexEntry entry = e.getValue();
+            if (entry.deleted || !entry.dskDraft) continue;
+            JsonObject deck = readJsonObject(dir.resolve(stem(e.getKey()) + ".json"));
+            if (deck == null) continue;
+            Map<String, Integer> main = counts(deck.get("cards"));
+            String[] colors = colors(main);
+            JsonObject d = new JsonObject();
+            d.addProperty("file", entry.file);
+            d.addProperty("name", entry.name);
+            d.addProperty("sig", entry.sig);
+            d.addProperty("main_colors", colors[0]);
+            d.addProperty("splash_colors", colors[1]);
+            d.addProperty("colors_inferred", true);
+            d.add("rank", null);
+            d.add("user_win_rate_bucket", null);
+            JsonObject list = new JsonObject();
+            for (Map.Entry<String, Integer> card : main.entrySet()) list.addProperty(card.getKey(), card.getValue());
+            d.add("deck", list);
+            JsonObject previous = before.get(entry.file);
+            if (previous != null && previous.has("sig") && entry.sig.equals(previous.get("sig").getAsString())) {
+                for (String field : REVIEW_FIELDS) {
+                    if (previous.has(field)) d.add(field, previous.get(field));
+                }
+            }
+            decks.add(d);
+        }
+        manifest.add("decks", decks);
+        write(path, gson.toJson(manifest) + "\n");
+    }
+
+    /** Main and splash colors (WUBRG order): 4+ nonland cards of a color make it a main color, 1-3 a splash. */
+    String[] colors(Map<String, Integer> main) {
+        int[] count = new int[5];
+        for (Map.Entry<String, Integer> card : main.entrySet()) {
+            CardFacts facts = cards.apply(card.getKey());
+            if (facts == null || facts.land) continue;
+            for (char c : facts.colors.toCharArray()) {
+                int i = WUBRG.indexOf(c);
+                if (i >= 0) count[i] += card.getValue();
+            }
+        }
+        StringBuilder mainColors = new StringBuilder();
+        StringBuilder splash = new StringBuilder();
+        for (int i = 0; i < 5; i++) {
+            if (count[i] >= 4) mainColors.append(WUBRG.charAt(i));
+            else if (count[i] > 0) splash.append(WUBRG.charAt(i));
+        }
+        return new String[]{mainColors.toString(), splash.toString()};
+    }
+
+    /** A Freeform deck of 40+ main cards, all of them DSK printings (basic lands from any set). */
+    static boolean dskDraft(JsonObject deck, Map<String, Integer> main) {
+        String format = deck.has("format") && deck.get("format").isJsonPrimitive() ? deck.get("format").getAsString() : "";
+        if (!format.isEmpty() && (!format.contains("Freeform") || format.contains("Commander"))) return false;
+        int total = main.values().stream().mapToInt(Integer::intValue).sum();
+        if (total < 40) return false;
+        for (JsonElement element : deck.getAsJsonArray("cards")) {
+            JsonObject card = element.getAsJsonObject();
+            String name = card.has("cardName") ? card.get("cardName").getAsString() : "";
+            String set = card.has("setCode") && card.get("setCode").isJsonPrimitive() ? card.get("setCode").getAsString() : "";
+            if (!BASICS.contains(name) && !"DSK".equalsIgnoreCase(set)) return false;
+        }
+        return true;
+    }
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // cards, signatures, deck text
+
+    /** Copies by card name, in name order. */
+    static Map<String, Integer> counts(JsonElement list) {
+        Map<String, Integer> counts = new TreeMap<>();
+        if (list == null || !list.isJsonArray()) return counts;
+        for (JsonElement element : list.getAsJsonArray()) {
+            if (!element.isJsonObject()) continue;
+            JsonObject card = element.getAsJsonObject();
+            if (!card.has("cardName")) continue;
+            int amount = card.has("amount") ? card.get("amount").getAsInt() : 1;
+            counts.merge(card.get("cardName").getAsString(), amount, Integer::sum);
+        }
+        return counts;
+    }
+
+    /** FNV-1a over "amount name" lines sorted by name, as the web client's deckSig (core/decks/deckStrength.ts). */
+    static String sig(Map<String, Integer> counts) {
+        StringBuilder text = new StringBuilder();
+        for (Map.Entry<String, Integer> e : counts.entrySet()) {
+            if (text.length() > 0) text.append('|');
+            text.append(e.getValue()).append(' ').append(e.getKey());
+        }
+        int hash = 0x811c9dc5;
+        for (int i = 0; i < text.length(); i++) {
+            hash ^= text.charAt(i);
+            hash *= 0x01000193;
+        }
+        return String.format(Locale.ROOT, "%08x", hash);
+    }
+
+    static String dckText(String name, JsonObject deck) {
+        StringBuilder out = new StringBuilder("NAME:").append(name.replace('\n', ' ')).append('\n');
+        appendCards(out, deck.get("cards"), "");
+        appendCards(out, deck.get("sideboard"), "SB: ");
+        return out.toString();
+    }
+
+    private static void appendCards(StringBuilder out, JsonElement list, String prefix) {
+        if (list == null || !list.isJsonArray()) return;
+        for (JsonElement element : list.getAsJsonArray()) {
+            if (!element.isJsonObject()) continue;
+            JsonObject card = element.getAsJsonObject();
+            if (!card.has("cardName")) continue;
+            String set = card.has("setCode") && card.get("setCode").isJsonPrimitive() ? card.get("setCode").getAsString() : "";
+            String number = card.has("cardNumber") && card.get("cardNumber").isJsonPrimitive() ? card.get("cardNumber").getAsString() : "";
+            out.append(prefix).append(card.has("amount") ? card.get("amount").getAsInt() : 1).append(' ');
+            if (!set.isEmpty()) out.append('[').append(set).append(':').append(number).append("] ");
+            out.append(card.get("cardName").getAsString()).append('\n');
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------------------------
+    // files
+
+    /** One line of index.json. */
+    static class IndexEntry {
+        String name;
+        long updatedAt;
+        boolean deleted;
+        String file;
+        String sig;
+        String sideboardSig;
+        boolean dskDraft;
+
+        DeckSyncEntry toSync(String id) {
+            DeckSyncEntry out = new DeckSyncEntry();
+            out.id = id;
+            out.name = name;
+            out.updatedAt = updatedAt;
+            out.deleted = deleted;
+            out.sig = deleted ? null : sig;
+            out.sideboardSig = deleted ? null : sideboardSig;
+            out.dskDraft = deleted ? null : dskDraft;
+            return out;
+        }
+    }
+
+    private static class Index {
+        Map<String, IndexEntry> decks = new LinkedHashMap<>();
+    }
+
+    private Map<String, IndexEntry> readIndex() {
+        Path path = dir.resolve("index.json");
+        if (!Files.exists(path)) return new LinkedHashMap<>();
+        try {
+            Index index = gson.fromJson(read(path), Index.class);
+            return index == null || index.decks == null ? new LinkedHashMap<>() : index.decks;
+        } catch (RuntimeException e) {
+            // never start over silently: a broken index would forget every deck
+            throw new IllegalStateException("The shared deck index can't be read (" + path + "): " + e.getMessage(), e);
+        }
+    }
+
+    private void writeIndex(Map<String, IndexEntry> decks) {
+        Index index = new Index();
+        index.decks = decks;
+        write(dir.resolve("index.json"), gson.toJson(index) + "\n");
+    }
+
+    private JsonObject readJsonObject(Path path) {
+        if (!Files.exists(path)) return null;
+        try {
+            JsonElement element = JsonParser.parseString(read(path));
+            return element.isJsonObject() ? element.getAsJsonObject() : null;
+        } catch (RuntimeException e) {
+            logger.warn("mtg-ai: " + path + " can't be read: " + e.getMessage());
+            return null;
+        }
+    }
+
+    private static String read(Path path) {
+        try {
+            return new String(Files.readAllBytes(path), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            throw new IllegalStateException("Couldn't read " + path + ": " + e.getMessage(), e);
+        }
+    }
+
+    /**
+     * Writes a file through a temporary one; an existing file is first copied to backup/ (the previous version) and,
+     * the first time each day, to backup/<date>/.
+     */
+    private void write(Path path, String text) {
+        try {
+            Files.createDirectories(dir);
+            if (Files.exists(path)) {
+                byte[] old = Files.readAllBytes(path);
+                if (Arrays.equals(old, text.getBytes(StandardCharsets.UTF_8))) return;
+                Path backup = dir.resolve("backup");
+                Path daily = backup.resolve(LocalDate.now().toString());
+                Files.createDirectories(daily);
+                Files.copy(path, backup.resolve(path.getFileName()), StandardCopyOption.REPLACE_EXISTING);
+                if (!Files.exists(daily.resolve(path.getFileName()))) {
+                    Files.copy(path, daily.resolve(path.getFileName()));
+                }
+            }
+            Path tmp = path.resolveSibling(path.getFileName() + ".tmp");
+            Files.write(tmp, text.getBytes(StandardCharsets.UTF_8));
+            Files.move(tmp, path, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        } catch (IOException e) {
+            throw new IllegalStateException("Couldn't write " + path + ": " + e.getMessage(), e);
+        }
+    }
+
+    /** A deck id as a file name (ids are UUIDs; anything else outside [A-Za-z0-9_-] becomes "_"). */
+    static String stem(String deckId) {
+        return deckId.replaceAll("[^A-Za-z0-9_-]", "_");
+    }
+
+    private static String checkId(String deckId) {
+        if (deckId == null || !DECK_ID.matcher(deckId).matches()) {
+            throw new IllegalArgumentException("Bad deck id");
+        }
+        return deckId;
+    }
+}
