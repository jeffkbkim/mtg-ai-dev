@@ -72,3 +72,34 @@ export function planSync(
   }
   return plan;
 }
+
+/** mtg-ai: a deck as the shared deck folder's one-time import compares them: its main cards' and sideboard's deckSig. */
+export interface DeckCards {
+  id: string;
+  sig?: string | null;
+  sideboardSig?: string | null;
+  deleted?: boolean;
+}
+
+/**
+ * mtg-ai: the first sync of this browser with a server's shared deck folder (no accounts: one set of decks for every
+ * browser). Every deck here goes to the folder, except one whose cards (main and sideboard) are already there under
+ * another id: that one is a duplicate, and this browser takes the folder's deck instead (`keptId`). Two decks here with
+ * the same cards are both kept (the player made both). Decks without a signature are always kept.
+ */
+export function planSharedImport(local: readonly DeckCards[], remote: readonly DeckCards[]): { duplicates: { id: string; keptId: string }[] } {
+  const remoteIds = new Set(remote.map((deck) => deck.id));
+  const byCards = new Map<string, string>();
+  for (const deck of remote) {
+    if (deck.deleted || !deck.sig) continue;
+    const key = `${deck.sig}/${deck.sideboardSig ?? ''}`;
+    if (!byCards.has(key)) byCards.set(key, deck.id);
+  }
+  const duplicates: { id: string; keptId: string }[] = [];
+  for (const deck of local) {
+    if (remoteIds.has(deck.id) || !deck.sig) continue;
+    const keptId = byCards.get(`${deck.sig}/${deck.sideboardSig ?? ''}`);
+    if (keptId) duplicates.push({ id: deck.id, keptId });
+  }
+  return { duplicates };
+}
