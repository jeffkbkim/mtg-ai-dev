new file mode 100644
index 0000000000..e46ad80f6e
--- /dev/null
+++ b/Mage.Web.Client/src/core/decks/dskDraft.ts
@@ -0,0 +1,45 @@
+import type { DeckCardInfo } from './types';
+
+/**
+ * mtg-ai: "DSK Draft (40)": our 40-card DSK Limited decks as one set: the dsk-* starters, saved copies of them, and
+ * decks built from DSK cards only (basic lands from any set) with 40 or more main cards. It is a label and a filter in
+ * the client only: such a deck's XMage deck type stays Freeform ('Constructed - Freeform'), so tables take it as before.
+ */
+export const DSK_DRAFT_LABEL = 'DSK Draft (40)';
+export const DSK_DRAFT_SIZE = 40;
+
+const BASICS = new Set(['Plains', 'Island', 'Swamp', 'Mountain', 'Forest', 'Wastes', 'Snow-Covered Plains', 'Snow-Covered Island',
+  'Snow-Covered Swamp', 'Snow-Covered Mountain', 'Snow-Covered Forest']);
+
+/** The deck type a DSK Draft deck plays as (Freeform, or no type, which is Freeform). */
+export function playsAsFreeform(format: string | null | undefined): boolean {
+  return !format || /Freeform/.test(format) && !/Commander/.test(format);
+}
+
+/** Every card a DSK printing or a basic land (an empty list too). A card without a set code is not known to be DSK. */
+export function onlyDskCards(cards: readonly DeckCardInfo[]): boolean {
+  return cards.every((card) => BASICS.has(card.cardName) || (card.setCode ?? '').toUpperCase() === 'DSK');
+}
+
+/** 40+ main cards, every one a DSK printing or a basic land. */
+export function isDskCards(cards: readonly DeckCardInfo[]): boolean {
+  return onlyDskCards(cards) && cards.reduce((total, card) => total + card.amount, 0) >= DSK_DRAFT_SIZE;
+}
+
+/**
+ * The deck builder's name for a Freeform deck made of DSK cards so far (a new deck too): "DSK Draft (40)", the deck
+ * type staying Freeform; null for any other deck.
+ */
+export function builderDskLabel(deck: { format?: string | null; cards: readonly DeckCardInfo[] }): string | null {
+  return playsAsFreeform(deck.format) && onlyDskCards(deck.cards) ? DSK_DRAFT_LABEL : null;
+}
+
+/** A deck of the DSK Draft (40) set: a Freeform deck made of DSK cards (isDskCards). */
+export function isDskDraftDeck(deck: { format?: string | null; cards: readonly DeckCardInfo[] }): boolean {
+  return playsAsFreeform(deck.format) && isDskCards(deck.cards);
+}
+
+/** One of our DSK starter files (dsk_starters.py names them dsk-*.dck). */
+export function isDskStarterFile(file: string): boolean {
+  return file.startsWith('dsk-');
+}
