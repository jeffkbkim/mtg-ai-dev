diff --git a/Mage.Web.Client/src/core/game/costUses.test.ts b/Mage.Web.Client/src/core/game/costUses.test.ts
new file mode 100644
index 0000000000..48a573a0d8
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/costUses.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest';
+import { parseChatMessage, type LogEntry } from './gameLog';
+import { costUses } from './costUses';
+
+const line = (html: string, i: number): LogEntry => parseChatMessage({ message: html, messageType: 'GAME' } as never, `k${i}`)!;
+const p = (name: string) => `<font color='#20B2AA'>${name}</font>`;
+const c = (name: string, id?: string) => `<font color='#90EE90'${id ? ` object_id='${id}'` : ''}>${name}</font>`;
+
+describe('costUses', () => {
+  it('reads a reveal named by its source, and the same reveal from hand only once', () => {
+    const uses = costUses([
+      line(`${p('kimster')} reveals ${c('Fear of the Dark', 'fd')} [fd1] from their hand`, 0),
+      line(`${p('kimster')} reveals ${c('Fear of the Dark')} (source: ${c('Monstrous Emergence', 'me')} [me1])`, 1),
+      line(`${p('kimster')} casts ${c('Monstrous Emergence', 'me')} [me1] targeting ${c('Bear', 'b')} [b11] from hand`, 2),
+    ]);
+    expect(uses.get('me')).toEqual([{ name: 'Fear of the Dark', objectId: 'fd', how: 'revealed' }]);
+  });
+
+  it('gives a chosen creature to the next spell its player casts', () => {
+    const uses = costUses([
+      line(`${p('Claude AI')} chooses ${c('Shroudstomper', 'ss')} [ss1] on the battlefield`, 0),
+      line(`${p('Claude AI')} casts ${c('Monstrous Emergence', 'm2')} [m21] targeting ${c('Bear', 'b')} [b11] from hand`, 1),
+    ]);
+    expect(uses.get('m2')).toEqual([{ name: 'Shroudstomper', objectId: 'ss', how: 'chosen' }]);
+  });
+
+  it('reads a sacrifice cost', () => {
+    const uses = costUses([line(`${p('Claude AI')} sacrificed ${c('Disturbing Mirth', 'dm')} [dm1] (source: ${c('Final Vengeance', 'fv')} [fv1])`, 0)]);
+    expect(uses.get('fv')).toEqual([{ name: 'Disturbing Mirth', objectId: 'dm', how: 'sacrificed' }]);
+  });
+});
diff --git a/Mage.Web.Client/src/core/game/costUses.ts b/Mage.Web.Client/src/core/game/costUses.ts
new file mode 100644
index 0000000000..93156abcec
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/costUses.ts
@@ -0,0 +1,61 @@
+import type { LogEntry, LogSegment } from './gameLog';
+
+/**
+ * mtg-ai: what a spell's additional cost used, read from the engine's game log: "kimster reveals Fear of the Dark
+ * (source: Monstrous Emergence)", "… sacrificed Disturbing Mirth (source: Final Vengeance)", and, for a cost that
+ * names no source ("… chooses Bear on the battlefield", "… reveals Bear from their hand"), the next spell that player
+ * casts. By the spell's card id (the object id the log gives the spell), newest last.
+ */
+export interface CostUse {
+  name: string;
+  /** the used card's object id, when the log gives it */
+  objectId: string | null;
+  how: 'revealed' | 'chosen' | 'sacrificed';
+}
+
+const VERB: [RegExp, CostUse['how']][] = [[/ reveals /, 'revealed'], [/ chooses /, 'chosen'], [/ sacrificed /, 'sacrificed']];
+
+type CardSegment = Extract<LogSegment, { kind: 'card' }>;
+
+export function costUses(entries: readonly LogEntry[]): Map<string, CostUse[]> {
+  const out = new Map<string, CostUse[]>();
+  const pending = new Map<string, CostUse[]>();
+  for (const entry of entries) {
+    if (entry.tone !== 'game') continue;
+    const player = entry.segments.find((segment) => segment.kind === 'player');
+    const cards = entry.segments.filter((segment): segment is CardSegment => segment.kind === 'card');
+    if (!player || player.kind !== 'player' || cards.length === 0) continue;
+    const how = VERB.find(([pattern]) => pattern.test(entry.text))?.[1];
+    if (how) {
+      const sourceAt = entry.text.indexOf('(source: ');
+      const used = cards[0];
+      const use: CostUse = { name: used.name, objectId: used.objectId, how };
+      if (sourceAt >= 0 && cards.length > 1) {
+        const source = cards[cards.length - 1].objectId;
+        if (source) {
+          const list = out.get(source) ?? [];
+          // the same card revealed twice (the reveal and its cost line): once
+          if (!list.some((u) => u.name === use.name && u.how === use.how)) out.set(source, [...list, use]);
+        }
+      } else if (/ on the battlefield| from (their|his|her) hand/.test(entry.text)) {
+        pending.set(player.name, [...(pending.get(player.name) ?? []), use]);
+      }
+      continue;
+    }
+    if (/ casts /.test(entry.text)) {
+      const spell = cards[0].objectId;
+      const waiting = pending.get(player.name);
+      pending.delete(player.name);
+      if (spell && waiting) {
+        const list = out.get(spell) ?? [];
+        for (const use of waiting) {
+          const same = list.find((u) => u.name === use.name && u.how === use.how);
+          if (same) same.objectId ??= use.objectId;
+          else list.push(use);
+        }
+        out.set(spell, list);
+      }
+    }
+  }
