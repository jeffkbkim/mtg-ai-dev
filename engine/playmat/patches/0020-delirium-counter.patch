+/**
+ * mtg-ai: how far a player's graveyard is toward delirium ("Delirium 2/4"), for players with a delirium card in sight;
+ * lit at four card types. Hover lists the types counted.
+ */
+function DeliriumCount({ playerId }: { playerId: string }) {
+  const board = useContext(ConditionContext);
+  if (!board.deliriumPlayers.has(playerId)) return null;
+  const types = board.graveyards.get(playerId)?.types ?? [];
+  const on = types.length >= 4;
+  const listed = types.length > 0 ? types.map((type) => type.toLowerCase()).join(', ') : 'no card types yet';
+  return (
+    <span
+      className={[styles.delirium, on ? styles.deliriumOn : ''].join(' ')}
+      title={`Delirium ${on ? 'is on' : 'needs four card types'}: ${listed}`}
+      aria-label={`Delirium ${Math.min(types.length, 4)} of 4: ${listed}`}
+    >
+      Delirium {Math.min(types.length, 4)}/4
+    </span>
+  );
+}
