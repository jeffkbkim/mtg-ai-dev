@@ -0,0 +1,33 @@
+import { readFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { DeckSerializer } from './DeckSerializer';
+import { deckSig, matchingStarters, strengthOf, UNRATED, type StrengthEntry } from './deckStrength';
+
+const dir = new URL('../../../public/starter-decks/', import.meta.url);
+const index = JSON.parse(readFileSync(new URL('index.json', dir), 'utf8')) as (StrengthEntry & { file: string })[];
+const ours = index.filter((entry) => entry.file.startsWith('dsk-'));
+
+describe('deck strength (mtg-ai)', () => {
+  it('signs a starter as dsk_starters.py does', () => {
+    if (ours.length === 0) return; // a checkout without our decks
+    for (const entry of ours.slice(0, 20)) {
+      const deck = DeckSerializer.importDeck(readFileSync(new URL(entry.file, dir), 'utf8'));
+      expect(deckSig(deck.cards)).toBe(entry.sig);
+    }
+  });
+
+  it('matches the same tier and rating, never the player\'s own deck', () => {
+    if (ours.length === 0) return;
+    const mine = ours.find((entry) => entry.strength?.tier === 2)!;
+    const deck = DeckSerializer.importDeck(readFileSync(new URL(mine.file, dir), 'utf8'));
+    const { strength, how, sig } = strengthOf(deck.cards, ours);
+    expect(how).toBe('starter');
+    const { pool, rule } = matchingStarters(ours, strength, sig);
+    expect(rule).toMatch(/^same tier and rating/);
+    expect(pool.every((entry) => entry.strength!.tier === 2 && entry.strength!.rating === strength.rating && entry.sig !== sig)).toBe(true);
+  });
+
+  it('takes a deck it does not know as average', () => {
+    expect(strengthOf([{ cardName: 'Island', amount: 40 }], ours).strength).toEqual(UNRATED);
+  });
+});
diff --git a/Mage.Web.Client/src/core/decks/deckStrength.ts b/Mage.Web.Client/src/core/decks/deckStrength.ts
