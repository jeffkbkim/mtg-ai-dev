index 0000000000..ef05623881
--- /dev/null
+++ b/Mage.Web.Client/src/core/decks/deckStrength.ts
@@ -0,0 +1,64 @@
+import type { DeckCardInfo } from './types';
+
+/**
+ * mtg-ai: how strong a DSK starter deck is, from our deck review (engine/playmat/dsk_starters.py writes it into
+ * starter-decks/index.json): tier 2 (★★), 1 (★) or 0 (no star), the review's rating out of 5, and its main colors.
+ */
+export interface DeckStrength {
+  tier: number;
+  rating: number | null;
+  colors: string;
+}
+
+export interface StrengthEntry {
+  file: string;
+  name: string;
+  strength?: DeckStrength;
+  /** deckSig of the deck's main cards, to recognise a saved copy of a starter */
+  sig?: string;
+}
+
+/** A deck the player built or changed: no review, so it is taken as an average deck. */
+export const UNRATED: DeckStrength = { tier: 1, rating: 3, colors: '' };
+
+/** FNV-1a over "amount name" lines sorted by name (the same as dsk_starters.py's deck_sig). */
+export function deckSig(cards: DeckCardInfo[]): string {
+  const counts = new Map<string, number>();
+  for (const card of cards) counts.set(card.cardName, (counts.get(card.cardName) ?? 0) + card.amount);
+  const text = [...counts.entries()].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)).map(([name, n]) => `${n} ${name}`).join('|');
+  let hash = 0x811c9dc5;
+  for (let i = 0; i < text.length; i++) {
+    hash ^= text.charCodeAt(i);
+    hash = Math.imul(hash, 0x01000193) >>> 0;
+  }
+  return hash.toString(16).padStart(8, '0');
+}
+
+/** The player's deck's strength: the starter it is (or a saved copy of), else UNRATED. */
+export function strengthOf(cards: DeckCardInfo[], starters: readonly StrengthEntry[]): { strength: DeckStrength; how: 'starter' | 'unrated'; sig: string } {
+  const sig = deckSig(cards);
+  const same = starters.find((starter) => starter.sig === sig && starter.strength);
+  return same?.strength ? { strength: same.strength, how: 'starter', sig } : { strength: UNRATED, how: 'unrated', sig };
+}
+
+/**
+ * Starters the AI may be dealt against a deck of this strength, and the rule that picked them: the same tier and
+ * rating, else the same rating, else a rating one away; a different color pair when there is enough choice. Never the
+ * player's own deck.
+ */
+export function matchingStarters<T extends StrengthEntry>(starters: readonly T[], strength: DeckStrength, ownSig: string): { pool: T[]; rule: string } {
+  const rated = starters.filter((starter) => starter.strength?.rating != null && starter.sig !== ownSig);
+  const rating = strength.rating ?? 3;
+  const steps: [string, (s: DeckStrength) => boolean][] = [
+    ['same tier and rating', (s) => s.tier === strength.tier && s.rating === rating],
+    ['same rating', (s) => s.rating === rating],
+    ['rating within 1', (s) => Math.abs((s.rating ?? 3) - rating) <= 1],
+  ];
+  for (const [rule, fits] of steps) {
+    const pool = rated.filter((starter) => fits(starter.strength!));
+    if (pool.length < 3) continue;
+    const other = pool.filter((starter) => starter.strength!.colors !== strength.colors);
+    return other.length >= 3 ? { pool: other, rule: `${rule}, other colors` } : { pool, rule };
+  }
+  return { pool: rated, rule: 'any rated deck (too few close matches)' };
+}
