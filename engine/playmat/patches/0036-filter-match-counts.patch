@@ -0,0 +1,33 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+import { describe, expect, test, vi } from 'vitest';
+import { COLOR_BOXES, TYPE_BOXES, type CardFilter } from './filter';
+import { FilterBar } from './PoolBoard';
+
+// mtg-ai: each box shows how many pool cards it keeps, and an active filter says how many match
+function fakeFilter(active: boolean): CardFilter {
+  const zeros = <K extends string>(keys: readonly K[]) => Object.fromEntries(keys.map((key) => [key, 0])) as Record<K, number>;
+  return {
+    state: { types: active ? ['Creature'] : [], colors: [], hide: false },
+    active,
+    matches: () => true,
+    typeCounts: { ...zeros(TYPE_BOXES), Creature: 13 },
+    colorCounts: { ...zeros(COLOR_BOXES), G: 9 },
+    matching: 13,
+    total: 42,
+    toggleType: vi.fn(),
+    toggleColor: vi.fn(),
+    setHide: vi.fn(),
+    clear: vi.fn(),
+  };
+}
+
+describe('FilterBar', () => {
+  test('shows each box count, and how many match when a filter is on', () => {
+    const { rerender } = render(<FilterBar filter={fakeFilter(false)} />);
+    expect(screen.getByText('Creature').parentElement?.textContent).toContain('13');
+    expect(screen.queryByRole('status')).toBeNull();
+    rerender(<FilterBar filter={fakeFilter(true)} />);
+    expect(screen.getByRole('status').textContent).toBe('13 of 42 match');
+    fireEvent.click(screen.getByRole('button', { name: 'Clear' }));
+  });
+});
