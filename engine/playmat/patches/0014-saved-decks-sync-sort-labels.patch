+++ b/Mage.Web.Client/src/core/decks/starterCopies.test.ts
@@ -0,0 +1,125 @@
+// mtg-ai: saved copies of our DSK starters (starterCopies.ts)
+import { describe, expect, test } from 'vitest';
+import type { StrengthEntry } from './deckStrength';
+import { copyLabel, copyOf, planStarterSync, sortByStanding, standingOf, type SavedCopy } from './starterCopies';
+
+const starter = (name: string, tier: number, rating: number, sig: string): StrengthEntry =>
+  ({ file: `dsk-${sig}.dck`, name, strength: { tier, rating, colors: 'WU' }, sig });
+const STARTERS = [
+  starter('★★ good_08 · WU eerie enchantments/tempo · review 4/5', 2, 4, 'g08'),
+  starter('★ good_57 · RW go-wide aggro · review 4/5', 1, 4, 'g57'),
+  starter('trophy_00 · UB', 0, 3, 't00'),
+];
+const STRENGTHS: StrengthEntry[] = [
+  { file: '', sig: 'g00', name: 'good_00', listed: false, strength: { tier: 0, rating: 2, colors: 'WUG' } },
+  { file: '', sig: 'g15', name: 'good_15', listed: false, strength: { tier: 0, rating: 3, colors: 'UG' } },
+  { file: '', sig: 'g99', name: 'good_99', listed: true, strength: { tier: 1, rating: 3, colors: 'WR' } },
+  { file: '', sig: 'g08', name: 'good_08', listed: true, strength: { tier: 2, rating: 4, colors: 'WU' } },
+];
+
+describe('copyOf', () => {
+  test('a listed starter by its cards, else a retired rated deck, else nothing', () => {
+    expect(copyOf('g08', STARTERS, STRENGTHS)).toMatchObject({ kind: 'starter', starter: { name: STARTERS[0].name } });
+    expect(copyOf('g00', STARTERS, STRENGTHS)).toMatchObject({ kind: 'retired', reason: 'colour' });
+    // two main colours but not listed (a heavy splash): the reason is not known here
+    expect(copyOf('g15', STARTERS, STRENGTHS)).toMatchObject({ kind: 'retired', reason: null });
+    // rated, said to be listed, yet not among today's starters
+    expect(copyOf('g99', STARTERS, STRENGTHS)).toMatchObject({ kind: 'retired', reason: null });
+    expect(copyOf('mine', STARTERS, STRENGTHS)).toBeNull();
+    expect(copyOf(undefined, STARTERS, STRENGTHS)).toBeNull();
+  });
+
+  test('nothing is retired while the starters are not known', () => {
+    expect(copyOf('g00', [], STRENGTHS)).toBeNull();
+  });
+});
+
+describe('copyLabel', () => {
+  test('says whose copy it is and of what, with the card count', () => {
+    const label = (sig: string) => copyLabel(copyOf(sig, STARTERS, STRENGTHS), '40 cards');
+    expect(label('g08')).toBe('Your copy · ★★ starter · 40 cards');
+    expect(label('g57')).toBe('Your copy · ★ starter · 40 cards');
+    expect(label('t00')).toBe('Your copy · starter · 40 cards');
+    expect(label('g00')).toBe('Retired: breaks the colour rule');
+    expect(label('g15')).toBe('Retired');
+    expect(label('mine')).toBeNull();
+  });
+});
+
+describe('sortByStanding', () => {
+  test('★★, ★, the rest, retired; then rating; then the given order', () => {
+    const decks = [
+      { name: 'retired 5/5', s: standingOf({ tier: 2, rating: 5, colors: '' }, true) },
+      { name: 'mine', s: standingOf(null) },
+      { name: 'trophy 4/5', s: standingOf({ tier: 0, rating: 4, colors: '' }) },
+      { name: '★ 3/5', s: standingOf({ tier: 1, rating: 3, colors: '' }) },
+      { name: '★★ 4/5 a', s: standingOf({ tier: 2, rating: 4, colors: '' }) },
+      { name: '★ 4/5', s: standingOf({ tier: 1, rating: 4, colors: '' }) },
+      { name: '★★ 4/5 b', s: standingOf({ tier: 2, rating: 4, colors: '' }) },
+    ];
+    expect(sortByStanding(decks, (deck) => deck.s).map((deck) => deck.name)).toEqual([
+      '★★ 4/5 a', '★★ 4/5 b', '★ 4/5', '★ 3/5', 'trophy 4/5', 'mine', 'retired 5/5',
+    ]);
+  });
+});
+
+describe('planStarterSync', () => {
+  const copy = (id: string, name: string, sig: string | undefined, updatedAt: number, extra: Partial<SavedCopy> = {}): SavedCopy =>
+    ({ id, name, sig, updatedAt, sideboardCount: 0, ...extra });
+  // the owner's library: three copies of trophy_00 under its old name, a retired good_00, a current good_57, his own
+  const OWNER = [
+    copy('t-old', 'DSK TROPHY_00 (7-2, UB)', 't00', 100),
+    copy('t-new', 'DSK TROPHY_00 (7-2, UB)', 't00', 300),
+    copy('t-mid', 'DSK TROPHY_00 (7-2, UB)', 't00', 200),
+    copy('g00', '★ GOOD_00 · 58.6% · WUG+B · 7-2 PLAT', 'g00', 150),
+    copy('g57', STARTERS[1].name, 'g57', 50),
+    copy('edited', '★★ good_08 · WU eerie enchantments/tempo · review 4/5', 'changed', 400),
+  ];
+
+  test('dedupes, renames to today\'s names, keeps retired names, never touches an edited deck', () => {
+    const plan = planStarterSync(OWNER, STARTERS, STRENGTHS, 't-old', { 't-old': '#5a2320', 't-mid': '#1f2a44' });
+    expect(plan.removals).toEqual([{ id: 't-mid', keptId: 't-new' }, { id: 't-old', keptId: 't-new' }]);
+    expect(plan.renames).toEqual([{ id: 't-new', name: 'trophy_00 · UB' }]);
+    expect(plan.retired).toEqual(['g00']);
+    // the selected copy was removed: the kept one is selected, and wears the selected one's sleeve
+    expect(plan.selectedId).toBe('t-new');
+    expect(plan.sleeves).toEqual({ 't-new': '#5a2320' });
+    expect(plan.message).toBe('Updated 1 saved deck to the current starter name; removed 2 duplicate copies');
+  });
+
+  test('the kept copy keeps its own sleeve, and an unrelated selection stays', () => {
+    const plan = planStarterSync(OWNER, STARTERS, STRENGTHS, 'edited', { 't-new': '#20302b', 't-old': '#5a2320', edited: '#3b1f2b' });
+    expect(plan.selectedId).toBe('edited');
+    expect(plan.sleeves).toEqual({ 't-new': '#20302b', edited: '#3b1f2b' });
+  });
+
+  test('is idempotent: its own result plans nothing', () => {
+    const plan = planStarterSync(OWNER, STARTERS, STRENGTHS, null, {});
+    const removed = new Set(plan.removals.map((removal) => removal.id));
+    const after = OWNER.filter((deck) => !removed.has(deck.id))
+      .map((deck) => ({ ...deck, name: plan.renames.find((rename) => rename.id === deck.id)?.name ?? deck.name }));
+    const again = planStarterSync(after, STARTERS, STRENGTHS, plan.selectedId, plan.sleeves);
+    expect(again).toMatchObject({ renames: [], removals: [], message: null, retired: ['g00'] });
+  });
+
+  test('decks the player named, made with a sideboard, or changed are left alone', () => {
+    const decks = [
+      copy('a', 'trophy_00 · UB', 't00', 10),
+      copy('b', 'trophy_00 · UB (copy)', 't00', 20, { playerNamed: true }),
+      copy('c', 'my UB', 't00', 30, { playerNamed: true }),
+      copy('d', 'DSK TROPHY_00', 't00', 5, { sideboardCount: 3 }),
+      copy('e', 'DSK GOOD_08 edited', 'zzz', 40),
+      copy('f', 'retired twin', 'g00', 1),
+      copy('g', 'retired twin', 'g00', 2),
+    ];
+    const plan = planStarterSync(decks, STARTERS, STRENGTHS, null, {});
+    expect(plan.renames).toEqual([]);
+    expect(plan.removals).toEqual([{ id: 'f', keptId: 'g' }]); // exact copies of a retired deck dedupe too
+    expect(plan.retired).toEqual(['g']);
+    expect(plan.message).toBe('Removed 1 duplicate copy');
+  });
+
+  test('changes nothing while the starters are not known', () => {
+    expect(planStarterSync(OWNER, [], STRENGTHS, null, {})).toMatchObject({ renames: [], removals: [], message: null });
+  });
+});
diff --git a/Mage.Web.Client/src/core/decks/starterCopies.ts b/Mage.Web.Client/src/core/decks/starterCopies.ts
new file mode 100644
index 0000000000..5af4972a0d
--- /dev/null
+++ b/Mage.Web.Client/src/core/decks/starterCopies.ts
@@ -0,0 +1,138 @@
+import type { DeckStrength, StrengthEntry } from './deckStrength';
+
+/**
+ * mtg-ai: saved copies of our rated DSK starters. Playmat saves a starter into the player's library the first time it
+ * is played, under the starter's name of the day ("DSK TROPHY_00 (7-2, UB)", "★ GOOD_00 · 58.6% · …"). A copy is known
+ * by its cards (deckSig), never by its name: the starters of today (starter-decks/index.json), else every rated deck,
+ * the ones no longer listed too (starter-decks/strengths.json).
+ */
+
+/** What a saved deck's cards are: a starter listed today, or a rated deck no longer listed ("retired"). */
+export type CopyOf<T extends StrengthEntry = StrengthEntry> =
+  | { kind: 'starter'; starter: T }
+  | { kind: 'retired'; entry: StrengthEntry; reason: 'colour' | null };
+
+/**
+ * The starter (or retired deck) a saved deck's cards are; null for anything else (a deck the player built or edited).
+ * Nothing is called retired while the starters are not known (index.json failed to load).
+ */
+export function copyOf<T extends StrengthEntry>(sig: string | undefined, starters: readonly T[], strengths: readonly StrengthEntry[]): CopyOf<T> | null {
+  if (!sig) return null;
+  const starter = starters.find((candidate) => candidate.sig === sig);
+  if (starter) return { kind: 'starter', starter };
+  if (!starters.some((candidate) => candidate.sig)) return null;
+  const entry = strengths.find((candidate) => candidate.sig === sig);
+  if (!entry) return null;
+  // dsk_starters.py lists a rated deck when it keeps the colour rule (two main colours, at most a light splash): a
+  // deck with other than two main colours that is not listed broke it; any other reason is not known here
+  const colourRule = entry.listed === false && (entry.strength?.colors ?? '').length !== 2;
+  return { kind: 'retired', entry, reason: colourRule ? 'colour' : null };
+}
+
+/** Where a roster deck sorts on Home: group 3 ★★, 2 ★, 1 no star or not rated, 0 retired; then its review rating. */
+export interface Standing {
+  group: number;
+  rating: number | null;
+  retired?: boolean;
+}
+
+export function standingOf(strength: DeckStrength | null | undefined, retired = false): Standing {
+  if (retired) return { group: 0, rating: strength?.rating ?? null, retired: true };
+  const tier = strength?.tier ?? 0;
+  return { group: tier >= 2 ? 3 : tier === 1 ? 2 : 1, rating: strength?.rating ?? null };
+}
+
+/** ★★, then ★, then the rest, then retired decks; within each by review rating (unknown last), then the given order. */
+export function sortByStanding<D>(decks: readonly D[], standing: (deck: D) => Standing): D[] {
+  return decks
+    .map((deck, index) => ({ deck, index, key: standing(deck) }))
+    .sort((a, b) => b.key.group - a.key.group || (b.key.rating ?? -1) - (a.key.rating ?? -1) || a.index - b.index)
+    .map(({ deck }) => deck);
+}
+
+/** A saved deck's tile label when its cards are one of our decks (`cards`: its size, "40 cards"); null for the player's own
+ * (it keeps its format label). */
+export function copyLabel(copy: CopyOf | null, cards: string): string | null {
+  if (!copy) return null;
+  // the reason, not the count: a tile has room for one of them
+  if (copy.kind === 'retired') return copy.reason === 'colour' ? 'Retired: breaks the colour rule' : 'Retired';
+  const tier = copy.starter.strength?.tier ?? 0;
+  return `Your copy · ${tier >= 2 ? '★★ starter' : tier === 1 ? '★ starter' : 'starter'} · ${cards}`;
+}
+
+/** A name that looks like one of our starters' (old or new), so a changed copy says it is not rated any more. */
+export function looksLikeStarterName(name: string): boolean {
+  return /^(★|dsk[ _-]|good_|trophy_|typical_)/i.test(name.trim());
+}
+
+/** A saved deck as the sync sees it (its storage summary). */
+export interface SavedCopy {
+  id: string;
+  name: string;
+  sig?: string;
+  sideboardCount?: number;
+  updatedAt: number;
+  /** the player named or made this deck (Rename, Duplicate, import, the deck builder): its name is theirs */
+  playerNamed?: boolean;
+}
+
+export interface StarterSyncPlan {
+  /** unmodified copies of today's starters to rename to the starter's name of today */
+  renames: { id: string; name: string }[];
+  /** exact duplicate copies to delete, each with the copy that stays */
+  removals: { id: string; keptId: string }[];
+  /** copies of retired decks (they keep their name) */
+  retired: string[];
+  /** the selected deck afterwards */
+  selectedId: string | null;
+  /** the sleeves afterwards (deleted decks' entries dropped; a kept copy without a sleeve takes a deleted one's) */
+  sleeves: Record<string, string>;
+  /** a one-line note for the player when anything changed, else null */
+  message: string | null;
+}
+
+/**
+ * The sync of saved starter copies with today's starters (pure; useDecks.refresh applies it). Only unmodified copies
+ * take part: the cards of one of our decks (deckSig), no sideboard (our starters have none) and a name the player did
+ * not give it. Exact duplicates beyond the most recently saved one are deleted; a copy of a listed starter takes that
+ * starter's name of today; a copy of a retired deck keeps its name. A deck the player changed is never touched.
+ * Running it again on its own result changes nothing.
+ */
+export function planStarterSync<T extends StrengthEntry>(
+  saved: readonly SavedCopy[],
+  starters: readonly T[],
+  strengths: readonly StrengthEntry[],
+  selectedId: string | null,
+  sleeves: Record<string, string>,
+): StarterSyncPlan {
+  const groups = new Map<string, { copy: CopyOf<T>; decks: SavedCopy[] }>();
+  for (const deck of saved) {
+    if (deck.playerNamed || (deck.sideboardCount ?? 0) > 0) continue;
+    const copy = copyOf(deck.sig, starters, strengths);
+    if (!copy) continue;
+    const group = groups.get(deck.sig!) ?? { copy, decks: [] };
+    group.decks.push(deck);
+    groups.set(deck.sig!, group);
+  }
+  const plan: StarterSyncPlan = { renames: [], removals: [], retired: [], selectedId, sleeves: { ...sleeves }, message: null };
+  for (const { copy, decks } of groups.values()) {
+    const [kept, ...extra] = [...decks].sort((a, b) => b.updatedAt - a.updatedAt);
+    for (const deck of extra) plan.removals.push({ id: deck.id, keptId: kept.id });
+    if (extra.some((deck) => deck.id === selectedId)) plan.selectedId = kept.id;
+    if (!plan.sleeves[kept.id]) {
+      // the selected one's sleeve first, else the most recent one's
+      const donor = [...extra].sort((a, b) => Number(b.id === selectedId) - Number(a.id === selectedId)).find((deck) => sleeves[deck.id]);
+      if (donor) plan.sleeves[kept.id] = sleeves[donor.id];
+    }
+    for (const deck of extra) delete plan.sleeves[deck.id];
+    if (copy.kind === 'starter' && kept.name !== copy.starter.name) plan.renames.push({ id: kept.id, name: copy.starter.name });
+    if (copy.kind === 'retired') plan.retired.push(kept.id);
+  }
+  const parts: string[] = [];
+  const n = plan.renames.length;
+  const m = plan.removals.length;
+  if (n) parts.push(`Updated ${n} saved deck${n === 1 ? '' : 's'} to the current starter name${n === 1 ? '' : 's'}`);
+  if (m) parts.push(`${n ? 'removed' : 'Removed'} ${m} duplicate cop${m === 1 ? 'y' : 'ies'}`);
+  plan.message = parts.length ? parts.join('; ') : null;
+  return plan;
+}
