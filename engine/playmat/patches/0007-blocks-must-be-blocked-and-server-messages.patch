@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import type { GameView } from '../../protocol/generated/views';
+import { blockWarning } from './blockRequirements';
+import type { DeclareBlockersPrompt } from './prompt';
+
+const fear = { id: 'a1', name: 'Fear of Being Hunted', rules: ['Haste', 'This creature must be blocked if able.'] };
+const bear = { id: 'a2', name: 'Bear', rules: [] };
+const wall = { id: 'b1', name: 'Wall', rules: [] };
+
+function view(blockers: Record<string, string>): GameView {
+  return {
+    myPlayerId: 'me',
+    players: [{ playerId: 'me', battlefield: { b1: wall } }],
+    combat: [
+      { attackers: { a1: fear }, blockers: Object.fromEntries(Object.entries(blockers).filter(([, a]) => a === 'a1').map(([b]) => [b, wall])) },
+      { attackers: { a2: bear }, blockers: Object.fromEntries(Object.entries(blockers).filter(([, a]) => a === 'a2').map(([b]) => [b, wall])) },
+    ],
+  } as unknown as GameView;
+}
+const prompt = { kind: 'declareBlockers', possibleBlockers: ['b1'] } as unknown as DeclareBlockersPrompt;
+
+describe('blockWarning', () => {
+  it('warns when a must-be-blocked attacker is left unblocked', () => {
+    expect(blockWarning(view({}), prompt)).toMatch(/Fear of Being Hunted must be blocked/);
+    expect(blockWarning(view({ b1: 'a2' }), { ...prompt, possibleBlockers: [] })).toMatch(/must be blocked/);
+  });
+  it('accepts blocks that meet the requirement', () => {
+    expect(blockWarning(view({ b1: 'a1' }), { ...prompt, possibleBlockers: [] })).toBeNull();
+  });
+  it('knows a flier needs flying or reach', () => {
+    const flier = { ...fear, rules: ['Flying', 'This creature must be blocked if able.'] };
+    const v = view({});
+    v.combat![0].attackers = { a1: flier };
+    expect(blockWarning(v, prompt)).toBeNull();
+  });
+});
diff --git a/Mage.Web.Client/src/core/game/blockRequirements.ts b/Mage.Web.Client/src/core/game/blockRequirements.ts
new file mode 100644
index 0000000000..f0f59f7c2b
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/blockRequirements.ts
@@ -0,0 +1,53 @@
+import type { CardView, GameView, PermanentView } from '../../protocol/generated/views';
+import { keywordMarks, mustBeBlocked } from './keywords';
+import type { DeclareBlockersPrompt } from './prompt';
+
+/**
+ * mtg-ai: attackers that must be blocked if able (Fear of Being Hunted, lures), and a check before blocks are sent.
+ * The server is the judge: it refuses a declaration that breaks a requirement and asks again. This check only says
+ * so before sending, from what the board shows (flying needs flying or reach; other evasion isn't known here), so a
+ * second press sends the blocks anyway.
+ */
+
+function myPermanent(view: GameView, id: string): PermanentView | undefined {
+  for (const player of view.players ?? []) {
+    const permanent = player.battlefield?.[id];
+    if (permanent) return permanent;
+  }
+  return undefined;
+}
+
+function canBlock(blocker: PermanentView | undefined, attacker: CardView): boolean {
+  if (!blocker) return false;
+  const attackerMarks = new Set(keywordMarks(attacker).map((mark) => mark.name));
+  const blockerMarks = new Set(keywordMarks(blocker).map((mark) => mark.name));
+  return !attackerMarks.has('Flying') || blockerMarks.has('Flying') || blockerMarks.has('Reach');
+}
+
+/**
+ * Why the blocks as they stand break a "must be blocked if able" requirement, or null: an attacker that must be
+ * blocked is unblocked while a creature that could block it blocks nothing or blocks an attacker without that need.
+ */
+export function blockWarning(view: GameView | null | undefined, prompt: DeclareBlockersPrompt): string | null {
+  if (!view) return null;
+  const blocking = new Map<string, string>(); // blocker -> the attacker it blocks
+  for (const group of view.combat ?? []) {
+    const first = Object.keys(group.attackers ?? {})[0];
+    for (const id of Object.keys(group.blockers ?? {})) if (first) blocking.set(id, first);
+  }
+  for (const group of view.combat ?? []) {
+    if (Object.keys(group.blockers ?? {}).length > 0) continue;
+    for (const attacker of Object.values(group.attackers ?? {})) {
+      if (!mustBeBlocked(attacker)) continue;
+      const free = [...new Set([...prompt.possibleBlockers, ...blocking.keys()])].filter((id) => {
+        const blocks = blocking.get(id);
+        const other = blocks ? (view.combat ?? []).find((g) => g.attackers?.[blocks])?.attackers?.[blocks] : undefined;
+        return (!other || !mustBeBlocked(other)) && canBlock(myPermanent(view, id), attacker);
+      });
+      if (free.length > 0) {
+        return `${attacker.name ?? 'An attacker'} must be blocked if able. Block it, or press again to send these blocks anyway.`;
+      }
+    }
+  }
+  return null;
+}
