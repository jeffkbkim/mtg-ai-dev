+// mtg-ai: the Claude AI's model and effort. The seat's skill carries them to the server (ClaudeSeat): model index * 3 +
+// effort index + 1, so 1-3 is Opus low/medium/high and 4-6 Sonnet
+export const CLAUDE_MODELS: { value: ClaudeModel; label: MessageKey }[] = [
+  { value: 'claude-opus-5-5', label: 'ai.claude.opus' },
+  { value: 'claude-sonnet-5-5', label: 'ai.claude.sonnet' },
+];
+export const CLAUDE_EFFORTS: { value: ClaudeEffort; label: MessageKey }[] = [
+  { value: 'low', label: 'ai.claude.low' },
+  { value: 'medium', label: 'ai.claude.medium' },
+  { value: 'high', label: 'ai.claude.high' },
+];
+
+export function claudeSkill(model: ClaudeModel, effort: ClaudeEffort) {
+  return Math.max(0, CLAUDE_MODELS.findIndex((m) => m.value === model)) * 3 + Math.max(0, CLAUDE_EFFORTS.findIndex((e) => e.value === effort)) + 1;
+}
+
 export function difficultyOf(skill: number) {
