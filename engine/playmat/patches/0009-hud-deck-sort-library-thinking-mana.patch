+    const timer = setInterval(() => setNow(Date.now()), 1000);
+    return () => {
+      clearTimeout(start);
+      clearInterval(timer);
+    };
+  }, [active]);
+  return active && since !== null ? Math.max(0, Math.floor((now - since) / 1000)) : 0;
+}
