+ */
+export function sortByStrength(roster: RosterDeck[], starters: StarterDeck[]): RosterDeck[] {
+  const key = (deck: RosterDeck) => {
+    const strength = rosterStrength(deck, starters);
+    return [strength && strength.tier > 0 ? strength.tier : 0, strength?.rating ?? -1] as const;
+  };
+  return roster
+    .map((deck, index) => ({ deck, index, key: key(deck) }))
+    .sort((a, b) => b.key[0] - a.key[0] || b.key[1] - a.key[1] || a.index - b.index)
+    .map(({ deck }) => deck);
+}
