+/** Cards in the player's hand with a non-mana ability to activate (cycling, landcycling, channel). */
+export function handAbilities(view: GameView | null | undefined): string[] {
+  const hand = view?.myHand ?? {};
+  return Object.entries(view?.canPlayObjects?.objects ?? {})
+    .filter(([id, stats]) => id in hand && (stats.other ?? []).some((record) => !isManaText(record.value)))
+    .map(([id]) => id);
+}
