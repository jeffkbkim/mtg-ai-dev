@@ -0,0 +1,18 @@
+// mtg-ai: the "Good only" switch over the deck lists (stores/decks.ts, pickableRoster)
+import { useT } from '../i18n';
+import { hasGoodStarters, useDecks, useGoodStartersOnly } from '../stores/decks';
+import styles from './DeckBuilder.module.css';
+
+/** Shown only while the server ships good DSK starters. */
+export function GoodStartersToggle() {
+  const t = useT();
+  const shown = useDecks((state) => hasGoodStarters(state.starters));
+  const { on, set } = useGoodStartersOnly();
+  if (!shown) return null;
+  return (
+    <label className={styles.toggle} title={t('decks.goodOnly.detail')}>
+      <input type="checkbox" checked={on} onChange={(event) => set(event.target.checked)} />
+      {t('decks.goodOnly')}
+    </label>
+  );
+}
diff --git a/Mage.Web.Client/src/app/decks/ManaColumns.module.css b/Mage.Web.Client/src/app/decks/ManaColumns.module.css
