@@ -0,0 +1,90 @@
+/* mtg-ai: the deck in columns by mana value; each card shows its name strip, the last one in full */
+.columns {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
+  gap: 12px;
+  align-items: start;
+}
+
+.column {
+  min-width: 0;
+}
+
+.head {
+  display: flex;
+  justify-content: space-between;
+  margin-bottom: 6px;
+  padding-bottom: 4px;
+  border-bottom: 1px solid var(--ink-ghost);
+  font-family: var(--font-print);
+  font-size: var(--text-sm);
+  font-weight: 700;
+  letter-spacing: var(--tracking-print-wide);
+  text-transform: uppercase;
+  color: var(--ink-dim);
+}
+
+.head span {
+  color: var(--ink-strong);
+}
+
+.stack {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+/* a card's height is 88/63 of its width; percentages of margin follow the column's width */
+.card + .card {
+  margin-top: calc(19% - 139.7%);
+}
+
+.tile {
+  position: relative;
+  display: block;
+  width: 100%;
+  padding: 0;
+  border: 0;
+  border-radius: var(--card-radius);
+  background: transparent;
+  cursor: pointer;
+  transition: transform var(--dur-quick) var(--ease-lift);
+}
+
+.still {
+  cursor: default;
+}
+
+button.tile:hover {
+  transform: translateY(-4px);
+}
+
+.tile:focus-visible {
+  outline: 2px solid var(--ink-strong);
+  outline-offset: 2px;
+}
+
+.amount {
+  position: absolute;
+  top: 4px;
+  right: 4px;
+  padding: 1px 6px;
+  border-radius: 999px;
+  background: rgb(var(--mat-rgb) / 0.92);
+  box-shadow: inset 0 0 0 1px var(--ink-faint);
+  font-family: var(--font-print);
+  font-size: 13px;
+  color: var(--ink-strong);
+}
+
+.dialogBody {
+  position: relative;
+  max-height: 70vh;
+  overflow-y: auto;
+}
+
+.dialogPreview {
+  position: fixed;
+  z-index: calc(var(--z-dialog) + 2);
+  pointer-events: none;
+}
diff --git a/Mage.Web.Client/src/app/decks/ManaColumns.tsx b/Mage.Web.Client/src/app/decks/ManaColumns.tsx
new file mode 100644
index 0000000000..ebc42b8265
--- /dev/null
+++ b/Mage.Web.Client/src/app/decks/ManaColumns.tsx
@@ -0,0 +1,119 @@
+// mtg-ai: a deck laid out in columns by mana value, like MTG Arena's deck view
+import { useEffect, useMemo, useState } from 'react';
+import { createPortal } from 'react-dom';
+import type { CardView } from '../../protocol/generated/views';
+import type { DeckCardLists } from '../../core/decks/types';
+import { useT } from '../i18n';
+import { useDecks } from '../stores/decks';
+import { Dialog } from '../ui/Dialog';
+import { CardFace } from '../ui/CardFace';
+import { useCardInfo } from './cardInfo';
+import { countZone, manaColumns, type DeckRow } from './deckModel';
+import styles from './ManaColumns.module.css';
+
+/** The cards stacked in columns (0-1, 2, 3, 4, 5, 6+, lands); click adds a copy and right-click removes one when editing. */
+export function ManaColumns({ entries, info, onAdd, onRemove, onPreview }: {
+  entries: DeckCardLists['cards'];
+  info: ReadonlyMap<string, CardView>;
+  onAdd?(row: DeckRow): void;
+  onRemove?(row: DeckRow): void;
+  onPreview(card: CardView | null, anchor?: DOMRect): void;
+}) {
+  const columns = useMemo(() => manaColumns(entries, info), [entries, info]);
+  return (
+    <div className={styles.columns} aria-label="Deck by mana value">
+      {columns.map((column) => (
+        <section key={column.key} className={styles.column} aria-label={`${column.label}: ${column.count}`}>
+          <h3 className={styles.head}>{column.label}<span>{column.count}</span></h3>
+          <ul className={styles.stack}>
+            {column.rows.map((row) => (
+              <li key={row.key} className={styles.card}>
+                {onAdd || onRemove ? (
+                  <button
+                    type="button"
+                    className={styles.tile}
+                    onClick={() => onAdd?.(row)}
+                    onContextMenu={(event) => {
+                      if (!onRemove) return;
+                      event.preventDefault();
+                      onRemove(row);
+                    }}
+                    onPointerEnter={(event) => row.card && onPreview(row.card, event.currentTarget.getBoundingClientRect())}
+                    onPointerLeave={() => onPreview(null)}
+                    aria-label={`${row.entry.amount} ${row.entry.cardName}`}
+                  >
+                    <Tile row={row} />
+                  </button>
+                ) : (
+                  <div
+                    className={[styles.tile, styles.still].join(' ')}
+                    onPointerEnter={(event) => row.card && onPreview(row.card, event.currentTarget.getBoundingClientRect())}
+                    onPointerLeave={() => onPreview(null)}
+                    aria-label={`${row.entry.amount} ${row.entry.cardName}`}
+                  >
+                    <Tile row={row} />
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        </section>
+      ))}
+    </div>
+  );
+}
+
+function Tile({ row }: { row: DeckRow }) {
+  return (
+    <>
+      <CardFace card={row.card ?? { name: row.entry.cardName }} size="small" />
+      {row.entry.amount > 1 && <b className={styles.amount} aria-hidden="true">×{row.entry.amount}</b>}
+    </>
+  );
+}
+
+/** A deck's main deck by mana value without opening the builder (a starter stays a starter: nothing is copied). */
+export function DeckCardsDialog({ deckId, name, onClose }: { deckId: string | null; name: string; onClose(): void }) {
+  const t = useT();
+  const [loaded, setLoaded] = useState<{ id: string; deck: DeckCardLists } | null>(null);
+  const deck = loaded && loaded.id === deckId ? loaded.deck : null;
+  const [preview, setPreview] = useState<{ card: CardView; anchor: DOMRect } | null>(null);
+  useEffect(() => {
+    if (!deckId) return;
+    let cancelled = false;
+    void useDecks.getState().loadList(deckId).then((list) => !cancelled && setLoaded({ id: deckId, deck: list })).catch(() => undefined);
+    return () => {
+      cancelled = true;
+    };
+  }, [deckId]);
+  const entries = useMemo(() => deck?.cards ?? [], [deck]);
+  const info = useCardInfo(entries);
+  return (
+    <Dialog
+      open={!!deckId}
+      onOpenChange={(open) => !open && onClose()}
+      title={name}
+      width="lg"
+      description={deck ? t('decks.cards.count', { count: countZone(deck, 'cards') }) : t('decks.cards.loading')}
+    >
+      <div className={styles.dialogBody}>
+        <ManaColumns entries={entries} info={info} onPreview={(card, anchor) => setPreview(card && anchor ? { card, anchor } : null)} />
+        {preview && createPortal(<ColumnPreview {...preview} />, document.body)}
+      </div>
+    </Dialog>
+  );
+}
+
+/** The pointed card in full, beside its column (over the dialog, so it lives on the page body). */
+function ColumnPreview({ card, anchor }: { card: CardView; anchor: DOMRect }) {
+  const width = 260;
+  const height = width * (88 / 63);
+  const gap = 12;
+  const left = anchor.right + gap + width <= window.innerWidth ? anchor.right + gap : Math.max(gap, anchor.left - gap - width);
+  const top = Math.max(12, Math.min(window.innerHeight - height - 12, anchor.top));
+  return (
+    <div className={styles.dialogPreview} style={{ left, top, width }} aria-hidden="true">
+      <CardFace card={card} size="large" />
+    </div>
+  );
+}
