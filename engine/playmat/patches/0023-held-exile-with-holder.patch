new file mode 100644
index 0000000000..f03d112810
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/heldCards.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import type { GameView } from '../../protocol/generated/views';
+import { heldCards } from './heldCards';
+
+describe('heldCards', () => {
+  it('groups exiled cards under the permanent holding them, for either player', () => {
+    const view = {
+      exiles: [{ a: { id: 'a', name: 'Bear' } }, { b: { id: 'b', name: 'Wolf' } }],
+      players: [{ playerId: 'p', exile: { c: { id: 'c', name: 'Shock' } } }],
+      heldBy: { a: 'trap1', b: 'trap2', c: 'trap1', gone: 'trap2' },
+    } as unknown as GameView;
+    const held = heldCards(view);
+    expect(held.get('trap1')?.map((card) => card.name)).toEqual(['Bear', 'Shock']);
+    expect(held.get('trap2')?.map((card) => card.name)).toEqual(['Wolf']);
+  });
+
+  it('is empty for a server that does not send heldBy', () => {
+    expect(heldCards({ exiles: [{ a: { id: 'a' } }] } as unknown as GameView).size).toBe(0);
+  });
+});
diff --git a/Mage.Web.Client/src/core/game/heldCards.ts b/Mage.Web.Client/src/core/game/heldCards.ts
new file mode 100644
index 0000000000..8fa63b0e44
--- /dev/null
+++ b/Mage.Web.Client/src/core/game/heldCards.ts
@@ -0,0 +1,19 @@
+import type { CardView, GameView } from '../../protocol/generated/views';
+
+/**
+ * mtg-ai: exiled cards held by a permanent ("exile ... until it leaves": Trapped in the Screen, Fear of Abduction,
+ * Unidentified Hovership), by the holding permanent's id, from the game view's heldBy (exiled card id -> holder).
+ */
+export function heldCards(view: GameView | null | undefined): Map<string, CardView[]> {
+  const out = new Map<string, CardView[]>();
+  if (!view?.heldBy) return out;
+  const exiled = new Map<string, CardView>();
+  for (const zone of view.exiles ?? []) for (const [id, card] of Object.entries(zone ?? {})) exiled.set(id, card);
+  for (const player of view.players ?? []) for (const [id, card] of Object.entries(player.exile ?? {})) exiled.set(id, card);
+  for (const [cardId, holder] of Object.entries(view.heldBy)) {
+    const card = exiled.get(cardId);
+    if (!card) continue;
+    out.set(holder, [...(out.get(holder) ?? []), card]);
+  }
+  return out;
+}
